{
    "name": "complianz/site-maquette",
    "description": "Maquette du site Complianz",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "twig/twig": "^3.0",
        "phpoffice/phpspreadsheet": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/router.php",
        "test": "phpunit"
    },
    "config": {
        "process-timeout": 0,
        "optimize-autoloader": true,
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    }
}
