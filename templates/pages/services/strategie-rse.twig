{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 146 chars description) ─────────────────── #}
{% block title %}Stratégie RSE | Accompagnement démarche responsable | Complianz{% endblock %}

{% block description %}Définissez et déployez une stratégie RSE cohérente avec vos valeurs. Diagnostic, plan d'actions, parties prenantes et reporting extra-financier.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Stratégie RSE — Démarche responsable sur mesure",
      "url": "{{ app_url }}/audit-conformite/rse/strategie-rse",
      "description": "Accompagnement dans la définition et le déploiement d'une stratégie RSE cohérente : diagnostic RSE initial (matrice de matérialité), définition des axes prioritaires, plan d'actions sur 3 ans, KPI RSE, rapport RSE et communication extra-financière.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Stratégie RSE et démarche responsable",
      "offers": [
        { "@type": "Offer", "name": "Stratégie RSE Starter",          "price": "3500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500"  } },
        { "@type": "Offer", "name": "Stratégie RSE Complète",         "price": "6500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "14000" } },
        { "@type": "Offer", "name": "Accompagnement RSE annuel",      "price": "2400", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4800"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Accompagnement RSE",          "item": "{{ app_url }}/audit-conformite/rse" },
        { "@type": "ListItem", "position": 4, "name": "Stratégie RSE",               "item": "{{ app_url }}/audit-conformite/rse/strategie-rse" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une stratégie RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une stratégie RSE (Responsabilité Sociétale des Entreprises) est une feuille de route qui définit les engagements prioritaires de l'entreprise sur les 3 piliers ESG (Environnemental, Social, Gouvernance), les actions concrètes à déployer, les indicateurs de mesure et les objectifs chiffrés. Elle transforme des intentions en actions mesurables et communicables." }
        },
        {
          "@type": "Question",
          "name": "La RSE est-elle obligatoire pour mon entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La RSE n'est pas légalement obligatoire pour toutes les entreprises, mais elle devient incontournable. La directive CSRD impose un reporting de durabilité aux grandes entreprises depuis 2024. Les donneurs d'ordre et grands comptes intègrent de plus en plus des critères RSE dans leurs appels d'offres. Et les consommateurs, candidats et investisseurs sont de plus en plus sensibles à l'engagement responsable des entreprises." }
        },
        {
          "@type": "Question",
          "name": "Quel est le ROI d'une stratégie RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le ROI d'une stratégie RSE est multiple : réduction des coûts énergétiques (économies sur les consommations), meilleure attractivité (recrutement de profils qualifiés), fidélisation des clients sensibles à l'engagement responsable, accès à de nouveaux marchés (appels d'offres RSE), réduction du risque réglementaire et prime à la valorisation pour les investisseurs ESG." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour déployer une stratégie RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un diagnostic RSE + stratégie prend 6 à 10 semaines. Le déploiement complet d'une stratégie RSE avec plan d'actions et indicateurs prend 6 à 12 mois. L'accompagnement annuel est ensuite recommandé pour maintenir la dynamique, ajuster les objectifs et préparer le reporting. Nous adaptons le rythme à votre organisation et vos ressources." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

