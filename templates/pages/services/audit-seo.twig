{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Audit SEO | Analyse complète référencement naturel | Complianz{% endblock %}

{% block description %}Réalisez un audit SEO complet pour identifier les blocages de votre site. Technique, contenu, autorité. Rapport et plan d'actions priorisé. Dès 890€.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit SEO",
      "url": "{{ app_url }}/performance-digitale/seo/audit-seo",
      "description": "Analyse complète de votre site web pour identifier tous les freins au référencement naturel : technique, contenu, backlinks et opportunités de croissance. Rapport détaillé et plan d'actions priorisé.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit SEO",
      "offers": [
        { "@type": "Offer", "name": "Audit SEO Starter",  "price": "890",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Audit SEO Standard", "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500" } },
        { "@type": "Offer", "name": "Audit SEO Avancé",   "price": "3500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Référencement naturel (SEO)",       "item": "{{ app_url }}/performance-digitale/seo" },
        { "@type": "ListItem", "position": 4, "name": "Audit SEO",                         "item": "{{ app_url }}/performance-digitale/seo/audit-seo" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit SEO est une analyse complète de votre site web permettant d'identifier tous les problèmes qui freinent votre référencement naturel : erreurs techniques (vitesse, structure, indexation), problèmes de contenu (pages peu optimisées, manque de mots-clés ciblés), et manques de notoriété (backlinks insuffisants). Il constitue la première étape indispensable de toute stratégie SEO efficace." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps prend un audit SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit SEO Starter prend 1 à 2 semaines. Un audit Standard 2 à 3 semaines. Un audit Avancé sur un grand site peut nécessiter 3 à 5 semaines. Le délai dépend de la taille du site, du nombre de pages à analyser et de la complexité technique. Nous vous communiquons un calendrier précis dès le démarrage." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un audit SEO et un audit technique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit technique se concentre uniquement sur les aspects techniques du site (vitesse, crawl, indexation, structure URL, données structurées). Un audit SEO complet englobe l'audit technique ET l'analyse des contenus, des mots-clés, du profil de backlinks et de la concurrence. L'audit SEO offre donc une vision 360° de votre référencement." }
        },
        {
          "@type": "Question",
          "name": "Que faire après un audit SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Après l'audit, vous recevez un rapport détaillé et un plan d'actions priorisé. Vous pouvez alors soit mettre en œuvre les recommandations en interne, soit nous confier l'implémentation dans le cadre d'une mission SEO. Nous proposons également un suivi mensuel pour mesurer les progrès et ajuster la stratégie en continu." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

