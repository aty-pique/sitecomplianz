{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Certification ISO 9001 | Accompagnement SMQ &amp; audit | Complianz{% endblock %}

{% block description %}Obtenez la certification ISO 9001 avec un accompagnement expert de A à Z. Diagnostic, mise en place du SMQ, audit blanc et préparation à l'audit de certification.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Certification ISO 9001 — Système de Management de la Qualité",
      "url": "{{ app_url }}/audit-conformite/certifications-iso/iso-9001",
      "description": "Accompagnement complet à la certification ISO 9001 : diagnostic de l'existant (gap analysis), rédaction du Manuel Qualité, mise en place des procédures, formation du personnel, audit interne blanc et accompagnement à l'audit de certification par l'organisme certificateur.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Certification ISO 9001",
      "offers": [
        { "@type": "Offer", "name": "Pack ISO 9001 PME",              "price": "4900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8900"  } },
        { "@type": "Offer", "name": "Pack ISO 9001 ETI",              "price": "9900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "18000" } },
        { "@type": "Offer", "name": "Maintenance post-certification", "price": "1800",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3600"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Certifications ISO",          "item": "{{ app_url }}/audit-conformite/certifications-iso" },
        { "@type": "ListItem", "position": 4, "name": "Certification ISO 9001",      "item": "{{ app_url }}/audit-conformite/certifications-iso/iso-9001" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de temps pour obtenir la certification ISO 9001 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'obtention de la certification ISO 9001 prend généralement entre 6 et 18 mois selon la taille de l'entreprise, le nombre de processus à structurer et la maturité initiale du système qualité. Une PME avec une organisation déjà structurée peut viser 6 à 9 mois, tandis qu'une ETI partant de zéro nécessitera 12 à 18 mois." }
        },
        {
          "@type": "Question",
          "name": "Quel est le coût total d'une certification ISO 9001 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le coût total comprend nos honoraires d'accompagnement (4 900 à 18 000€ HT selon la taille) et les frais d'audit de certification facturés par l'organisme certificateur (généralement 2 000 à 8 000€ HT selon la taille). Le coût global varie donc de 7 000€ pour une TPE à 26 000€+ pour une ETI." }
        },
        {
          "@type": "Question",
          "name": "ISO 9001 est-elle obligatoire ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La certification ISO 9001 n'est pas légalement obligatoire pour la plupart des entreprises. Cependant, elle peut être imposée contractuellement par vos clients (grands comptes, secteur public, industrie automobile, aéronautique…) ou recommandée pour accéder à certains marchés. Elle constitue un avantage concurrentiel significatif." }
        },
        {
          "@type": "Question",
          "name": "Comment maintenir la certification ISO 9001 après l'obtention ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La certification ISO 9001 est valable 3 ans avec des audits de surveillance annuels et un audit de renouvellement au bout de 3 ans. Pour la maintenir : tenue des audits internes, gestion des non-conformités, revues de direction régulières et mise à jour de la documentation. Notre service de maintenance annuelle vous accompagne sur l'ensemble de ces exigences." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

