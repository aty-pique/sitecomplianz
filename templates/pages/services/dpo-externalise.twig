{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 148 chars description) ─────────────────── #}
{% block title %}DPO externalisé | Délégué à la protection des données PME | Complianz{% endblock %}

{% block description %}Nommez un DPO externalisé conforme au RGPD. Complianz System assure votre rôle de Délégué à la Protection des Données en continu. Dès 290€/mois.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "DPO externalisé — Délégué à la Protection des Données",
      "url": "{{ app_url }}/audit-conformite/conformite-rgpd/dpo-externalise",
      "description": "Service de DPO externalisé conforme au RGPD : nomination officielle auprès de la CNIL, tenue du registre des traitements, réponse aux demandes d'exercice de droits, sensibilisation des équipes, veille réglementaire continue et point mensuel avec la direction. Dès 290€/mois.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "DPO externalisé RGPD",
      "offers": [
        { "@type": "Offer", "name": "DPO Essentiel",  "price": "290",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "490",  "unitCode": "MON" } },
        { "@type": "Offer", "name": "DPO Standard",   "price": "590",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "890",  "unitCode": "MON" } },
        { "@type": "Offer", "name": "DPO Premium",    "price": "990",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1490", "unitCode": "MON" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Conformité RGPD",             "item": "{{ app_url }}/audit-conformite/conformite-rgpd" },
        { "@type": "ListItem", "position": 4, "name": "DPO externalisé",             "item": "{{ app_url }}/audit-conformite/conformite-rgpd/dpo-externalise" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Le DPO externalisé est-il légal ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, le RGPD autorise explicitement la nomination d'un DPO externalisé (article 37.6). L'organisation doit conclure un contrat de services avec le prestataire DPO. Le DPO externalisé doit être joignable facilement et disposer des ressources nécessaires pour accomplir ses missions." }
        },
        {
          "@type": "Question",
          "name": "Qui doit nommer un DPO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La nomination d'un DPO est obligatoire pour : les autorités et organismes publics, les organisations dont les activités principales nécessitent un suivi régulier et systématique des personnes à grande échelle, et les organisations traitant à grande échelle des données sensibles (santé, infractions pénales…). Elle est fortement recommandée pour toute PME traitant des données clients." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un DPO interne et un DPO externalisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le DPO interne est un salarié de l'organisation dédié à la protection des données — il nécessite une formation spécifique et représente un coût important (50 000 à 80 000€/an). Le DPO externalisé est un expert indépendant mutualisé, disponible dès 290€/mois, qui apporte le même niveau d'expertise sans les contraintes RH d'un recrutement." }
        },
        {
          "@type": "Question",
          "name": "Comment se passe la collaboration avec un DPO externalisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La collaboration commence par un audit de conformité initial pour évaluer votre situation. Nous mettons ensuite en place un dispositif de collaboration : point mensuel avec la direction, disponibilité par email/téléphone pour les questions urgentes, reporting trimestriel et mise à jour annuelle de la documentation. Votre DPO externalisé est désigné nominativement auprès de la CNIL." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

