{% extends 'layouts/base.twig' %}

{# ── SEO (49 chars titre / 153 chars description) ─────────────────── #}
{% block title %}Mise en place SMQ &amp; démarche qualité{% endblock %}

{% block description %}Structurez vos processus avec un SMQ sur-mesure : cartographie, procédures, KPI, alignement ISO 9001. Entreprise pilotable et performante. Devis gratuit sous 24h.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Mise en place SMQ — Système de Management Qualité",
      "url": "{{ app_url }}/audit-conformite/certifications-iso/smq",
      "description": "Conception et mise en place d'un système de management de la qualité (SMQ) adapté à l'entreprise : cartographie des processus, formalisation des procédures, indicateurs KPI, alignement ISO 9001, accompagnement des équipes et préparation à la certification.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Système de Management de la Qualité",
      "offers": [
        { "@type": "Offer", "name": "SMQ simple (petite structure)", "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "SMQ structuré (PME)",            "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } },
        { "@type": "Offer", "name": "SMQ complet + certification",    "price": "25000", "priceCurrency": "EUR" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                        "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",    "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Mise en conformité & ISO",       "item": "{{ app_url }}/audit-conformite/certifications-iso" },
        { "@type": "ListItem", "position": 4, "name": "Mise en place SMQ",              "item": "{{ app_url }}/audit-conformite/certifications-iso/smq" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un SMQ (Système de Management de la Qualité) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un SMQ est un ensemble structuré de processus, procédures et indicateurs permettant à une entreprise de piloter et améliorer en continu sa qualité. Il répond aux exigences de normes comme ISO 9001 et permet de transformer une organisation floue en entreprise pilotable et mesurable." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour mettre en place un SMQ ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La durée varie de 3 mois (structure simple, faible périmètre) à 12 mois et plus pour un SMQ complet avec préparation à la certification ISO. Cela dépend de la taille de l'entreprise, du nombre de processus à structurer et du niveau de maturité initial." }
        },
        {
          "@type": "Question",
          "name": "Un SMQ est-il obligatoire pour obtenir la certification ISO 9001 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, la certification ISO 9001 exige la mise en place et la documentation d'un Système de Management de la Qualité. Nos consultants vous accompagnent à la fois dans la structuration du SMQ et dans la préparation à l'audit de certification." }
        },
        {
          "@type": "Question",
          "name": "Quelles entreprises ont besoin d'un SMQ ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Toute entreprise souhaitant structurer ses processus, réduire ses erreurs opérationnelles, améliorer sa communication interne, préparer une certification ISO, ou simplement passer à un mode de gestion plus professionnel et mesurable peut bénéficier d'un SMQ." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un SMQ et un audit qualité interne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SMQ est le système à mettre en place (processus, documents, indicateurs). L'audit qualité interne est une évaluation périodique du bon fonctionnement de ce SMQ. L'un construit, l'autre vérifie. Les deux sont complémentaires dans une démarche qualité durable." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

