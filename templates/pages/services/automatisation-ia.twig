{% extends 'layouts/base.twig' %}

{# ── SEO ──────────────────────────────────────────────────────────── #}
{% block title %}Automatisation IA | Automatiser processus métier avec l'IA | Complianz{% endblock %}

{% block description %}Automatisez vos processus répétitifs grâce à l'IA : workflows, n8n, agents autonomes. Gain de temps jusqu'à 70%. Accompagnement et déploiement sur mesure.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Automatisation IA des processus métiers",
      "url": "{{ app_url }}/intelligence-artificielle/automatisation-ia",
      "description": "Automatisation des processus métiers grâce à l'intelligence artificielle : workflows intelligents avec n8n, agents autonomes, intégration CRM/ERP. Gain de temps jusqu'à 70% sur les tâches répétitives.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Automatisation IA et workflows intelligents",
      "offers": [
        { "@type": "Offer", "name": "Audit automatisation", "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900" } },
        { "@type": "Offer", "name": "Pack automatisation PME", "price": "4900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900" } },
        { "@type": "Offer", "name": "Programme automatisation avancée", "price": "9900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle", "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Automatisation IA", "item": "{{ app_url }}/intelligence-artificielle/automatisation-ia" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quels processus peut-on automatiser avec l'IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pratiquement tous les processus répétitifs et basés sur des règles peuvent être automatisés : facturation et relances, onboarding clients et collaborateurs, qualification et suivi de leads, traitement de commandes, gestion des congés, reporting périodique, tri et réponse aux emails, extraction de données de documents, synchronisation entre outils (CRM, ERP, comptabilité). L'IA va plus loin que les RPA classiques en comprenant le contenu non structuré (emails, PDFs, images)." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps économise-t-on grâce à l'automatisation IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "En moyenne, nos clients économisent entre 40% et 70% du temps consacré aux processus automatisés. Concrètement : un processus de facturation traité manuellement en 2h peut être automatisé en quelques minutes, un onboarding client qui prend 4h peut se réduire à 30 minutes de supervision. Le ROI est généralement atteint en 3 à 6 mois selon la complexité des processus automatisés." }
        },
        {
          "@type": "Question",
          "name": "Faut-il des compétences techniques pour utiliser l'automatisation IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Non, l'objectif est précisément que vos équipes puissent utiliser les automatisations sans compétences techniques. Nous concevons des interfaces simples, documentons chaque workflow et formons vos équipes à la supervision et aux ajustements basiques. Pour les besoins d'évolution, nous proposons des formations à l'automatisation no-code (n8n, Make) pour que votre équipe gagne en autonomie progressivement." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre l'automatisation IA et un RPA classique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un RPA (Robotic Process Automation) classique automatise des processus rigides basés sur des clics et des règles fixes — il ne fonctionne que si l'interface ne change pas. L'automatisation IA est beaucoup plus flexible : elle comprend le langage naturel (emails, documents), s'adapte aux variations de contenu, prend des décisions contextuelles et peut traiter des données non structurées. L'IA permet aussi d'automatiser des processus qui nécessitaient auparavant un jugement humain." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

