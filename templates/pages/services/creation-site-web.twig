{% extends 'layouts/base.twig' %}

{# ── SEO (49 chars titre / 147 chars description) ─────────────────── #}
{% block title %}Création de sites web professionnels{% endblock %}

{% block description %}Créez un site internet professionnel aligné avec votre image : vitrine, e-commerce, refonte, WordPress. Design, SEO et performance. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création de sites web professionnels",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web",
      "description": "Conception et développement de sites internet professionnels (vitrine ou sur mesure) structurés, cohérents avec l'image de l'entreprise et orientés performance : visibilité, conversion et crédibilité.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création de sites web",
      "offers": [
        { "@type": "Offer", "name": "Site vitrine simple",        "price": "2000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000"  } },
        { "@type": "Offer", "name": "Site professionnel structuré","price": "5000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } },
        { "@type": "Offer", "name": "Site avancé sur mesure",     "price": "12000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "30000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien coûte la création d'un site internet professionnel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 2 000 € à 5 000 € pour un site vitrine simple, de 5 000 € à 12 000 € pour un site professionnel structuré (plusieurs pages, fonctionnalités, SEO), et de 12 000 € à 30 000 €+ pour un site avancé ou sur mesure. Un abonnement maintenance et hébergement est possible après livraison." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour créer un site internet ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 3 à 6 semaines pour un site vitrine simple, de 6 à 12 semaines pour un site professionnel structuré, et de 3 à 6 mois pour un site avancé ou sur mesure avec des fonctionnalités spécifiques. Le délai dépend principalement de la disponibilité des contenus et de la complexité du design." }
        },
        {
          "@type": "Question",
          "name": "Quelle technologie utilisez-vous : WordPress, Webflow ou développement sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix dépend de vos besoins. WordPress est idéal pour les sites avec beaucoup de contenu et une autonomie de gestion souhaitée. Webflow convient aux sites orientés design avec une bonne performance. Le développement sur mesure est recommandé pour des fonctionnalités très spécifiques ou une intégration poussée avec vos systèmes. Nous vous conseillons la technologie la plus adaptée lors du cadrage." }
        },
        {
          "@type": "Question",
          "name": "Le site sera-t-il optimisé pour le référencement naturel (SEO) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'optimisation SEO de base est incluse dans tous nos projets : structure des pages (Hn), balises meta, vitesse de chargement, responsive mobile, sitemap et robots.txt. Pour une stratégie SEO complète (rédaction de contenus, netlinking, suivi de positionnement), notre équipe Performance Digitale propose un accompagnement dédié." }
        },
        {
          "@type": "Question",
          "name": "Pourrez-vous gérer le site vous-mêmes après la livraison ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — nous formons vos équipes à la gestion du site et livrons la documentation complète. Si vous optez pour WordPress ou un CMS, vous pourrez ajouter des pages, modifier les contenus et publier des articles sans connaissances techniques. Un contrat de maintenance est également disponible si vous souhaitez déléguer les mises à jour." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

