{% extends 'layouts/base.twig' %}

{# ── SEO (53 chars titre / 155 chars description) ─────────────────── #}
{% block title %}Accompagnement RSE &amp; démarche responsable{% endblock %}

{% block description %}Mettez en place une démarche RSE structurée et mesurable : diagnostic, stratégie, engagements, reporting ESG, CSRD. Accompagnement sur-mesure. Devis gratuit sous 48h.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Accompagnement démarche RSE",
      "url": "{{ app_url }}/audit-conformite/rse",
      "description": "Accompagnement dans la mise en place d'une démarche RSE structurée, alignée avec l'activité, les valeurs et les objectifs de l'entreprise. Diagnostic RSE, stratégie, plan d'actions, indicateurs, reporting ESG/CSRD et communication responsable.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Responsabilité Sociétale des Entreprises (RSE)",
      "offers": [
        { "@type": "Offer", "name": "RSE simple (diagnostic + plan d'action)", "price": "2000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000" } },
        { "@type": "Offer", "name": "RSE structurée",                           "price": "5000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000" } },
        { "@type": "Offer", "name": "RSE intégrée (pilotage + déploiement)",    "price": "15000", "priceCurrency": "EUR" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Accompagnement RSE",          "item": "{{ app_url }}/audit-conformite/rse" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que la RSE (Responsabilité Sociétale des Entreprises) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La RSE (Responsabilité Sociétale des Entreprises) est l'intégration volontaire, par les entreprises, de préoccupations sociales, environnementales et économiques dans leurs activités et leurs relations avec leurs parties prenantes. Elle va au-delà des obligations légales pour aligner les pratiques de l'entreprise avec ses valeurs et les attentes de la société." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi mettre en place une démarche RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une démarche RSE structurée améliore l'image et la crédibilité de l'entreprise, renforce l'attractivité pour les talents et partenaires, répond aux exigences croissantes des clients et donneurs d'ordre, prépare aux obligations réglementaires (CSRD) et contribue à une performance globale plus durable." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que le reporting CSRD et quelles entreprises sont concernées ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La CSRD (Corporate Sustainability Reporting Directive) est une directive européenne qui impose aux entreprises de publier un rapport de durabilité standardisé. Elle s'applique progressivement : aux grandes entreprises cotées depuis 2024, aux grandes entreprises non cotées depuis 2025, puis aux PME cotées à partir de 2026. Nous vous accompagnons dans la mise en conformité CSRD." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour mettre en place une démarche RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un diagnostic RSE + plan d'action prend 4 à 8 semaines. Le déploiement d'une RSE structurée avec indicateurs et reporting dure en général 6 à 12 mois. Une RSE intégrée dans la stratégie globale est un processus continu avec un accompagnement mensuel dans la durée." }
        },
        {
          "@type": "Question",
          "name": "Peut-on faire de la RSE dans une petite entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolument — la RSE n'est pas réservée aux grands groupes. Pour les TPE et PME, une démarche RSE simple et sincère, adaptée à leur taille et leur secteur, est souvent plus impactante et plus valorisable qu'un rapport de 200 pages. Nous proposons des accompagnements calibrés à partir de 2 000 €." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

