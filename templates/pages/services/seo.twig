{% extends 'layouts/base.twig' %}

{# ── SEO (52 chars titre / 148 chars description) ─────────────────── #}
{% block title %}SEO & référencement naturel — visibilité durable{% endblock %}

{% block description %}Améliorez votre visibilité sur Google grâce au référencement naturel : audit SEO, optimisation technique, contenu et netlinking. Votre site génère du trafic qualifié.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Référencement naturel (SEO)",
      "url": "{{ app_url }}/performance-digitale/seo",
      "description": "Optimisation du site internet afin d'améliorer sa visibilité sur les moteurs de recherche, sa performance et sa capacité à générer du trafic qualifié. L'objectif est de structurer le site pour qu'il soit compréhensible par les moteurs de recherche et efficace pour convertir les visiteurs.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Référencement naturel SEO",
      "offers": [
        { "@type": "Offer", "name": "Stratégie SEO",                       "price": "1500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000"  } },
        { "@type": "Offer", "name": "Stratégie + Optimisation SEO base",   "price": "3000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } },
        { "@type": "Offer", "name": "Suivi SEO mensuel",                    "price": "500",   "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4000"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Référencement naturel (SEO)",       "item": "{{ app_url }}/performance-digitale/seo" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi investir dans le référencement naturel (SEO) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEO génère un trafic qualifié de façon pérenne sans payer chaque clic. Contrairement à la publicité qui s'arrête quand le budget est épuisé, le référencement naturel construit une visibilité durable. Les résultats croissent avec le temps, et le coût par lead diminue au fur et à mesure que le site monte en position." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour voir des résultats en SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les premiers résultats visibles apparaissent généralement entre 3 et 6 mois. Le SEO est une stratégie de long terme : les résultats s'accumulent et se renforcent avec le temps. Pour des sites nouveaux ou peu optimisés, il faut souvent 6 à 12 mois pour atteindre un trafic significatif. Le SEO local et longue traîne peuvent générer des résultats plus rapides." }
        },
        {
          "@type": "Question",
          "name": "Quel est le coût d'une prestation SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 500 € à 5 000 € pour une stratégie SEO (audit + recommandations), de 3 000 € à 12 000 € pour une refonte SEO complète (stratégie + optimisation du site), et de 500 € à 4 000 €/mois pour un suivi SEO mensuel (suivi de positions, optimisation continue, production de contenu, netlinking). Le tarif dépend de la taille du site, du secteur et du niveau de concurrence." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit SEO est une analyse complète de votre site web permettant d'identifier tous les problèmes qui freinent votre référencement : erreurs techniques (temps de chargement, structure, indexation), problèmes de contenu (pages thin content, duplicate content, manque de mots-clés), et manques de notoriété (backlinks insuffisants). L'audit est la première étape indispensable de toute stratégie SEO." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre SEO et SEA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEO (Search Engine Optimization) désigne le référencement naturel, c'est-à-dire les actions pour améliorer le positionnement de votre site dans les résultats organiques de Google sans payer chaque clic. Le SEA (Search Engine Advertising) désigne la publicité payante sur les moteurs de recherche (Google Ads). Les deux sont complémentaires : le SEA génère des résultats immédiats, le SEO construit une visibilité durable." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

