{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 154 chars description) ─────────────────── #}
{% block title %}Maintenance & support technique externalisé{% endblock %}

{% block description %}Maintenance corrective et évolutive de vos sites, logiciels et applications : correction de bugs, mises à jour, support technique réactif. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Maintenance & Support technique externalisé",
      "url": "{{ app_url }}/support-maintenance/maintenance",
      "description": "Accompagnement technique continu pour assurer le bon fonctionnement, la correction des anomalies et l'évolution des outils digitaux de l'entreprise : sites, logiciels, applications, serveurs.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Maintenance informatique et support technique",
      "offers": [
        { "@type": "Offer", "name": "Support ponctuel",          "price": "300",  "priceCurrency": "EUR", "description": "300 à 800 € / intervention" },
        { "@type": "Offer", "name": "Maintenance mensuelle",     "price": "200",  "priceCurrency": "EUR", "description": "200 à 1 000 € / mois" },
        { "@type": "Offer", "name": "Maintenance avancée",       "price": "1000", "priceCurrency": "EUR", "description": "1 000 à 3 000 € / mois +" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",  "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Maintenance & Support technique", "item": "{{ app_url }}/support-maintenance/maintenance" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un contrat de maintenance informatique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un contrat de maintenance informatique est un accord par lequel vous déléguez la gestion technique de vos outils digitaux (sites, logiciels, applications) à un prestataire spécialisé. Il couvre la correction des bugs, les mises à jour, la surveillance du fonctionnement et l'évolution des outils selon vos besoins." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre maintenance corrective et évolutive ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance corrective consiste à identifier et corriger les anomalies, bugs et dysfonctionnements — elle réagit aux problèmes. La maintenance évolutive consiste à améliorer, moderniser et faire évoluer vos outils pour qu'ils s'adaptent à vos nouveaux besoins — elle anticipe. Les deux sont complémentaires et idéalement combinées dans un contrat de maintenance." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un contrat de maintenance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 300 € à 800 € par intervention pour un support ponctuel, de 200 € à 1 000 € par mois pour une maintenance mensuelle standard, et de 1 000 € à 3 000 €+ par mois pour des systèmes critiques ou des périmètres étendus. Des forfaits d'heures mensuels sont également disponibles." }
        },
        {
          "@type": "Question",
          "name": "Pouvez-vous reprendre la maintenance d'un outil que vous n'avez pas développé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — nous intervenons sur des sites, logiciels et applications que nous n'avons pas développés. Une phase d'audit technique initiale nous permet de comprendre l'architecture, documenter le code et évaluer l'état du projet avant de prendre en charge la maintenance." }
        },
        {
          "@type": "Question",
          "name": "Quel est votre délai d'intervention en cas de bug critique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le délai d'intervention dépend du niveau de SLA défini dans votre contrat. Pour les systèmes critiques, nous proposons une réactivité sous 2 à 4 heures en heures ouvrées, voire une astreinte 24/7 pour les cas les plus sensibles. Pour un support standard, le délai est de 24 à 48h ouvrées." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

