{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 148 chars description) ─────────────────── #}
{% block title %}SEO local | Référencement Google Maps & local | Complianz{% endblock %}

{% block description %}Boostez votre visibilité locale sur Google Maps et les recherches géolocalisées. Google Business Profile optimisé, citations locales et avis clients.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "SEO local",
      "url": "{{ app_url }}/performance-digitale/seo/seo-local",
      "description": "Optimisation de la visibilité locale sur Google Maps et les recherches géolocalisées. Google Business Profile, citations locales, avis clients et pages locales pour dominer les recherches de proximité.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Référencement local SEO",
      "offers": [
        { "@type": "Offer", "name": "SEO Local Starter",  "price": "690",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1400" } },
        { "@type": "Offer", "name": "SEO Local Standard", "price": "1400", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2500" } },
        { "@type": "Offer", "name": "SEO Local Premium",  "price": "2500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Référencement naturel (SEO)",       "item": "{{ app_url }}/performance-digitale/seo" },
        { "@type": "ListItem", "position": 4, "name": "SEO local",                         "item": "{{ app_url }}/performance-digitale/seo/seo-local" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le SEO local ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEO local est l'ensemble des techniques visant à améliorer la visibilité d'une entreprise dans les résultats de recherche géolocalisés : Google Maps, le pack local (les 3 résultats avec carte) et les recherches avec mention de ville ou département. Il est indispensable pour toute entreprise ayant une présence physique ou ciblant une zone géographique précise." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi optimiser Google Business Profile ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Google Business Profile (anciennement Google My Business) est le principal levier du SEO local. Une fiche bien optimisée améliore votre visibilité dans le pack local et sur Google Maps, affiche vos horaires, avis et photos, et génère des appels et demandes d'itinéraire directement depuis la recherche. Plus de 80% des consommateurs consultent une fiche GBP avant de se rendre en magasin." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour voir des résultats en SEO local ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les premières améliorations visibles (meilleure position dans le pack local, plus d'appels et de clics depuis la fiche GBP) apparaissent généralement en 1 à 3 mois. Le SEO local est plus rapide que le SEO national car la concurrence est plus localisée. Une stratégie complète avec landing pages et citations produit des résultats durables en 3 à 6 mois." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que la cohérence NAP en SEO local ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le NAP (Name, Address, Phone) désigne la cohérence de vos informations d'entreprise (nom, adresse, téléphone) à travers tous les annuaires et mentions en ligne. Une incohérence NAP — une adresse différente entre votre fiche GBP et Pages Jaunes, par exemple — nuit à votre référencement local. L'audit NAP identifie et corrige toutes ces incohérences." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

