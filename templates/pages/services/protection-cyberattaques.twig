{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Protection cyberattaques | Sécurisation SI entreprise | Complianz{% endblock %}

{% block description %}Protégez votre entreprise des cyberattaques : ransomware, phishing, intrusions. Mise en place de solutions de cybersécurité et sensibilisation des équipes.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Protection contre les cyberattaques — Sécurisation du SI",
      "url": "{{ app_url }}/audit-conformite/cybersecurite/protection-cyberattaques",
      "description": "Mise en place d'une protection complète contre les cyberattaques : audit des vulnérabilités, déploiement de solutions techniques (firewall, EDR, MFA), sensibilisation des équipes, procédures de réponse aux incidents et plan de reprise après sinistre.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Protection contre les cyberattaques",
      "offers": [
        { "@type": "Offer", "name": "Pack Protection Essentiel",       "price": "2500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4900"  } },
        { "@type": "Offer", "name": "Pack Protection Avancé",          "price": "5500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900"  } },
        { "@type": "Offer", "name": "Pack Protection Complet + SOC",   "price": "9900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "18000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                             "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",         "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Cybersécurité",                       "item": "{{ app_url }}/audit-conformite/cybersecurite" },
        { "@type": "ListItem", "position": 4, "name": "Protection contre les cyberattaques", "item": "{{ app_url }}/audit-conformite/cybersecurite/protection-cyberattaques" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelles sont les principales cyberattaques qui menacent les PME ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les principales menaces pour les PME sont : le ransomware (chiffrement des données contre rançon), le phishing (emails frauduleux pour voler des identifiants), les attaques par force brute (tentatives massives de connexion), les compromissions de comptes cloud, et les attaques via des sous-traitants ou partenaires (supply chain). En 2024, 1 PME sur 2 a subi au moins un incident de sécurité." }
        },
        {
          "@type": "Question",
          "name": "Comment protéger efficacement son entreprise des cyberattaques ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une protection efficace repose sur 3 piliers : technique (firewall, EDR, MFA, mises à jour, sauvegardes chiffrées), organisationnel (politique de sécurité PSSI, gestion des accès, procédures d'incident) et humain (sensibilisation et formation des collaborateurs). Aucun de ces piliers n'est suffisant seul — les 3 doivent être mis en place ensemble." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un EDR et en ai-je besoin ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un EDR (Endpoint Detection and Response) est une solution de sécurité avancée qui surveille en temps réel les comportements sur vos postes et serveurs pour détecter et bloquer les attaques, même inconnues (zero-day). Contrairement à un antivirus classique, l'EDR analyse les comportements suspects, pas seulement les signatures connues. Il est recommandé pour toute entreprise avec des données sensibles ou des accès distants." }
        },
        {
          "@type": "Question",
          "name": "Que faire si on est victime d'un ransomware ?",
          "acceptedAnswer": { "@type": "Answer", "text": "En cas de ransomware : 1) Isolez immédiatement les machines touchées du réseau, 2) Ne payez pas la rançon (sans garantie de récupération et cela encourage les attaquants), 3) Contactez un expert cybersécurité, 4) Signalez l'incident à l'ANSSI et à la CNIL si des données personnelles sont compromises, 5) Activez votre Plan de Reprise d'Activité (PRA). La préparation préalable (sauvegardes hors ligne, PRA) est la meilleure protection." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

