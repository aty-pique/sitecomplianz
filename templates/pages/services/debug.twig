{% extends 'layouts/base.twig' %}

{# ── SEO (59 chars titre / 151 chars description) ─────────────────── #}
{% block title %}Debug & résolution de bugs complexes — sites & logiciels{% endblock %}

{% block description %}Analyse approfondie et résolution durable de bugs complexes sur vos sites, logiciels et serveurs. Recherche de causes racines, correction experte et stabilisation des systèmes.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Debug & résolution de bugs complexes",
      "url": "{{ app_url }}/support-maintenance/maintenance/debug",
      "description": "Analyse approfondie et résolution de problèmes techniques complexes affectant les sites, logiciels ou infrastructures, nécessitant une expertise avancée. Recherche de causes racines, diagnostic avancé, correction et stabilisation.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Debug et résolution de bugs informatiques",
      "offers": [
        { "@type": "Offer", "name": "Debug simple",   "price": "300",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1000" } },
        { "@type": "Offer", "name": "Debug complexe", "price": "1000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } },
        { "@type": "Offer", "name": "Debug critique", "price": "3000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",             "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Maintenance, support & évolutions", "item": "{{ app_url }}/support-maintenance/maintenance" },
        { "@type": "ListItem", "position": 4, "name": "Debug & résolution de bugs",        "item": "{{ app_url }}/support-maintenance/maintenance/debug" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle différence entre le debug et la maintenance corrective ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance corrective traite les bugs courants et anomalies standard — corrections rapides sur des problèmes bien identifiés. Le debug s'attaque aux problèmes complexes, difficiles à reproduire, qui nécessitent une analyse approfondie des causes racines, un diagnostic expert et une intervention sur des environnements techniques complexes. Le debug est plus long, plus méthodique et mobilise une expertise technique avancée." }
        },
        {
          "@type": "Question",
          "name": "Quels types de bugs résolvez-vous ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intervenons sur tous les bugs complexes : bugs intermittents difficiles à reproduire, problèmes de performance dégradée sans cause évidente, conflits entre systèmes ou dépendances, erreurs critiques en production, corruptions de données, failles de sécurité exploitées, bugs liés à des migrations ou des mises à jour majeures, et tout problème technique résistant aux corrections standards." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps dure une mission de debug ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un debug simple (bug identifiable après analyse) se résout généralement en 1 à 3 jours. Un debug complexe (bug intermittent, problème architectural) nécessite souvent 1 à 2 semaines d'investigation. Un debug critique sur une infrastructure peut prendre plusieurs semaines selon la complexité des systèmes impliqués. Nous vous communiquons une estimation après l'analyse préliminaire." }
        },
        {
          "@type": "Question",
          "name": "Pouvez-vous intervenir sur n'importe quelle technologie ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intervenons sur les principales technologies web et applicatives : PHP, JavaScript, Python, Node.js, Java, React, Vue.js, WordPress, Symfony, Laravel, ainsi que sur les bases de données (MySQL, PostgreSQL, MongoDB), les serveurs (Linux, Nginx, Apache) et les infrastructures cloud (AWS, OVH, Azure). Pour des technologies très spécifiques, nous évaluons notre capacité lors de la prise de contact." }
        },
        {
          "@type": "Question",
          "name": "Comment se déroule la mission de debug ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La mission suit un processus structuré : analyse approfondie du problème, recherche des causes racines (root cause analysis), diagnostic avancé avec logs et outils de monitoring, correction technique précise, tests poussés en environnement isolé, stabilisation et déploiement progressif, puis documentation complète de la résolution pour éviter toute récidive." }
      }
    }
  ]
}
</script>
{% endblock %}

