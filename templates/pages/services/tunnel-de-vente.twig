{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 152 chars description) ─────────────────── #}
{% block title %}Optimisation tunnel de conversion | CRO & UX{% endblock %}

{% block description %}Analysez et optimisez votre tunnel de conversion pour transformer davantage de visiteurs en clients. Audit UX, CRO, A/B testing et suivi des performances.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Optimisation tunnel de conversion",
      "url": "{{ app_url }}/performance-digitale/tunnel-de-vente",
      "description": "Analyse et optimisation du parcours utilisateur (tunnel de conversion) pour augmenter le taux de transformation des visiteurs en prospects ou clients. Identification des points de friction, amélioration de l'UX et maximisation de la performance commerciale.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "CRO — Optimisation du taux de conversion",
      "offers": [
        { "@type": "Offer", "name": "Optimisation simple",                         "price": "1500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4000"  } },
        { "@type": "Offer", "name": "Optimisation structurée",                      "price": "4000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "Optimisation avancée / Stratégie CRO",        "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } },
        { "@type": "Offer", "name": "Accompagnement mensuel CRO",                  "price": "800",   "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2500"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Optimisation tunnel de conversion", "item": "{{ app_url }}/performance-digitale/tunnel-de-vente" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un tunnel de conversion ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un tunnel de conversion (ou funnel de vente) est le parcours qu'un visiteur suit depuis sa première interaction avec votre entreprise jusqu'à l'acte de conversion (achat, prise de contact, inscription…). Il comprend généralement plusieurs étapes : awareness (découverte), consideration (évaluation), decision (achat). Optimiser ce tunnel consiste à réduire les points de friction à chaque étape pour maximiser le nombre de visiteurs qui atteignent la conversion finale." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que le CRO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le CRO (Conversion Rate Optimization) désigne l'ensemble des méthodes visant à augmenter le taux de conversion d'un site ou d'un tunnel de vente — c'est-à-dire le pourcentage de visiteurs qui réalisent l'action souhaitée. Le CRO s'appuie sur l'analyse comportementale, les tests A/B, l'optimisation UX, l'amélioration des CTA et des formulaires." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte l'optimisation d'un tunnel de conversion ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 500 € à 4 000 € pour une optimisation simple (audit + recommandations sur 1-2 pages clés), de 4 000 € à 10 000 € pour une optimisation structurée (audit complet + A/B tests + implémentation), de 10 000 € à 25 000 €+ pour une stratégie CRO complète, et de 800 € à 2 500 €/mois pour un accompagnement mensuel continu." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour voir des résultats en CRO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les premières optimisations rapides (amélioration des CTA, formulaires, pages de destination) peuvent générer des résultats en 2 à 4 semaines. Les tests A/B nécessitent du trafic suffisant pour être statistiquement significatifs — généralement 4 à 8 semaines. Une stratégie CRO complète génère un impact mesurable sur le chiffre d'affaires en 3 à 6 mois." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre optimisation tunnel de conversion et SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEO améliore la quantité et la qualité du trafic entrant. L'optimisation du tunnel de conversion améliore ce que vous faites de ce trafic — votre taux de transformation. Les deux sont complémentaires : le SEO attire plus de visiteurs, le CRO les convertit mieux. Doubler son taux de conversion revient à doubler son trafic en termes d'impact commercial." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

