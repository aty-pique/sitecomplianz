{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 151 chars description) ─────────────────── #}
{% block title %}Pilotage commercial & KPI — tableaux de bord data{% endblock %}

{% block description %}Pilotez votre activité avec des données fiables : KPI marketing, tableaux de bord commerciaux et analyse de performance pour des décisions efficaces. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Pilotage commercial & KPI",
      "url": "{{ app_url }}/performance-digitale/pilotage-commercial",
      "description": "Mise en place et accompagnement dans le pilotage de la performance commerciale digitale : suivi des KPI, tableaux de bord, analyse des résultats marketing et commerciaux. Permettre au dirigeant de piloter son activité avec des données fiables et une vision structurée.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Pilotage commercial et tableaux de bord KPI",
      "offers": [
        { "@type": "Offer", "name": "Mise en place simple",           "price": "2000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000"  } },
        { "@type": "Offer", "name": "Pilotage structuré",             "price": "5000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } },
        { "@type": "Offer", "name": "Pilotage avancé",                "price": "12000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "30000" } },
        { "@type": "Offer", "name": "Accompagnement mensuel",         "price": "1000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Pilotage commercial & KPI",        "item": "{{ app_url }}/performance-digitale/pilotage-commercial" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le pilotage commercial digital ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le pilotage commercial digital consiste à suivre, analyser et optimiser les résultats de vos actions marketing et commerciales à l'aide de données fiables. Il comprend la définition des KPI pertinents, la mise en place de tableaux de bord, la centralisation des données et un suivi régulier pour prendre des décisions éclairées et identifier les leviers de croissance." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un KPI commercial ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un KPI (Key Performance Indicator) commercial est un indicateur clé de performance qui mesure l'efficacité d'une action commerciale ou marketing. Exemples : taux de conversion, coût d'acquisition client (CAC), valeur vie client (LTV), taux de transformation des leads, ROAS (retour sur dépenses publicitaires), trafic organique, taux d'ouverture email, etc." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi mettre en place un tableau de bord commercial ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un tableau de bord commercial centralise toutes vos données business en temps réel. Il vous permet de : suivre vos performances sans passer des heures sur les données brutes, identifier rapidement ce qui fonctionne ou ce qui pose problème, prendre des décisions basées sur des données fiables plutôt que sur l'intuition, et détecter les opportunités de croissance avant vos concurrents." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte la mise en place d'un système de pilotage commercial ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 2 000 € à 5 000 € pour une mise en place simple (1 dashboard, KPI essentiels, CRM de base), de 5 000 € à 12 000 € pour un pilotage structuré (multi-canaux, GA4, marketing automation), de 12 000 € à 30 000 €+ pour un pilotage avancé complet, et de 1 000 € à 3 000 €/mois pour un accompagnement mensuel continu." }
        },
        {
          "@type": "Question",
          "name": "Quels outils utilisez-vous pour le pilotage commercial ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous travaillons avec les outils adaptés à votre contexte : Google Analytics 4 (GA4), Looker Studio (anciennement Data Studio), HubSpot, Salesforce, Notion, Airtable, Power BI, Pipedrive, ActiveCampaign, etc. Nous pouvons interconnecter vos outils existants pour centraliser vos données dans un tableau de bord unique." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

