{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 147 chars description) ─────────────────── #}
{% block title %}Audit cybersécurité | Évaluation vulnérabilités SI | Complianz{% endblock %}

{% block description %}Identifiez toutes vos vulnérabilités informatiques avec un audit cybersécurité complet. Rapport + plan de remédiation. Tests techniques et organisationnels.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit de cybersécurité — Évaluation de vos vulnérabilités",
      "url": "{{ app_url }}/audit-conformite/cybersecurite/audit-cybersecurite",
      "description": "Identification complète des vulnérabilités informatiques de l'entreprise : audit technique des systèmes, test d'intrusion (pentest), analyse des politiques de sécurité, revue des accès et droits. Rapport de vulnérabilités et plan de remédiation priorisé.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit de cybersécurité",
      "offers": [
        { "@type": "Offer", "name": "Audit cybersécurité PME",         "price": "2500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4900"  } },
        { "@type": "Offer", "name": "Audit cybersécurité complet",     "price": "5500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900"  } },
        { "@type": "Offer", "name": "Audit + Plan de remédiation",     "price": "7500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "14000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Cybersécurité",               "item": "{{ app_url }}/audit-conformite/cybersecurite" },
        { "@type": "ListItem", "position": 4, "name": "Audit de cybersécurité",      "item": "{{ app_url }}/audit-conformite/cybersecurite/audit-cybersecurite" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit de cybersécurité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit de cybersécurité est une analyse approfondie et méthodique de vos systèmes informatiques, réseaux, applications et droits d'accès pour identifier toutes les vulnérabilités exploitables. Il aboutit à un rapport de vulnérabilités classées par criticité et à un plan de remédiation priorisé." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps dure un audit de cybersécurité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit cybersécurité dure généralement de 5 à 15 jours selon la taille du SI et le périmètre. Pour une PME avec un SI standard, comptez 5 à 8 jours d'audit + 2 jours de restitution. Pour un SI complexe ou un périmètre étendu, l'audit peut durer 3 à 4 semaines." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un audit de cybersécurité et un pentest ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit de cybersécurité est une analyse globale des risques (configuration, politiques, accès, documentation, organisation). Le pentest (test d'intrusion) va plus loin en simulant activement une attaque réelle pour identifier les vulnérabilités exploitables. Les deux sont complémentaires et souvent combinés dans un audit complet." }
        },
        {
          "@type": "Question",
          "name": "Que se passe-t-il après l'audit de cybersécurité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Après l'audit, vous recevez un rapport détaillé avec toutes les vulnérabilités identifiées classées par criticité (critique, élevée, moyenne, faible) et un plan de remédiation priorisé. Une séance de restitution est organisée avec la direction. Nous pouvons ensuite vous accompagner dans la mise en œuvre des correctifs et le suivi de remédiation." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

