{% extends 'layouts/base.twig' %}

{# ── SEO (60 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Développement SaaS | Création logiciel en ligne sur mesure | Complianz{% endblock %}

{% block description %}Créez votre application SaaS : architecture multi-tenant, authentification, paiement par abonnement et tableaux de bord. Du MVP au produit scalable.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Développement SaaS — Lancez votre logiciel en ligne",
      "url": "{{ app_url }}/solutions-developpement/developpement-logiciel/saas",
      "description": "Développement d'applications SaaS de A à Z : définition du MVP, architecture cloud scalable, front/back (React, Next.js, API REST), authentification, paiement par abonnement (Stripe) et infrastructure CI/CD.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Développement SaaS",
      "offers": [
        { "@type": "Offer", "name": "MVP SaaS",      "price": "14000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "28000"  } },
        { "@type": "Offer", "name": "SaaS Standard", "price": "28000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "55000"  } },
        { "@type": "Offer", "name": "SaaS Avancé",   "price": "55000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "200000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                      "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement",    "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Développement logiciel",       "item": "{{ app_url }}/solutions-developpement/developpement-logiciel" },
        { "@type": "ListItem", "position": 4, "name": "Développement SaaS",           "item": "{{ app_url }}/solutions-developpement/developpement-logiciel/saas" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un MVP SaaS ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un MVP (Minimum Viable Product) SaaS est la version minimale de votre logiciel en ligne incluant uniquement les fonctionnalités essentielles pour tester votre marché avec de vrais utilisateurs. L'objectif est de valider votre proposition de valeur rapidement, à moindre coût, avant d'investir dans les fonctionnalités avancées. Nous vous aidons à définir les fonctionnalités du MVP lors du cadrage." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour développer un SaaS ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 4 à 6 mois pour un MVP SaaS (fonctionnalités essentielles, authentification, paiement), de 6 à 12 mois pour un SaaS Standard (fonctionnalités complètes, API, intégrations), et de 12 à 24 mois pour un SaaS Avancé (multi-tenant complexe, marketplace, IA). Nous travaillons en sprints agiles pour livrer des incréments fonctionnels toutes les 2 semaines." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une architecture multi-tenant pour un SaaS ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une architecture multi-tenant permet à plusieurs clients (tenants) d'utiliser la même instance du logiciel tout en ayant des données complètement isolées et une configuration personnalisée. C'est le modèle standard des SaaS : vous gérez une seule codebase pour tous vos clients, ce qui réduit les coûts d'infrastructure et simplifie les mises à jour." }
        },
        {
          "@type": "Question",
          "name": "Comment gérer les abonnements et paiements dans un SaaS ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intégrons Stripe pour la gestion des abonnements récurrents — différents plans tarifaires, upgrades/downgrades, facturation automatique, gestion des échecs de paiement et portail client en libre-service. Stripe est la solution de référence pour les SaaS : fiable, scalable et conforme PSD2/RGPD." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

