{% extends 'layouts/base.twig' %}

{# ── SEO (59 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Accompagnement création d'entreprise | Business plan &amp; juridique | Complianz{% endblock %}

{% block description %}Créez votre entreprise sereinement avec un accompagnement expert : statuts juridiques, business plan, prévisionnel financier et conformité dès le départ.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Accompagnement à la création d'entreprise",
      "url": "{{ app_url }}/audit-conformite/audit-conseil/creation-entreprise",
      "description": "Accompagnement complet à la création d'entreprise : choix de la forme juridique, rédaction des statuts, business plan financier, immatriculation, mise en conformité initiale (RGPD, mentions légales…) et accompagnement bancaire. Dès 1 900€ HT.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Accompagnement création d'entreprise",
      "offers": [
        { "@type": "Offer", "name": "Pack Création Essentiel",  "price": "1900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500"  } },
        { "@type": "Offer", "name": "Pack Création Standard",   "price": "3500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500"  } },
        { "@type": "Offer", "name": "Pack Création Premium",    "price": "6500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                       "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",   "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Audit & Conseil",               "item": "{{ app_url }}/audit-conformite/audit-conseil" },
        { "@type": "ListItem", "position": 4, "name": "Création d'entreprise",         "item": "{{ app_url }}/audit-conformite/audit-conseil/creation-entreprise" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle forme juridique choisir pour créer son entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix de la forme juridique dépend de votre situation : activité solo ou à plusieurs associés, niveau de protection patrimoniale souhaité, fiscalité cible et perspectives de croissance. SAS, SARL, EURL, SA, entreprise individuelle — chaque structure a ses avantages. Nos experts analysent votre situation et vous recommandent la forme juridique la plus adaptée." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi faire appel à un accompagnant pour créer son entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Créer une entreprise implique des choix structurants (forme juridique, fiscalité, statuts) qui auront des conséquences durables. Un accompagnement expert évite les erreurs coûteuses, optimise la structure dès le départ, sécurise la rédaction des statuts et garantit une conformité légale immédiate (RGPD, mentions légales…). Le coût d'un accompagnement est généralement bien inférieur au coût des corrections ultérieures." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour créer une entreprise avec accompagnement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Avec un accompagnement complet, la création d'une entreprise prend généralement 3 à 6 semaines : 1 à 2 semaines pour le conseil juridique et la rédaction des statuts, 1 à 2 semaines pour le business plan et le prévisionnel financier, et 1 à 2 semaines pour les formalités d'immatriculation. Les délais réels dépendent des organismes officiels." }
        },
        {
          "@type": "Question",
          "name": "Faut-il être conforme au RGPD dès la création de l'entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, dès que votre entreprise collecte des données personnelles (clients, prospects, employés…), elle est soumise au RGPD. Il est bien plus simple et économique de mettre en place les bases de la conformité RGPD dès la création plutôt que de corriger des non-conformités plus tard. Nous intégrons systématiquement la conformité RGPD dans notre accompagnement à la création." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

