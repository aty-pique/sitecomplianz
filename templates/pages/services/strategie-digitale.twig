{% extends 'layouts/base.twig' %}

{# ── SEO (38 chars titre / 152 chars description) ─────────────────── #}
{% block title %}Stratégie digitale globale{% endblock %}

{% block description %}Définissez votre stratégie digitale complète : analyse de marché, leviers prioritaires, roadmap et plan d'action orientés résultats. Consultant expert.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Stratégie digitale globale",
      "url": "{{ app_url }}/performance-digitale/strategie-digitale",
      "description": "Définition d'une stratégie digitale complète alignée avec les objectifs de l'entreprise : analyse de marché, positionnement, leviers prioritaires, roadmap et plan d'action orientés résultats.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Conseil en stratégie digitale",
      "offers": [
        { "@type": "Offer", "name": "Stratégie simple",     "price": "1500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4000"  } },
        { "@type": "Offer", "name": "Stratégie structurée", "price": "4000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "Stratégie complète",   "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                            "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie",  "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Stratégie digitale globale",         "item": "{{ app_url }}/performance-digitale/strategie-digitale" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une stratégie digitale ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une stratégie digitale est un plan structuré qui définit comment une entreprise utilise les canaux numériques (SEO, réseaux sociaux, publicité en ligne, email, contenu…) pour atteindre ses objectifs commerciaux. Elle aligne la présence en ligne avec la stratégie globale de l'entreprise et priorise les actions selon leur impact attendu." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi faut-il une stratégie digitale avant de lancer des actions marketing ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Sans stratégie, les actions digitales (posts sur les réseaux sociaux, campagnes publicitaires, newsletters…) sont souvent décorrélées des objectifs business et peu efficaces. Une stratégie digitale structure les priorités, définit les cibles, choisit les bons canaux et établit des KPIs clairs — transformant des actions isolées en un système cohérent." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte la définition d'une stratégie digitale ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 500 € à 4 000 € pour une stratégie simple (1 à 2 canaux, TPE/artisan), de 4 000 € à 10 000 € pour une stratégie structurée (PME, multi-canaux, persona + roadmap), et de 10 000 € à 20 000 €+ pour une stratégie complète (ETI, concurrence forte, transformation digitale)." }
        },
        {
          "@type": "Question",
          "name": "Que contient un livrable de stratégie digitale ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Notre livrable de stratégie digitale comprend : audit de la situation actuelle, analyse de marché et des concurrents, définition des personas, identification des leviers prioritaires, plan d'action par canal, roadmap à 6-12 mois, KPIs à suivre et recommandations opérationnelles. Le tout est présenté lors d'une session de restitution stratégique." }
        },
        {
          "@type": "Question",
          "name": "Accompagnez-vous l'exécution de la stratégie après sa définition ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — après la phase stratégique, nous pouvons accompagner l'exécution via nos services de marketing digital, SEO, publicité digitale et email marketing. Nous pouvons également former vos équipes pour qu'elles exécutent la stratégie en interne, ou la piloter entièrement pour vous." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

