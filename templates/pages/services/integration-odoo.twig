{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Intégration Odoo | Déploiement & personnalisation ERP | Complianz{% endblock %}

{% block description %}Déployez et personnalisez Odoo pour votre entreprise. Modules sur mesure, migration de données, formation et support. Intégration avec vos outils existants.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Intégration Odoo & ERP existants",
      "url": "{{ app_url }}/solutions-developpement/erp-crm/integration-odoo",
      "description": "Audit des besoins, installation et configuration Odoo, développement de modules sur mesure, migration des données existantes, formation des utilisateurs et support maintenance Odoo.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Intégration Odoo",
      "offers": [
        { "@type": "Offer", "name": "Intégration Odoo Starter",   "price": "5900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900"  } },
        { "@type": "Offer", "name": "Intégration Odoo Standard",  "price": "9900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "19000" } },
        { "@type": "Offer", "name": "Odoo Enterprise custom",     "price": "19000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "40000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "ERP & CRM",                 "item": "{{ app_url }}/solutions-developpement/erp-crm" },
        { "@type": "ListItem", "position": 4, "name": "Intégration Odoo",          "item": "{{ app_url }}/solutions-developpement/erp-crm/integration-odoo" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi choisir Odoo plutôt qu'un ERP sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Odoo est une excellente solution lorsque vos processus s'adaptent à des workflows standards. Il offre un large écosystème de modules (CRM, comptabilité, stocks, RH, e-commerce…), une communauté active et un coût initial plus faible qu'un ERP entièrement sur mesure. Nous le personnalisons et l'adaptons à votre organisation pour qu'il corresponde à vos besoins spécifiques." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps prend une intégration Odoo ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 6 à 10 semaines pour une intégration Starter (3 modules standards), de 3 à 5 mois pour une intégration Standard (5-8 modules avec personnalisations), et de 5 à 9 mois pour un déploiement Enterprise avec modules sur mesure. Le délai dépend du nombre de modules, des personnalisations et du volume de données à migrer." }
        },
        {
          "@type": "Question",
          "name": "Peut-on migrer nos données Excel ou ancien ERP vers Odoo ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — la migration de vos données est incluse dans notre périmètre. Nous réalisons un audit et un nettoyage de vos données sources (fichiers Excel, ancien ERP, base Access…), puis migrons les données dans Odoo avec validation à chaque étape. Les contacts, articles, historique des ventes et stocks sont repris intégralement." }
        },
        {
          "@type": "Question",
          "name": "Odoo peut-il se connecter à nos autres outils (compta, e-commerce…) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — Odoo propose de nombreux connecteurs natifs (WooCommerce, Shopify, Amazon, Stripe, PayPal…) et nous développons des connecteurs sur mesure pour vos outils spécifiques (logiciel de comptabilité, plateforme logistique, ERP legacy…). L'objectif est de centraliser vos données dans Odoo sans créer de silos d'information." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

