{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 140 chars description) ─────────────────── #}
{% block title %}Landing pages conversion | Pages d'atterrissage optimisées | Complianz{% endblock %}

{% block description %}Créez des landing pages qui convertissent vos visiteurs en leads. Design persuasif, A/B testing, intégration CRM. Livraison en 1-2 semaines.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création de landing pages à fort taux de conversion",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web/landing-pages",
      "description": "Conception et développement de landing pages orientées conversion : copywriting persuasif, design optimisé, A/B testing, intégration outils marketing et tracking analytics.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création landing pages",
      "offers": [
        { "@type": "Offer", "name": "Landing page Simple",              "price": "800",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Pack 3 Landing pages",             "price": "2200", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4500" } },
        { "@type": "Offer", "name": "Landing page Premium + A/B testing","price": "2500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4900" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" },
        { "@type": "ListItem", "position": 4, "name": "Landing pages",             "item": "{{ app_url }}/solutions-developpement/creation-site-web/landing-pages" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une landing page et à quoi ça sert ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une landing page (page d'atterrissage) est une page web conçue pour convertir un visiteur en lead ou en client via une action précise : remplir un formulaire, s'inscrire, télécharger, acheter. Contrairement à un site web généraliste, elle est focalisée sur un objectif unique, sans distraction, ce qui maximise le taux de conversion de vos campagnes publicitaires ou d'emailing." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour créer une landing page ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 à 2 semaines pour une landing page Simple, de 2 à 3 semaines pour une landing page Premium avec A/B testing. Le délai dépend de la disponibilité des contenus et des validations. Pour les campagnes urgentes, nous pouvons nous adapter avec un délai accéléré." }
        },
        {
          "@type": "Question",
          "name": "Comment mesurer les performances d'une landing page ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intégrons Google Analytics 4, Google Tag Manager et les pixels publicitaires (Meta, Google Ads…) pour suivre précisément les conversions, le taux de rebond, le temps passé et les sources de trafic. Un tableau de bord de suivi des performances est livré avec chaque landing page Premium." }
        },
        {
          "@type": "Question",
          "name": "L'A/B testing est-il vraiment utile pour une landing page ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'A/B testing permet de tester plusieurs variantes (titre, CTA, formulaire, visuels) pour identifier celle qui convertit le mieux. En pratique, un test A/B bien conduit peut améliorer le taux de conversion de 20 à 50%. Nous gérons tout le dispositif : paramétrage, analyse et recommandations d'optimisation." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

