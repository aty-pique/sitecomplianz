{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Cloud managé & infrastructure | Migration et gestion cloud | Complianz{% endblock %}

{% block description %}Migrez et gérez votre infrastructure cloud (AWS, Azure, OVH). Architecture scalable, sécurisée et performante. Infogérance cloud complète avec support dédié.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Cloud & infrastructure managée",
      "url": "{{ app_url }}/support-maintenance/infogerance/cloud-infrastructure",
      "description": "Migration et gestion d'infrastructure cloud complète : audit de l'infrastructure existante, migration vers AWS/Azure/GCP/OVH, architecture scalable, sécurisation et monitoring 24/7, optimisation des coûts et support technique dédié.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Infrastructure cloud managée et migration cloud",
      "offers": [
        { "@type": "Offer", "name": "Cloud Starter",   "price": "790",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1400" } },
        { "@type": "Offer", "name": "Cloud Standard",  "price": "1400", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2800" } },
        { "@type": "Offer", "name": "Cloud Enterprise", "price": "2800", "priceCurrency": "EUR" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",               "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance", "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Infogérance",           "item": "{{ app_url }}/support-maintenance/infogerance" },
        { "@type": "ListItem", "position": 4, "name": "Cloud & infrastructure","item": "{{ app_url }}/support-maintenance/infogerance/cloud-infrastructure" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quel cloud choisir entre AWS, Azure, GCP et OVH ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix dépend de votre contexte. AWS est le leader mondial avec le catalogue de services le plus large — idéal pour les applications complexes et les startups en croissance. Azure s'impose naturellement dans les environnements Microsoft (Office 365, Active Directory). GCP excelle pour le machine learning et le big data. OVH est la solution souveraine européenne, RGPD-native et très compétitive pour les PME françaises. Nous vous guidons vers le choix optimal lors de l'audit d'infrastructure." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps prend une migration vers le cloud ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une migration simple (un serveur, une application) peut prendre 2 à 4 semaines. Une migration complexe (multi-serveurs, bases de données, applications critiques) prend 2 à 6 mois. Nous utilisons une approche par phases : audit, architecture cible, migration par blocs, tests et bascule. La durée dépend surtout de la qualité de la documentation existante et de la tolérance aux interruptions." }
        },
        {
          "@type": "Question",
          "name": "Comment maîtriser les coûts du cloud ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les coûts cloud peuvent vite dériver sans pilotage. Nous mettons en place plusieurs leviers : rightsizing des instances (taille adéquate aux besoins réels), instances réservées pour les charges stables, auto-scaling pour les pics temporaires, alertes de budget, et audit mensuel des ressources non utilisées. Une infrastructure cloud bien pilotée coûte en général 20 à 40% moins cher qu'une infrastructure physique équivalente." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que le monitoring 24/7 d'une infrastructure cloud ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le monitoring 24/7 désigne la surveillance continue de l'ensemble de votre infrastructure cloud : disponibilité des serveurs, performances (CPU, mémoire, disque, réseau), logs d'erreurs, alertes de sécurité et coûts. En cas d'anomalie, nos équipes sont alertées automatiquement et interviennent en moins de 15 minutes. Des tableaux de bord temps réel vous permettent aussi de suivre l'état de votre infrastructure à tout moment." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

