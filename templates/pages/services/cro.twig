{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 147 chars description) ─────────────────── #}
{% block title %}CRO | Optimisation taux de conversion site web | Complianz{% endblock %}

{% block description %}Augmentez votre taux de conversion avec le CRO. Analyse comportementale, A/B testing, heatmaps et optimisation des parcours. +20% de conversions en moyenne.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "CRO — Optimisation du taux de conversion",
      "url": "{{ app_url }}/performance-digitale/tunnel-de-vente/cro",
      "description": "Augmentation du taux de conversion par l'analyse comportementale, les tests A/B, les heatmaps et l'optimisation des parcours utilisateurs. Résultats mesurables sur le chiffre d'affaires sans augmenter le trafic.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "CRO — Optimisation du taux de conversion",
      "offers": [
        { "@type": "Offer", "name": "CRO Audit",              "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900" } },
        { "@type": "Offer", "name": "CRO Accompagnement 3 mois", "price": "2900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500" } },
        { "@type": "Offer", "name": "CRO Programme annuel",   "price": "5500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "11000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Tunnel de vente",                   "item": "{{ app_url }}/performance-digitale/tunnel-de-vente" },
        { "@type": "ListItem", "position": 4, "name": "CRO",                               "item": "{{ app_url }}/performance-digitale/tunnel-de-vente/cro" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le CRO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le CRO (Conversion Rate Optimization) désigne l'ensemble des méthodes visant à augmenter le taux de conversion d'un site ou d'un tunnel de vente — le pourcentage de visiteurs qui réalisent l'action souhaitée (achat, demande de devis, inscription). Le CRO s'appuie sur l'analyse comportementale, les tests A/B, l'optimisation UX, l'amélioration des CTA et des formulaires. C'est une discipline basée sur la data, pas sur l'intuition." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour voir des résultats en CRO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les premières optimisations rapides (amélioration des CTA, formulaires, pages de destination) peuvent générer des résultats mesurables en 2 à 4 semaines. Les tests A/B nécessitent généralement 4 à 8 semaines pour être statistiquement significatifs (selon le volume de trafic). Un programme CRO structuré génère un impact mesurable sur le CA en 3 à 6 mois." }
        },
        {
          "@type": "Question",
          "name": "Quel taux de conversion peut-on espérer atteindre ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le taux de conversion moyen varie fortement selon le secteur : 1 à 3% pour l'e-commerce, 3 à 8% pour la génération de leads B2B, 10 à 25% pour les formulaires de prise de contact simples. Notre objectif est d'améliorer votre taux actuel de 20 à 50% — ce qui peut représenter un doublement du CA sans augmenter le budget publicitaire." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre CRO et UX design ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'UX design crée des interfaces intuitives et agréables — c'est une discipline de conception. Le CRO optimise la performance commerciale en mesurant et en améliorant les taux de conversion. Le CRO utilise l'UX comme un levier, mais s'appuie systématiquement sur des données réelles (analytics, heatmaps, tests A/B) pour valider chaque changement avant déploiement, plutôt que de se baser sur des hypothèses de design." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

