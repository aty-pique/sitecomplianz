{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 149 chars description) ───────────────── #}
{% block title %}Mise en conformité RGPD, ISO &amp; réglementaire{% endblock %}

{% block description %}Audit de conformité complet : RGPD, ISO 9001, ISO 27001, SMQ, exigences sectorielles. Identifiez vos écarts, sécurisez votre activité. Devis gratuit sous 24h.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Mise en conformité RGPD, ISO & réglementaire",
      "url": "{{ app_url }}/audit-conformite/certifications-iso",
      "description": "Analyse complète du niveau de conformité de l'entreprise au regard des normes, réglementations et obligations applicables (RGPD, ISO 9001, ISO 27001, SMQ, exigences sectorielles). Identification des écarts, des risques juridiques et du plan d'actions correctives.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit de conformité réglementaire et normative",
      "offers": [
        { "@type": "Offer", "name": "Audit RGPD simple",        "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } },
        { "@type": "Offer", "name": "Audit conformité intermédiaire", "price": "3000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6000" } },
        { "@type": "Offer", "name": "Audit complet ISO / multi-réglementaire", "price": "6000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                          "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",      "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Mise en conformité RGPD & ISO",    "item": "{{ app_url }}/audit-conformite/certifications-iso" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit de conformité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit de conformité est une analyse structurée du niveau de respect des obligations légales, réglementaires ou normatives d'une entreprise (RGPD, ISO 9001, ISO 27001, SMQ…). Il permet d'identifier les écarts, d'évaluer les risques et de définir un plan d'actions correctives prioritaires." }
        },
        {
          "@type": "Question",
          "name": "Quelles normes couvre votre audit de conformité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intervenons sur l'ensemble des référentiels applicables : RGPD (données personnelles), ISO 9001 (qualité), ISO 27001 (sécurité de l'information), ISO 13485 (dispositifs médicaux), SMQ, et les exigences sectorielles spécifiques à votre activité." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un audit RGPD et un audit ISO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit RGPD évalue le traitement et la protection des données personnelles selon le règlement européen. L'audit ISO analyse la conformité à des normes de management (qualité, sécurité informatique…). Les deux peuvent être menés simultanément pour une vision globale de votre conformité." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un audit de conformité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le coût dépend du périmètre et de la taille de votre entreprise : de 1 500 à 3 000 € pour un audit RGPD simple, de 3 000 à 6 000 € pour un audit intermédiaire (ISO + RGPD), et de 6 000 à 12 000 €+ pour un audit complet multi-réglementaire." }
        },
        {
          "@type": "Question",
          "name": "Quels sont les risques en cas de non-conformité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les risques varient selon le référentiel : sanctions CNIL jusqu'à 20 M€ ou 4% du CA pour le RGPD, perte de certifications ISO, litiges contractuels, responsabilité du dirigeant, atteinte à la réputation. Un audit préventif est largement moins coûteux qu'un contrôle subi." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

