{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Certification ISO 27001 | SMSI &amp; sécurité SI | Complianz{% endblock %}

{% block description %}Déployez un Système de Management de la Sécurité de l'Information conforme ISO 27001. Audit, SMSI, déclaration d'applicabilité et préparation à la certification.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Certification ISO 27001 — Sécurité des Systèmes d'Information",
      "url": "{{ app_url }}/audit-conformite/certifications-iso/iso-27001",
      "description": "Accompagnement complet à la certification ISO 27001 : analyse des risques SI (méthode EBIOS/ISO 27005), déclaration d'applicabilité (SOA), politique de sécurité SI, gestion des incidents, plan de continuité et accompagnement à l'audit de certification.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Certification ISO 27001",
      "offers": [
        { "@type": "Offer", "name": "Pack ISO 27001 PME",     "price": "7900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "14000" } },
        { "@type": "Offer", "name": "Pack ISO 27001 ETI",     "price": "14000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "28000" } },
        { "@type": "Offer", "name": "Surveillance continue", "price": "2400",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4800"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Certifications ISO",          "item": "{{ app_url }}/audit-conformite/certifications-iso" },
        { "@type": "ListItem", "position": 4, "name": "Certification ISO 27001",     "item": "{{ app_url }}/audit-conformite/certifications-iso/iso-27001" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de temps pour obtenir la certification ISO 27001 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'obtention de la certification ISO 27001 prend généralement entre 9 et 24 mois selon la taille de l'organisation, la complexité du SI et le niveau de maturité sécurité initial. Une PME avec un SI structuré peut viser 9 à 12 mois. Une ETI ou une organisation avec un SI complexe nécessitera 18 à 24 mois." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que la déclaration d'applicabilité (SOA) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La Déclaration d'Applicabilité (Statement of Applicability - SOA) est un document central de la certification ISO 27001. Elle liste les 93 mesures de sécurité de l'annexe A de la norme et justifie, pour chacune, si elle est applicable ou non à votre organisation, et si elle est mise en œuvre. C'est un document obligatoire pour la certification." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre ISO 27001 et RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le RGPD est une réglementation légale obligatoire portant sur la protection des données personnelles. ISO 27001 est une norme volontaire de management de la sécurité des systèmes d'information. Les deux sont complémentaires : ISO 27001 fournit le cadre technique et organisationnel pour répondre aux exigences de sécurité du RGPD." }
        },
        {
          "@type": "Question",
          "name": "ISO 27001 est-elle compatible avec NIS2 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, la certification ISO 27001 est reconnue comme un cadre de référence solide pour répondre aux exigences de la directive NIS2 (Network and Information Security). Les organisations soumises à NIS2 qui disposent d'une certification ISO 27001 ont un avantage significatif pour démontrer leur conformité aux autorités compétentes." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

