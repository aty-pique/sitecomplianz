{% extends 'layouts/base.twig' %}

{# ── SEO ──────────────────────────────────────────────────────────── #}
{% block title %}Audit IA — opportunités, gains et feuille de route pour votre entreprise{% endblock %}

{% block description %}Audit complet de votre SI, processus et outils pour identifier où l'IA peut créer de la valeur : gains de temps, coûts, performance. Feuille de route concrète pour passer à l'action.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit IA et évaluation des systèmes",
      "url": "{{ app_url }}/intelligence-artificielle/audit-ia",
      "description": "Analyse complète du système d'information, des processus et des outils de l'entreprise afin d'identifier les opportunités d'intégration de l'intelligence artificielle, déterminer où l'IA peut apporter un gain de performance, d'automatisation et de valeur, avec évaluation des impacts techniques, organisationnels et économiques.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit IA et évaluation des opportunités d'intégration",
      "offers": [
        { "@type": "Offer", "name": "Audit rapide (diagnostic initial)", "price": "1000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } },
        { "@type": "Offer", "name": "Audit complet (process + outils + opportunités)", "price": "3000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8000" } },
        { "@type": "Offer", "name": "Audit avancé (avec feuille de route stratégique)", "price": "8000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                    "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle",  "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Audit IA et évaluation des systèmes", "item": "{{ app_url }}/intelligence-artificielle/audit-ia" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit IA et à quoi sert-il concrètement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit IA est une analyse approfondie de votre système d'information, de vos processus et de vos outils pour identifier concrètement où et comment l'intelligence artificielle peut créer de la valeur dans votre entreprise. À l'issue de l'audit, vous disposez d'une cartographie des opportunités IA priorisées par ROI, d'une évaluation des impacts techniques et organisationnels, et d'une feuille de route concrète pour passer à l'action — sans investissement à l'aveugle." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un audit IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 000 à 3 000 € pour un audit rapide (diagnostic initial en quelques jours), de 3 000 à 8 000 € pour un audit complet couvrant les processus, outils et opportunités avec rapport détaillé, et de 8 000 à 20 000 € pour un audit avancé incluant une feuille de route stratégique et un plan d'implémentation priorisé." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps dure un audit IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit rapide prend 3 à 5 jours ouvrés. Un audit complet dure 2 à 4 semaines. Un audit avancé avec feuille de route prend 4 à 8 semaines. La durée dépend de la taille de l'entreprise, du nombre de processus analysés et de la complexité du système d'information." }
        },
        {
          "@type": "Question",
          "name": "Quels processus et outils sont analysés lors de l'audit IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous analysons l'ensemble de votre écosystème digital : votre système d'information (CRM, ERP, outils métiers), vos processus opérationnels (ventes, marketing, production, RH, finance), vos flux de données, vos outils de communication et collaboration, et votre infrastructure technique. Chaque processus est évalué selon son potentiel d'automatisation IA, le temps économisable et l'impact sur la qualité et la performance." }
        },
        {
          "@type": "Question",
          "name": "Que contient la feuille de route IA issue de l'audit ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La feuille de route IA comprend : la liste priorisée des cas d'usage IA à fort ROI, l'estimation des gains (temps, coûts, performance) pour chaque cas d'usage, les technologies IA recommandées, le planning d'implémentation par phase, l'estimation budgétaire globale, les prérequis techniques et organisationnels, et les risques à anticiper. Elle vous permet de démarrer immédiatement avec les projets à impact rapide tout en planifiant les chantiers plus complexes." }
      }
    }
  ]
}
</script>
{% endblock %}

