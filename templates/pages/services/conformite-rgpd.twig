{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Mise en conformité RGPD — Audit, DPO &amp; Documentation | Complianz{% endblock %}

{% block description %}Mettez votre entreprise en conformité RGPD : audit des traitements, rôle de DPO externalisé, registres et politique de confidentialité. Accompagnement sur mesure.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Mise en conformité RGPD",
      "url": "{{ app_url }}/audit-conformite/conformite-rgpd",
      "description": "Accompagnement complet à la mise en conformité RGPD pour les PME et ETI : audit des traitements de données, nomination d'un DPO externalisé, création du registre des traitements et rédaction de la politique de confidentialité. Accompagnement sur mesure selon votre secteur.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Mise en conformité RGPD",
      "offers": [
        { "@type": "Offer", "name": "Pack Conformité RGPD Initial",       "price": "2900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4900"  } },
        { "@type": "Offer", "name": "Pack Mise en conformité complète",   "price": "5900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900"  } },
        { "@type": "Offer", "name": "Accompagnement annuel RGPD",         "price": "1200",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2400"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Mise en conformité RGPD",     "item": "{{ app_url }}/audit-conformite/conformite-rgpd" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien de temps pour une mise en conformité RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une mise en conformité RGPD complète prend généralement entre 2 et 4 mois selon la taille de l'entreprise, le nombre de traitements de données et la maturité initiale. Un audit préalable permet d'estimer le plan de charge avec précision." }
        },
        {
          "@type": "Question",
          "name": "La mise en conformité RGPD est-elle obligatoire pour les PME ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, le RGPD s'applique à toute organisation — quelle que soit sa taille — qui traite des données personnelles de résidents européens. Cela inclut les TPE, PME, associations et administrations. Le non-respect expose à des sanctions pouvant atteindre 4% du chiffre d'affaires mondial." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un DPO externalisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le DPO externalisé (Délégué à la Protection des Données) est un expert RGPD mutualisé qui assure le rôle de DPO légal de votre organisation sans les coûts d'un recrutement. Il est nommé auprès de la CNIL, tient votre registre, répond aux demandes d'exercice de droits et assure une veille réglementaire continue." }
        },
        {
          "@type": "Question",
          "name": "Quelles sont les sanctions RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les sanctions RGPD peuvent atteindre 20 millions d'euros ou 4% du chiffre d'affaires mondial annuel (le montant le plus élevé). La CNIL prononce également des mises en demeure, des avertissements et peut ordonner la suspension des traitements. En 2023, la CNIL a prononcé 42 mises en demeure et 42 sanctions." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

