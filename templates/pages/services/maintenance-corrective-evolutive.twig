{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 151 chars description) ─────────────────── #}
{% block title %}Maintenance corrective — bugs & corrections rapides{% endblock %}

{% block description %}Correction rapide de bugs, anomalies et dysfonctionnements sur vos sites, logiciels et serveurs. Diagnostic technique, rétablissement du service et documentation.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Maintenance corrective & évolutive",
      "url": "{{ app_url }}/support-maintenance/maintenance/maintenance-corrective-evolutive",
      "description": "Intervention technique visant à corriger les anomalies, bugs ou dysfonctionnements affectant les outils digitaux (sites, logiciels, serveurs) afin de rétablir un fonctionnement normal et sécurisé.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Maintenance corrective informatique",
      "offers": [
        { "@type": "Offer", "name": "Correction simple",          "price": "150",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "500"  } },
        { "@type": "Offer", "name": "Correction intermédiaire",   "price": "500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1500" } },
        { "@type": "Offer", "name": "Correction complexe",        "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000" } },
        { "@type": "Offer", "name": "Forfait d'heures",           "price": "0",   "priceCurrency": "EUR" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",     "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Maintenance, support & évolutions", "item": "{{ app_url }}/support-maintenance/maintenance" },
        { "@type": "ListItem", "position": 4, "name": "Maintenance corrective & évolutive", "item": "{{ app_url }}/support-maintenance/maintenance/maintenance-corrective-evolutive" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que la maintenance corrective informatique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance corrective informatique désigne l'ensemble des interventions techniques visant à corriger des anomalies, bugs ou dysfonctionnements qui perturbent le fonctionnement normal de vos outils digitaux (site web, application, logiciel, serveur). Elle intervient après détection d'un problème pour rétablir le service le plus rapidement possible." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre maintenance corrective et préventive ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance corrective intervient après qu'un problème a été détecté — c'est du curatif. La maintenance préventive consiste à anticiper les problèmes avant qu'ils surviennent (mises à jour, audits réguliers, surveillance proactive). Idéalement, un contrat de maintenance mensuel combine les deux : correction rapide des problèmes survenant, et prévention des futures interruptions." }
        },
        {
          "@type": "Question",
          "name": "Quels types de bugs et anomalies corrigez-vous ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intervenons sur tous types de dysfonctionnements digitaux : bugs d'affichage (CSS/HTML), erreurs PHP/JavaScript, problèmes de base de données, pannes serveur, bugs de formulaires et d'e-commerce, erreurs après mises à jour WordPress/plugins, problèmes de performance, failles de sécurité, et dysfonctionnements d'applications métier ou de logiciels sur mesure." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte une intervention de maintenance corrective ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 150 € à 500 € pour une correction simple (bug d'affichage, formulaire cassé, erreur JS mineure), de 500 € à 1 500 € pour une correction intermédiaire (bug PHP, problème de base de données, conflit de plugins), et de 1 500 € à 5 000 €+ pour une correction complexe (refonte partielle, sécurité critique, bug de logiciel sur mesure). Un forfait d'heures est disponible pour les besoins récurrents." }
        },
        {
          "@type": "Question",
          "name": "Quel est le délai d'intervention pour une maintenance corrective urgente ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pour les interventions urgentes (site hors ligne, panne critique, faille de sécurité active), nous intervenons sous 2 à 4 heures en journée. Pour les corrections non urgentes, notre délai standard est de 24 à 48 heures selon notre charge. Un forfait d'heures mensuel garantit une priorité d'intervention et un délai d'intervention contractuel." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

