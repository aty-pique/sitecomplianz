{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 152 chars description) ─────────────────── #}
{% block title %}Conseil stratégique dirigeant (tech, digital, orga){% endblock %}

{% block description %}Accompagnement stratégique du dirigeant : prise de décision, roadmap, alignement tech-digital-organisation. Vision claire, décisions structurantes. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Conseil stratégique dirigeant — Tech, Digital & Organisation",
      "url": "{{ app_url }}/audit-conformite/audit-conseil/conseil-strategique",
      "description": "Accompagnement stratégique du dirigeant dans la définition, la structuration et l'optimisation de son entreprise sur les dimensions technologiques, organisationnelles et digitales. Sessions de conseil, aide à la prise de décision, définition de roadmap et accompagnement continu.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Conseil stratégique d'entreprise",
      "offers": [
        { "@type": "Offer", "name": "Session ponctuelle",         "price": "300",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "800",   "unitCode": "HUR" } },
        { "@type": "Offer", "name": "Accompagnement court",       "price": "2000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000"  } },
        { "@type": "Offer", "name": "Accompagnement stratégique", "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000" } },
        { "@type": "Offer", "name": "Suivi mensuel dirigeant",    "price": "1000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000",  "unitCode": "MON" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Audit & Conseil stratégique", "item": "{{ app_url }}/audit-conformite/audit-conseil" },
        { "@type": "ListItem", "position": 4, "name": "Conseil stratégique",         "item": "{{ app_url }}/audit-conformite/audit-conseil/conseil-strategique" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le conseil stratégique pour dirigeant ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le conseil stratégique dirigeant est un accompagnement sur-mesure qui aide le chef d'entreprise à prendre de meilleures décisions sur les dimensions technologiques, organisationnelles et digitales. Le consultant apporte une vision externe, des arbitrages structurants et une aide à la priorisation des actions stratégiques." }
        },
        {
          "@type": "Question",
          "name": "En quoi le conseil stratégique diffère-t-il du coaching de dirigeant ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le coaching de dirigeant travaille sur la posture, les comportements et le développement personnel. Le conseil stratégique apporte une expertise externe sur des sujets business concrets : choix technologiques, feuille de route digitale, structuration organisationnelle, arbitrages d'investissement. Les deux sont complémentaires." }
        },
        {
          "@type": "Question",
          "name": "Comment se déroule une session de conseil stratégique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une session dure entre 1h30 et 3h. Le dirigeant présente son contexte et ses enjeux. Le consultant analyse, questionne et propose des orientations concrètes. Un compte-rendu structuré avec les décisions, les options et les prochaines étapes est remis dans les 48h suivant chaque session." }
        },
        {
          "@type": "Question",
          "name": "Quels sujets peut-on traiter en conseil stratégique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Choix d'outils ou de stack technique, feuille de route digitale, organisation interne, recrutements clés, arbitrages entre croissance et rentabilité, choix d'associés ou de partenaires, stratégie de financement, positionnement marché... Tout sujet structurant pour l'entreprise peut être traité." }
        },
        {
          "@type": "Question",
          "name": "Faut-il un contrat long terme pour bénéficier du conseil stratégique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Non — nous proposons des sessions ponctuelles à partir de 300 € la séance, sans engagement. Un accompagnement court ou mensuel se met en place seulement si le dirigeant souhaite un suivi régulier. Chaque format est adapté à vos besoins du moment." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

