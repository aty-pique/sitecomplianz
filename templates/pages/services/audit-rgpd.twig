{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Audit RGPD | Évaluation conformité données personnelles | Complianz{% endblock %}

{% block description %}Réalisez un audit RGPD complet pour identifier vos risques et points de non-conformité. Rapport détaillé et plan d'actions. Résultats en 3-5 semaines.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit RGPD — Évaluation complète de votre conformité",
      "url": "{{ app_url }}/audit-conformite/conformite-rgpd/audit-rgpd",
      "description": "Audit RGPD complet pour identifier les risques de non-conformité : cartographie des traitements de données personnelles, analyse des risques, gap analysis RGPD, rapport de conformité et plan d'actions priorisé. Résultats livrés en 3 à 5 semaines.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit RGPD",
      "offers": [
        { "@type": "Offer", "name": "Audit RGPD PME",                 "price": "1500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900"  } },
        { "@type": "Offer", "name": "Audit RGPD ETI / Grand compte",  "price": "3500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "7000"  } },
        { "@type": "Offer", "name": "Audit RGPD + Plan d'actions",    "price": "4500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8500"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Conformité RGPD",             "item": "{{ app_url }}/audit-conformite/conformite-rgpd" },
        { "@type": "ListItem", "position": 4, "name": "Audit RGPD",                 "item": "{{ app_url }}/audit-conformite/conformite-rgpd/audit-rgpd" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit RGPD est une évaluation complète et structurée de la conformité d'une organisation au Règlement Général sur la Protection des Données. Il comprend la cartographie des traitements de données personnelles, l'analyse des risques, une gap analysis par rapport aux exigences réglementaires et un plan d'actions priorisé." }
        },
        {
          "@type": "Question",
          "name": "Combien dure un audit RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La durée d'un audit RGPD varie selon la taille de l'organisation et le nombre de traitements. En général, de 2 à 3 semaines pour une PME (moins de 50 salariés) et de 3 à 5 semaines pour une ETI ou une organisation avec des traitements complexes. Le rapport final est livré dans ce délai." }
        },
        {
          "@type": "Question",
          "name": "Qui réalise l'audit RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit RGPD est réalisé par nos consultants spécialisés en protection des données, titulaires de certifications DPO reconnues (CNIL, IAPP CIPM). Ils maîtrisent les exigences du RGPD, les lignes directrices de la CNIL et les bonnes pratiques sectorielles." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un audit RGPD et un DPO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit RGPD est une mission ponctuelle d'évaluation et de diagnostic : il identifie vos non-conformités et vous remet un plan d'actions. Le DPO (Délégué à la Protection des Données) est une fonction continue : il pilote, maintient et fait vivre votre conformité dans la durée. Les deux sont complémentaires." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

