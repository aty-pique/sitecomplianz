{% extends 'layouts/base.twig' %}

{# ── SEO (41 chars titre / 141 chars description) ─────────────────── #}
{% block title %}Application métier sur mesure{% endblock %}

{% block description %}Application métier sur mesure pour automatiser vos processus et booster votre efficacité. Analyse, développement, déploiement itératif et maintenance.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Développement d'application métier sur mesure",
      "url": "{{ app_url }}/solutions-developpement/developpement-logiciel/application-metier",
      "description": "Conception et développement d'applications métier sur mesure, adaptées aux processus spécifiques de l'entreprise pour optimiser son fonctionnement, automatiser ses opérations et améliorer sa performance.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Application métier sur mesure",
      "offers": [
        { "@type": "Offer", "name": "Application simple",              "price": "8000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000"  } },
        { "@type": "Offer", "name": "Application métier structurée",   "price": "20000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "50000"  } },
        { "@type": "Offer", "name": "Application complexe métier spécifique", "price": "50000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "120000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                          "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement",        "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Développement logiciel sur mesure","item": "{{ app_url }}/solutions-developpement/developpement-logiciel" },
        { "@type": "ListItem", "position": 4, "name": "Application métier sur mesure",    "item": "{{ app_url }}/solutions-developpement/developpement-logiciel/application-metier" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une application métier sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une application métier sur mesure est un logiciel conçu spécifiquement pour répondre aux processus et contraintes propres à une entreprise ou un secteur d'activité. Contrairement aux outils génériques, elle est développée pour s'adapter exactement à votre organisation, vos flux de travail et vos besoins terrain." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte le développement d'une application métier ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 8 000 € à 20 000 € pour une application simple (workflow ciblé, quelques fonctionnalités), de 20 000 € à 50 000 € pour une application structurée (multi-modules, automatisations), et de 50 000 € à 120 000 €+ pour une application complexe avec des processus métier spécifiques et des intégrations multiples." }
        },
        {
          "@type": "Question",
          "name": "Quels types d'applications métier peut-on développer ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Toute application répondant à un besoin spécifique non couvert par les outils standard : outil de gestion d'interventions terrain, application de suivi de production, plateforme de gestion documentaire, outil de planification et de ressources, application de reporting personnalisé, interface de gestion de stocks adaptée, tableau de bord opérationnel, etc." }
        },
        {
          "@type": "Question",
          "name": "Peut-on développer une application mobile métier ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — nous développons des applications métier pour tous les environnements : web (accessible depuis un navigateur), mobile (iOS et Android, native ou PWA) et desktop. Beaucoup de nos clients combinent une interface web pour les managers et une application mobile pour les équipes terrain." }
        },
        {
          "@type": "Question",
          "name": "Comment se déroule un projet d'application métier chez Complianz ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le projet se déroule en 4 phases : 1) Cadrage et analyse des besoins (ateliers terrain, cartographie des processus), 2) Conception de l'architecture et des fonctionnalités, 3) Développement itératif avec validations régulières, 4) Tests, déploiement, formation et support post-lancement." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

