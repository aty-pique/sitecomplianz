{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 153 chars description) ─────────────────── #}
{% block title %}Analyse de performance data & KPI | Web analytics{% endblock %}

{% block description %}Transformez vos données en décisions : analyse approfondie de vos KPI, performances par canal, comportement utilisateur et axes d'amélioration. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Analyse de performance & data",
      "url": "{{ app_url }}/performance-digitale/pilotage-commercial/analyse-performance",
      "description": "Analyse approfondie des données de l'entreprise pour comprendre sa performance, identifier les leviers d'amélioration et optimiser les résultats. Transformer les données en informations utiles pour piloter efficacement l'activité.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Web analytics et analyse de performance data",
      "offers": [
        { "@type": "Offer", "name": "Analyse simple",                     "price": "1500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4000"  } },
        { "@type": "Offer", "name": "Analyse structurée",                 "price": "4000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "Analyse avancée / data complète",    "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } },
        { "@type": "Offer", "name": "Accompagnement mensuel",             "price": "800",   "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2500"  } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Pilotage commercial & KPI",        "item": "{{ app_url }}/performance-digitale/pilotage-commercial" },
        { "@type": "ListItem", "position": 4, "name": "Analyse de performance & data",    "item": "{{ app_url }}/performance-digitale/pilotage-commercial/analyse-performance" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que l'analyse de performance data ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'analyse de performance data consiste à collecter, traiter et interpréter les données de votre entreprise (analytics, CRM, ads, email, ventes…) pour comprendre ce qui génère de la performance et ce qui freine votre croissance. L'objectif est de transformer des données brutes en informations actionnables pour prendre des décisions éclairées." }
        },
        {
          "@type": "Question",
          "name": "Pourquoi faire appel à un consultant en web analytics ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un consultant en web analytics vous aide à configurer correctement vos outils de tracking (GA4, CRM, pixels publicitaires…), à extraire les données pertinentes et à les interpréter. Sans expertise analytics, les données peuvent être mal collectées, mal interprétées ou simplement non exploitées — ce qui conduit à des décisions basées sur des intuitions plutôt que sur des faits." }
        },
        {
          "@type": "Question",
          "name": "Quels outils utilisez-vous pour l'analyse de performance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous utilisons les outils adaptés à votre contexte : Google Analytics 4 (GA4), Google Search Console, Looker Studio, SEMrush, Ahrefs, HubSpot, Salesforce, Meta Business Suite, Google Ads, ActiveCampaign, Hotjar, Microsoft Clarity, Power BI, etc. Nous travaillons avec vos outils existants." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte une analyse de performance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 500 € à 4 000 € pour une analyse simple (audit analytics + rapport de performance sur 1-2 canaux), de 4 000 € à 10 000 € pour une analyse structurée multi-canaux, de 10 000 € à 25 000 €+ pour une analyse data complète (tous canaux, segmentation avancée, analyse prédictive), et de 800 € à 2 500 €/mois pour un accompagnement mensuel continu." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre web analytics et analyse de performance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le web analytics désigne spécifiquement l'analyse du comportement des visiteurs sur votre site web (trafic, pages vues, parcours, taux de rebond…). L'analyse de performance est plus large : elle couvre l'ensemble de vos canaux digitaux (SEO, publicité, email, réseaux sociaux, CRM, ventes…) et mesure votre performance commerciale globale en croisant toutes ces sources de données." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

