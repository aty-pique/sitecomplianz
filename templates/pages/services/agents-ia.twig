{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 151 chars description) ─────────────────── #}
{% block title %}Agents IA sur mesure — automatisation & workflows intelligents{% endblock %}

{% block description %}Conception et déploiement d'agents IA qui travaillent pour vous : automatisation des tâches, workflows intelligents, intégration CRM/ERP et support des équipes 24h/24.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Agents IA sur mesure",
      "url": "{{ app_url }}/intelligence-artificielle/agents-ia",
      "description": "Conception et mise en place d'agents intelligents capables d'automatiser des tâches, d'exécuter des processus métier et d'assister les équipes dans leur quotidien. Ces agents sont intégrés aux outils existants de l'entreprise (CRM, ERP, outils métiers) afin de créer des workflows automatisés, intelligents et évolutifs.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création d'agents IA et automatisation intelligente",
      "offers": [
        { "@type": "Offer", "name": "Agent simple",              "price": "1000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } },
        { "@type": "Offer", "name": "Agent intermédiaire",       "price": "3000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "Agent avancé",              "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "30000" } },
        { "@type": "Offer", "name": "Système d'agents complet",  "price": "30000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "100000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                    "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle",  "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Agents IA sur mesure",       "item": "{{ app_url }}/intelligence-artificielle/agents-ia" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un agent IA et comment peut-il aider mon entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un agent IA est un programme autonome capable de percevoir son environnement, de prendre des décisions et d'effectuer des actions pour atteindre un objectif défini. En entreprise, il peut répondre automatiquement aux emails et demandes clients, qualifier des leads et mettre à jour le CRM, générer des rapports, automatiser des workflows complexes, traiter des documents et assister vos équipes dans leurs tâches quotidiennes — 24h/24, sans interruption." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte le développement d'un agent IA sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 000 à 3 000 € pour un agent simple (tâche unique, automatisation basique), de 3 000 à 10 000 € pour un agent intermédiaire (multi-étapes, outils connectés), de 10 000 à 30 000 € pour un agent avancé (logique complexe, multi-systèmes, IA poussée), et de 30 000 à 100 000 €+ pour un système d'agents complet. Une maintenance mensuelle de 300 à 2 000 €/mois est disponible pour l'évolution continue." }
        },
        {
          "@type": "Question",
          "name": "Quels outils et systèmes peut-on connecter à un agent IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous connectons les agents IA à pratiquement tous les outils d'entreprise : CRM (HubSpot, Salesforce, Pipedrive), ERP (Odoo, SAP), outils de communication (Gmail, Slack, Teams), bases de données, plateformes e-commerce (Shopify, WooCommerce), outils de facturation, calendriers, et tout outil disposant d'une API. La connexion peut être réalisée en no-code (n8n, Make, Zapier) ou via développement custom selon la complexité." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un chatbot et un agent IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un chatbot classique suit un arbre de décision prédéfini et répond à des questions selon des règles fixes. Un agent IA est beaucoup plus puissant : il comprend le langage naturel, raisonne de façon autonome, peut utiliser plusieurs outils en parallèle, prendre des décisions contextuelles et effectuer des actions complexes (mettre à jour une BDD, envoyer un email, créer une tâche, etc.). Un agent IA s'adapte à des situations non prévues, un chatbot non." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour développer et déployer un agent IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un agent simple peut être développé et déployé en 1 à 2 semaines. Un agent intermédiaire nécessite généralement 3 à 6 semaines. Un agent avancé ou un système d'agents complet peut prendre 2 à 6 mois selon la complexité. Nous démarrons toujours par une analyse des processus (2 à 5 jours) avant de démarrer le développement, pour s'assurer que la solution correspond parfaitement à vos besoins." }
      }
    }
  ]
}
</script>
{% endblock %}

