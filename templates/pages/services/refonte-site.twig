{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Refonte site web | Modernisation & performance | Complianz{% endblock %}

{% block description %}Refondez votre site web pour améliorer votre image, vos conversions et votre SEO. Audit de l'existant, nouveau design, migration sans perte de positionnement.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Refonte de site web — Modernisation & performance",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web/refonte-site",
      "description": "Audit de l'existant (UX, performance, SEO), nouveau design responsive, migration du contenu, redirections 301 SEO et tests de performance pour moderniser votre présence en ligne sans perdre votre positionnement.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Refonte de site web",
      "offers": [
        { "@type": "Offer", "name": "Refonte Express (5 pages)",  "price": "2500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4500"  } },
        { "@type": "Offer", "name": "Refonte Complète (15 pages)","price": "4500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9500"  } },
        { "@type": "Offer", "name": "Refonte + SEO",              "price": "7500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" },
        { "@type": "ListItem", "position": 4, "name": "Refonte de site web",       "item": "{{ app_url }}/solutions-developpement/creation-site-web/refonte-site" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quand faut-il refondre son site web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Il est temps de refondre votre site si votre taux de rebond est élevé (>70%), si votre site n'est pas responsive mobile, si votre positionnement SEO stagne ou régresse, si votre design date de plus de 3-4 ans, ou si votre site est difficile à mettre à jour. Un audit gratuit permet de faire le diagnostic." }
        },
        {
          "@type": "Question",
          "name": "Va-t-on perdre notre positionnement SEO lors de la refonte ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Non — si la refonte est bien préparée. Nous réalisons un audit SEO complet avant la refonte, cartographions toutes les URLs existantes, configurons les redirections 301, et vérifions le bon transfert du positionnement via Google Search Console après la mise en ligne. Une refonte bien réalisée améliore souvent le SEO." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps prend une refonte de site web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 4 à 8 semaines pour une refonte Express (5 pages), de 8 à 14 semaines pour une refonte Complète (15 pages), et de 12 à 20 semaines pour une refonte avec stratégie SEO complète. Le délai inclut l'audit initial, le design, le développement et les tests." }
        },
        {
          "@type": "Question",
          "name": "Le contenu existant est-il migré lors de la refonte ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — la migration du contenu existant (textes, images, médias) est incluse dans notre périmètre. Nous récupérons, optimisons et intégrons votre contenu dans la nouvelle structure. Si certains contenus nécessitent une réécriture pour le SEO, notre équipe peut vous proposer une prestation de rédaction dédiée." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

