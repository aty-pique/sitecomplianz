{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 151 chars description) ─────────────────── #}
{% block title %}Formation agents IA — créer & déployer des agents intelligents{% endblock %}

{% block description %}Formation pratique pour concevoir et déployer des agents IA dans votre entreprise : cas concrets, no-code & API, automatisation des tâches et optimisation des processus métier.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Course",
      "name": "Formation sur la composition d'agents IA",
      "url": "{{ app_url }}/intelligence-artificielle/formation-ia/formation-agents-ia",
      "description": "Formation pratique permettant de comprendre, concevoir et déployer des agents intelligents capables d'automatiser des tâches, d'assister les équipes et d'optimiser les processus métier. L'objectif est de rendre les équipes autonomes dans l'utilisation et la création d'agents IA adaptés à leurs besoins.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "educationalLevel": "Débutant à avancé",
      "teaches": "Concevoir et déployer des agents IA pour automatiser les processus d'entreprise",
      "availableLanguage": "fr",
      "offers": [
        { "@type": "Offer", "name": "Formation courte (initiation/découverte)", "price": "500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1500" } },
        { "@type": "Offer", "name": "Formation complète (1 à 3 jours)",         "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000" } },
        { "@type": "Offer", "name": "Formation avancée + cas pratiques",         "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000" } },
        { "@type": "Offer", "name": "Formation + accompagnement",                "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle",         "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Formation IA",                      "item": "{{ app_url }}/intelligence-artificielle/formation-ia" },
        { "@type": "ListItem", "position": 4, "name": "Formation composition d'agents IA", "item": "{{ app_url }}/intelligence-artificielle/formation-ia/formation-agents-ia" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "À qui s'adresse la formation sur les agents IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La formation s'adresse à tous les profils d'entreprise : dirigeants et managers souhaitant comprendre les enjeux et le potentiel des agents IA, équipes opérationnelles (marketing, commercial, RH, support) voulant créer leurs propres automatisations, et profils techniques (développeurs, chefs de projet) souhaitant aller plus loin avec les API et le développement d'agents avancés. Des parcours adaptés à chaque niveau sont disponibles." }
        },
        {
          "@type": "Question",
          "name": "Faut-il savoir coder pour créer des agents IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Non, pas nécessairement. Nous proposons des formations orientées no-code (n8n, Make, outils IA visuels) accessibles sans compétences techniques, ainsi que des formations avancées avec API pour les profils techniques. L'approche no-code permet déjà de créer des agents puissants capables d'automatiser de nombreux processus métier sans une seule ligne de code." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un agent IA et comment peut-il aider mon entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un agent IA est un programme autonome capable de percevoir son environnement, de prendre des décisions et d'effectuer des actions pour atteindre un objectif défini. En entreprise, les agents IA peuvent : répondre automatiquement aux emails et demandes clients, qualifier des leads et mettre à jour le CRM, générer des rapports, automatiser des workflows complexes, et assister les équipes dans leurs tâches quotidiennes 24h/24." }
        },
        {
          "@type": "Question",
          "name": "La formation peut-elle être adaptée à mon secteur d'activité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, c'est l'un de nos points forts. Chaque formation est personnalisée selon votre secteur d'activité et vos cas d'usage réels. Les exercices pratiques utilisent des exemples tirés de votre métier — vente, marketing, RH, support, comptabilité, etc. — pour que les participants puissent immédiatement appliquer ce qu'ils ont appris dans leur quotidien professionnel." }
        },
        {
          "@type": "Question",
          "name": "La formation est-elle éligible CPF ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Certaines de nos formations IA sont éligibles au financement CPF (Compte Personnel de Formation). Consultez notre page de formations IA éligibles CPF pour vérifier les conditions d'éligibilité ou contactez-nous pour un accompagnement dans la démarche de financement. D'autres financements sont également possibles (OPCO, Pôle Emploi, plan de formation entreprise)." }
      }
    }
  ]
}
</script>
{% endblock %}

