{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 153 chars description) ─────────────────── #}
{% block title %}Support technique externalisé — assistance utilisateurs{% endblock %}

{% block description %}Assistance technique quotidienne pour vos équipes : réponse aux questions, résolution de problèmes, aide à l'utilisation de vos outils digitaux. Support ponctuel ou mensuel.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Support technique externalisé",
      "url": "{{ app_url }}/support-maintenance/maintenance/support-technique",
      "description": "Assistance technique permettant de répondre aux problématiques du quotidien, accompagner les utilisateurs et résoudre les difficultés liées à l'utilisation des outils digitaux. Support ponctuel, pack mensuel ou support avancé.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Support informatique entreprise externalisé",
      "offers": [
        { "@type": "Offer", "name": "Support ponctuel",  "price": "100",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "300" } },
        { "@type": "Offer", "name": "Pack support",      "price": "300",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1000" } },
        { "@type": "Offer", "name": "Support avancé",    "price": "1000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                         "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",           "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Maintenance, support & évolutions", "item": "{{ app_url }}/support-maintenance/maintenance" },
        { "@type": "ListItem", "position": 4, "name": "Support technique externalisé",   "item": "{{ app_url }}/support-maintenance/maintenance/support-technique" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le support technique externalisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le support technique externalisé est un service d'assistance informatique fourni par une équipe externe à votre entreprise. Il permet à vos collaborateurs de joindre un expert technique pour répondre à leurs questions, débloquer des problèmes d'utilisation d'outils digitaux et résoudre des incidents courants — sans mobiliser vos ressources internes." }
        },
        {
          "@type": "Question",
          "name": "Quels types de demandes le support technique peut-il traiter ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le support technique traite les questions d'utilisation d'outils (CRM, ERP, site web, applications métier), les problèmes de connexion et d'accès, les erreurs logicielles courantes, l'aide à la prise en main de nouveaux outils, les incidents simples comme la perte de données ou les problèmes d'envoi d'email, et tout problème qui bloque un utilisateur dans son quotidien." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre support technique et maintenance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le support technique s'adresse aux utilisateurs pour les aider à utiliser les outils au quotidien (questions, blocages, incidents simples). La maintenance s'adresse aux outils eux-mêmes pour corriger des bugs, assurer leur stabilité et les faire évoluer. Les deux sont complémentaires : le support détecte souvent des problèmes qui nécessitent ensuite une intervention de maintenance." }
        },
        {
          "@type": "Question",
          "name": "Sous quel délai intervenez-vous en support ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le délai d'intervention dépend du niveau de support contractualisé. En support avancé, la réponse est garantie sous 1h pour les urgences. En pack mensuel, le délai standard est de 4h ouvrées. Le support ponctuel est traité selon notre disponibilité, généralement sous 24h." }
        },
        {
          "@type": "Question",
          "name": "Le support technique se fait-il à distance ou sur site ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le support technique est principalement réalisé à distance — par téléphone, email, chat ou prise en main à distance via des outils sécurisés. Pour les situations qui le nécessitent, une intervention sur site peut être organisée. Le mode de support (mail, visio, téléphone, ticketing) est défini avec vous lors du paramétrage du service." }
      }
    }
  ]
}
</script>
{% endblock %}

