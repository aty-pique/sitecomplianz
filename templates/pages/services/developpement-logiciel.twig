{% extends 'layouts/base.twig' %}

{# ── SEO (46 chars titre / 145 chars description) ─────────────────── #}
{% block title %}Développement logiciel sur mesure{% endblock %}

{% block description %}Concevez votre logiciel sur mesure : application métier, SaaS, automatisation et API. Développement adapté à votre organisation et vos enjeux métier. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Développement de logiciel sur mesure",
      "url": "{{ app_url }}/solutions-developpement/developpement-logiciel",
      "description": "Conception et développement de logiciels sur mesure entièrement adaptés aux besoins métier de l'entreprise : application métier, SaaS, automatisation, API. Méthodologie itérative, architecture robuste, intégration aux outils existants et maintenance.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Développement logiciel sur mesure",
      "offers": [
        { "@type": "Offer", "name": "Projet simple",      "price": "8000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000"  } },
        { "@type": "Offer", "name": "Projet structuré",   "price": "20000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "50000"  } },
        { "@type": "Offer", "name": "Projet complexe",    "price": "50000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "150000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Développement logiciel sur mesure", "item": "{{ app_url }}/solutions-developpement/developpement-logiciel" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi développer un logiciel sur mesure plutôt que d'acheter un logiciel standard ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un logiciel sur mesure est conçu pour s'adapter exactement à votre organisation, vos processus et vos enjeux métier — sans les compromis d'un outil générique. Il vous évite d'adapter votre entreprise à un logiciel standard, réduit les coûts de licence sur le long terme et crée un avantage concurrentiel difficile à répliquer." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte le développement d'un logiciel sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 8 000 € à 20 000 € pour un projet simple (peu de fonctionnalités, périmètre limité), de 20 000 € à 50 000 € pour un projet structuré (application métier complète), et de 50 000 € à 150 000 €+ pour un projet complexe (SaaS, multi-modules, intégrations multiples). Une maintenance mensuelle est possible." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour développer un logiciel sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 2 à 4 mois pour un projet simple, de 4 à 9 mois pour un projet structuré, et de 9 à 18 mois pour un projet complexe. Nous utilisons une méthodologie itérative qui permet de livrer des versions fonctionnelles progressivement, avec validation à chaque étape." }
        },
        {
          "@type": "Question",
          "name": "Quelles technologies utilisez-vous pour le développement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nos équipes maîtrisent un large éventail de technologies modernes : PHP, Python, JavaScript (React, Vue, Node.js), bases de données SQL et NoSQL, API REST/GraphQL, déploiement cloud (AWS, GCP, Azure). Le choix technologique est toujours guidé par les besoins métier, pas par des préférences d'outils." }
        },
        {
          "@type": "Question",
          "name": "Que se passe-t-il après la mise en production du logiciel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous proposons un accompagnement post-lancement : formation des utilisateurs, support au démarrage, contrat de maintenance et d'évolution. Le logiciel peut évoluer avec votre entreprise — nouvelles fonctionnalités, intégrations supplémentaires, montée en charge." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

