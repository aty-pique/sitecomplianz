      "publisher": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "inLanguage": "fr"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle", "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Impact IA", "item": "{{ app_url }}/intelligence-artificielle/impact-ia" },
        { "@type": "ListItem", "position": 4, "name": "Impact de l'IA sur l'emploi", "item": "{{ app_url }}/intelligence-artificielle/impact-ia/impact-de-l-ia-sur-l-emploi" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "L'IA va-t-elle remplacer les emplois ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'IA transforme les emplois plus qu'elle ne les supprime — du moins à court terme. Les études montrent que 60 à 70% des emplois actuels seront significativement modifiés par l'IA, mais la suppression nette reste limitée. Historiquement, chaque révolution technologique a créé plus d'emplois qu'elle n'en a détruits — mais avec des transitions difficiles pour les professions exposées. Les emplois les plus à risque sont ceux basés sur des tâches répétitives et standardisées. Les emplois nécessitant créativité, empathie, jugement complexe et relations humaines sont beaucoup moins exposés." }
        },
        {
          "@type": "Question",
          "name": "Quels métiers sont les plus impactés par l'IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les métiers les plus transformés par l'IA sont : saisie de données et traitement administratif (IA automatise 80-90% des tâches), service client de niveau 1 (chatbots traitent les requêtes simples), rédaction standard et traduction (outils IA génèrent des premiers jets), analyse financière de routine, développement logiciel basique (Copilot accélère les tâches répétitives). Les métiers les moins exposés : soins médicaux, travail social, arts créatifs, management d'équipes, conseil stratégique, artisanat complexe." }
        },
        {
          "@type": "Question",
          "name": "Quelles compétences développer pour rester employable avec l'IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les compétences les plus valorisées à l'ère de l'IA sont : la maîtrise des outils IA (prompt engineering, utilisation des LLMs), la pensée critique et le jugement (valider les outputs de l'IA), la créativité et l'innovation, l'intelligence émotionnelle et relationnelle, la capacité d'adaptation et d'apprentissage continu, et les compétences techniques hybrides (comprendre l'IA sans être data scientist). La compétence la plus universelle : apprendre à travailler avec l'IA, pas contre elle." }
        },
        {
          "@type": "Question",
          "name": "Comment les entreprises doivent-elles gérer la transition IA pour leurs équipes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La transition IA réussie pour les équipes repose sur : communication transparente sur les changements attendus, formation proactive aux outils IA avant leur déploiement, redéfinition des fiches de poste pour intégrer les nouvelles tâches, accompagnement des reconversions pour les postes les plus exposés, association des équipes à la conception des nouveaux processus IA, et mesure et partage des gains de productivité. Les entreprises qui gèrent bien la transition IA obtiennent de meilleurs résultats que celles qui l'imposent sans préparation." }
        }
      ]
    }
  ]
}
</script>
