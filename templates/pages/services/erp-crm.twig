{% extends 'layouts/base.twig' %}

{# ── SEO (41 chars titre / 133 chars description) ─────────────────── #}
{% block title %}Création ERP & CRM sur mesure{% endblock %}

{% block description %}Créez votre ERP ou CRM sur mesure pour centraliser vos données, automatiser vos processus et piloter votre activité. Devis gratuit, cadrage offert.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création ERP & CRM sur mesure",
      "url": "{{ app_url }}/solutions-developpement/erp-crm",
      "description": "Conception et mise en place d'un ERP ou d'un CRM sur mesure ou semi-sur-mesure pour centraliser les données, structurer les processus et piloter l'activité de l'entreprise.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "ERP CRM sur mesure",
      "offers": [
        { "@type": "Offer", "name": "CRM simple",            "price": "5000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000"  } },
        { "@type": "Offer", "name": "ERP / CRM structuré",   "price": "15000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "40000"  } },
        { "@type": "Offer", "name": "ERP complet multi-process", "price": "40000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "100000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création ERP & CRM sur mesure", "item": "{{ app_url }}/solutions-developpement/erp-crm" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un ERP et un CRM ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un CRM (Customer Relationship Management) gère la relation client : prospects, opportunités, devis, suivi commercial. Un ERP (Enterprise Resource Planning) couvre l'ensemble des processus de l'entreprise : ventes, achats, production, RH, finance, stocks. Les deux sont complémentaires et peuvent être développés sur mesure ou intégrés dans un outil hybride." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte la création d'un ERP ou d'un CRM sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 5 000 € à 15 000 € pour un CRM simple (suivi prospects, pipeline commercial), de 15 000 € à 40 000 € pour un ERP/CRM structuré (multi-modules, automatisations), et de 40 000 € à 100 000 €+ pour un ERP complet multi-process. Un abonnement SaaS ou maintenance mensuelle est possible." }
        },
        {
          "@type": "Question",
          "name": "Vaut-il mieux développer un CRM/ERP sur mesure ou utiliser un outil existant comme Odoo ou Salesforce ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un outil existant (Odoo, Salesforce, HubSpot) est souvent adapté pour des besoins standards. Pour des processus métier spécifiques, une organisation atypique ou des contraintes d'intégration fortes, le développement sur mesure offre plus de flexibilité et d'adaptation. Nous proposons également l'intégration et le paramétrage d'Odoo pour répondre aux deux besoins." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour mettre en place un ERP ou CRM sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 à 3 mois pour un CRM simple, de 3 à 6 mois pour un ERP/CRM structuré, et de 6 à 12 mois pour un ERP complet. Nous travaillons en méthodologie itérative pour livrer des versions fonctionnelles progressivement, avec validation à chaque étape." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer un ERP ou CRM sur mesure avec nos outils existants ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'intégration avec vos outils existants (comptabilité, e-commerce, logistique, messagerie, téléphonie…) est au cœur de notre approche. Nous développons les connecteurs et API nécessaires pour créer un écosystème cohérent autour de votre ERP ou CRM." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

