{% extends 'layouts/base.twig' %}

{# ── SEO ──────────────────────────────────────────────────────────── #}
{% block title %}Formation IA entreprise | Formation intelligence artificielle | Complianz{% endblock %}

{% block description %}Formez vos équipes à l'intelligence artificielle : outils IA, prompt engineering, automatisation et IA générative. Formations éligibles CPF et intra-entreprise.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Formation IA pour entreprises",
      "url": "{{ app_url }}/intelligence-artificielle/formation-ia",
      "description": "Formations IA pour entreprises : outils IA, prompt engineering, IA générative, automatisation. Formations intra-entreprise, éligibles CPF, adaptées à tous les niveaux.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Formation IA et intelligence artificielle",
      "offers": [
        { "@type": "Offer", "name": "Formation initiation IA (1 jour)", "price": "690", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1200" } },
        { "@type": "Offer", "name": "Formation avancée IA (3 jours)", "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3200" } },
        { "@type": "Offer", "name": "Programme sur mesure intra-entreprise", "price": "0", "priceCurrency": "EUR", "description": "Sur devis selon besoins" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle", "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Formation IA", "item": "{{ app_url }}/intelligence-artificielle/formation-ia" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Les formations IA sont-elles éligibles CPF ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Certaines de nos formations IA sont éligibles au Compte Personnel de Formation (CPF) via des certifications reconnues. Nos formations certifiantes permettent de financer tout ou partie de la formation sans avancer de frais. Contactez-nous pour vérifier l'éligibilité CPF de la formation qui vous intéresse et vous accompagner dans la procédure de financement." }
        },
        {
          "@type": "Question",
          "name": "Pour quel niveau sont adaptées les formations IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nos formations sont disponibles pour tous les niveaux : débutants complets (aucune connaissance technique requise), utilisateurs intermédiaires souhaitant approfondir leurs usages IA, et profils avancés voulant maîtriser le prompt engineering, l'automatisation ou le développement IA. Chaque formation est adaptée au public et au niveau déclaré lors du questionnaire préalable." }
        },
        {
          "@type": "Question",
          "name": "Quels outils IA sont abordés dans les formations ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Selon la formation choisie, nous abordons : ChatGPT, Claude, Gemini et les LLMs pour l'IA générative ; Midjourney, DALL-E pour l'IA image ; n8n, Make et Zapier pour l'automatisation ; Perplexity, Notion AI, Copilot pour la productivité ; des outils sectoriels pour le marketing, le SEO, la comptabilité et les RH. Les formations sont mises à jour régulièrement pour intégrer les derniers outils." }
        },
        {
          "@type": "Question",
          "name": "Les formations sont-elles disponibles en présentiel ou à distance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nos formations sont disponibles en présentiel (dans vos locaux ou dans nos espaces de formation) et en distanciel (visioconférence interactive avec exercices pratiques). Pour les formations intra-entreprise, le présentiel est recommandé pour favoriser la dynamique de groupe. Les formations individuelles sont disponibles à distance. Nous proposons également des formats hybrides." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

