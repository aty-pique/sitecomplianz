{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Création site e-commerce | Boutique en ligne sur mesure | Complianz{% endblock %}

{% block description %}Créez une boutique e-commerce performante et sécurisée. WooCommerce, PrestaShop ou solution sur mesure. Catalogue, paiement, livraison. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création de boutique e-commerce",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web/site-ecommerce",
      "description": "Conception et développement de boutiques e-commerce performantes et sécurisées : WooCommerce, PrestaShop ou développement sur mesure. Catalogue, paiement sécurisé, gestion des commandes et SEO e-commerce.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création site e-commerce",
      "offers": [
        { "@type": "Offer", "name": "Boutique Starter (50 produits)",    "price": "3900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6900"  } },
        { "@type": "Offer", "name": "Boutique Standard (500 produits)",  "price": "6900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "14000" } },
        { "@type": "Offer", "name": "Boutique Premium (1000+ produits)", "price": "14000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "28000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" },
        { "@type": "ListItem", "position": 4, "name": "Site e-commerce",           "item": "{{ app_url }}/solutions-developpement/creation-site-web/site-ecommerce" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle plateforme e-commerce choisir ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix dépend de votre catalogue et de vos besoins. WooCommerce (WordPress) est idéal pour les boutiques de petite à moyenne taille avec un besoin de gestion de contenu. PrestaShop convient aux catalogues plus importants avec de nombreuses fonctionnalités natives. Le développement sur mesure est recommandé pour des flux complexes ou une intégration poussée avec votre ERP/CRM. Nous vous conseillons la meilleure option lors du cadrage gratuit." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour lancer une boutique e-commerce ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 6 à 10 semaines pour une boutique Starter (50 produits), de 10 à 16 semaines pour une boutique Standard (500 produits), et de 4 à 6 mois pour une boutique Premium (1 000+ produits). Le délai dépend du nombre de produits, des fonctionnalités et de la disponibilité des contenus." }
        },
        {
          "@type": "Question",
          "name": "Comment gérer les paiements en ligne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous intégrons les solutions de paiement les plus sûres et les plus répandues : Stripe, PayPal, Alma (paiement en plusieurs fois), virement bancaire, etc. Chaque solution est configurée avec les standards de sécurité (HTTPS, 3DS2) pour protéger vos clients et vous conformer aux exigences RGPD et PCI DSS." }
        },
        {
          "@type": "Question",
          "name": "La formation à l'administration de la boutique est-elle incluse ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — une session de formation à l'administration de votre boutique est incluse dans tous nos forfaits. Vous apprendrez à gérer les produits, les commandes, les stocks et les clients. Une documentation complète est également remise à la livraison." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

