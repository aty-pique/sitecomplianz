{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Label & certification RSE | Engagement responsable certifié | Complianz{% endblock %}

{% block description %}Obtenez un label RSE reconnu (Lucie 26000, Ecovadis, B Corp…) pour valoriser vos engagements. Accompagnement complet du diagnostic à la certification.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Label & certification RSE — Valorisez vos engagements responsables",
      "url": "{{ app_url }}/audit-conformite/rse/label-certification-rse",
      "description": "Accompagnement complet pour l'obtention d'un label RSE reconnu (LUCIE 26000, EcoVadis, B Corp, Engagé RSE AFNOR). Du diagnostic initial à l'obtention du label, nous vous guidons à chaque étape de la certification.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Certification et label RSE",
      "offers": [
        { "@type": "Offer", "name": "Accompagnement Label LUCIE 26000",  "price": "4500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8500"  } },
        { "@type": "Offer", "name": "Accompagnement EcoVadis",           "price": "3500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500"  } },
        { "@type": "Offer", "name": "Pack Label RSE complet",            "price": "7000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "13000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Accompagnement RSE",          "item": "{{ app_url }}/audit-conformite/rse" },
        { "@type": "ListItem", "position": 4, "name": "Label & certification RSE",   "item": "{{ app_url }}/audit-conformite/rse/label-certification-rse" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quels sont les principaux labels RSE en France ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les principaux labels RSE reconnus en France sont : LUCIE 26000 (référence française basée sur la norme ISO 26000, reconnu par l'ADEME), EcoVadis (évaluation en ligne utilisée par les grands donneurs d'ordre), B Corp (label international pour les entreprises à mission), Engagé RSE de l'AFNOR (4 niveaux progressifs), et Label Responsable+. Chaque label a ses spécificités en termes de périmètre, de coût et de reconnaissance sectorielle." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour obtenir une certification RSE ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le délai dépend du label visé et du niveau de maturité RSE de l'entreprise. Pour Engagé RSE AFNOR (niveau 1-2) : 3 à 6 mois. Pour LUCIE 26000 : 12 à 18 mois avec une démarche RSE existante. Pour EcoVadis : 2 à 4 mois pour le questionnaire + délai d'évaluation. Pour B Corp : 12 à 24 mois. Nous évaluons dès le diagnostic le chemin le plus court vers le label cible." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un label RSE et une norme ISO 26000 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'ISO 26000 est un référentiel de lignes directrices — elle n'est pas certifiable et ne donne pas lieu à un label officiel. Elle sert de base à plusieurs labels comme LUCIE 26000. Un label RSE, lui, est une certification tierce qui atteste formellement de votre niveau d'engagement RSE selon un référentiel défini, après évaluation par un organisme indépendant. C'est le label qui a une valeur de communication externe et de différenciation commerciale." }
        },
        {
          "@type": "Question",
          "name": "Quel label RSE choisir pour son entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix du label dépend de votre secteur, de vos objectifs et de vos parties prenantes. EcoVadis est indispensable si vos clients grand compte l'exigent dans leurs appels d'offres. LUCIE 26000 est la référence française pour les PME souhaitant une démarche complète et un label reconnu institutionnellement. B Corp est idéal pour les entreprises à fort impact positif souhaitant une notoriété internationale. Engagé RSE est accessible pour les entreprises débutantes. Nous vous guidons dans le choix optimal." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

