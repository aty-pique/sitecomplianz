{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Infogérance complète | Externalisation DSI & IT | Complianz{% endblock %}

{% block description %}Externalisez l'intégralité de votre DSI avec notre service d'infogérance complète. Gestion serveurs, réseau, postes de travail, sécurité et support utilisateurs.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Infogérance complète — Externalisation DSI",
      "url": "{{ app_url }}/support-maintenance/infogerance/infogerance-complete",
      "description": "Externalisation complète de la DSI : gestion et supervision des serveurs 24/7, administration réseau et sécurité, support utilisateurs helpdesk, gestion des sauvegardes et PRA, mises à jour et patching.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Infogérance et externalisation DSI",
      "offers": [
        { "@type": "Offer", "name": "Infogérance PME (≤20 postes)",       "price": "890",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Infogérance Standard (20-50 postes)", "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500" } },
        { "@type": "Offer", "name": "Infogérance Enterprise (50+ postes)", "price": "3500", "priceCurrency": "EUR" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",              "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance","item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Infogérance",          "item": "{{ app_url }}/support-maintenance/infogerance" },
        { "@type": "ListItem", "position": 4, "name": "Infogérance complète", "item": "{{ app_url }}/support-maintenance/infogerance/infogerance-complete" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que l'infogérance complète ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'infogérance complète désigne l'externalisation totale de la gestion de votre système d'information : serveurs, réseau, postes de travail, sécurité, sauvegardes et support utilisateurs. Vous déléguez l'ensemble des responsabilités IT à un prestataire spécialisé, qui devient votre DSI externalisé. Cela vous permet de vous concentrer sur votre cœur de métier sans gérer les problématiques techniques." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre infogérance partielle et complète ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'infogérance partielle couvre un périmètre défini : uniquement les serveurs, ou uniquement le support utilisateurs. L'infogérance complète prend en charge l'ensemble du SI — infrastructure, réseau, sécurité, postes de travail et helpdesk. C'est une délégation totale qui convient aux entreprises sans DSI interne ou qui souhaitent réduire leurs coûts IT tout en améliorant la qualité de service." }
        },
        {
          "@type": "Question",
          "name": "Quels sont les avantages de l'infogérance par rapport à une DSI interne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'infogérance offre plusieurs avantages : coût maîtrisé (forfait mensuel vs charges d'un DSI), expertise multi-technologies (une équipe plutôt qu'un seul profil), disponibilité élargie (astreintes 24/7), mises à jour continues des compétences et technologies, et absence de risque RH. Pour les PME, l'infogérance offre un niveau de service équivalent à une grande DSI à une fraction du coût." }
        },
        {
          "@type": "Question",
          "name": "Comment se passe la transition vers l'infogérance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La transition débute par un audit complet de votre infrastructure existante (inventaire matériel, logiciel, réseau). Nous définissons ensuite le périmètre d'intervention, les SLAs (niveaux de service) et les procédures. Une phase de transition de 2 à 4 semaines permet la prise en main progressive. Nous assurons la continuité de service tout au long du processus — zéro interruption garantie." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

