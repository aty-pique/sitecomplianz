{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 143 chars description) ─────────────────── #}
{% block title %}Politique de confidentialité RGPD | Rédaction conforme | Complianz{% endblock %}

{% block description %}Rédigez une politique de confidentialité RGPD conforme et adaptée à votre activité. Mentions légales, cookies, droits des utilisateurs. Livrée en 5 jours.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Politique de confidentialité RGPD — Rédaction sur mesure",
      "url": "{{ app_url }}/audit-conformite/conformite-rgpd/politique-confidentialite",
      "description": "Rédaction sur mesure de votre politique de confidentialité RGPD adaptée à votre activité : politique de confidentialité complète, mentions légales mises à jour, politique cookies conforme au RGPD (CCM), modèle de consentement et page exercer mes droits. Livrée en 5 jours ouvrés.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Rédaction politique de confidentialité RGPD",
      "offers": [
        { "@type": "Offer", "name": "Documentation RGPD",            "price": "800",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1500" } },
        { "@type": "Offer", "name": "Documentation + Cookie Banner", "price": "1200", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2200" } },
        { "@type": "Offer", "name": "Pack Documentation complet",    "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3200" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                          "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",      "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Conformité RGPD",                  "item": "{{ app_url }}/audit-conformite/conformite-rgpd" },
        { "@type": "ListItem", "position": 4, "name": "Politique de confidentialité",     "item": "{{ app_url }}/audit-conformite/conformite-rgpd/politique-confidentialite" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "La politique de confidentialité est-elle obligatoire ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, les articles 13 et 14 du RGPD imposent d'informer les personnes concernées sur les traitements de leurs données. La politique de confidentialité est le principal vecteur de cette information. Son absence ou son caractère incomplet peut faire l'objet d'une mise en demeure de la CNIL." }
        },
        {
          "@type": "Question",
          "name": "Que doit contenir une politique de confidentialité RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une politique de confidentialité RGPD doit indiquer : l'identité du responsable de traitement, les finalités et bases légales des traitements, les données collectées et leur durée de conservation, les destinataires des données, les éventuels transferts hors UE, les droits des personnes (accès, rectification, effacement…) et les coordonnées du DPO." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre politique de confidentialité et mentions légales ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les mentions légales sont requises par la loi pour l'économie numérique (LCEN) et identifient l'éditeur du site. La politique de confidentialité est requise par le RGPD et informe sur le traitement des données personnelles. Les deux documents sont distincts mais souvent publiés ensemble sur un site web." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour rédiger une politique de confidentialité sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nos politiques de confidentialité personnalisées sont livrées en 5 jours ouvrés après réception de vos informations. Un questionnaire de collecte vous est envoyé au démarrage pour recueillir les informations nécessaires à la personnalisation des documents." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

