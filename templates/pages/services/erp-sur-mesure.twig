{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 148 chars description) ─────────────────── #}
{% block title %}ERP sur mesure | Développement ERP entreprise | Complianz{% endblock %}

{% block description %}Développez un ERP sur mesure pour centraliser comptabilité, RH, production et commercial. Adapté à vos processus, évolutif et sécurisé.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "ERP sur mesure — Centralisez vos processus métiers",
      "url": "{{ app_url }}/solutions-developpement/erp-crm/erp-sur-mesure",
      "description": "Développement modulaire d'un ERP sur mesure : audit des processus métiers, conception fonctionnelle, modules compta, RH, production, stock, commercial, tests, formation et support.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "ERP sur mesure",
      "offers": [
        { "@type": "Offer", "name": "ERP PME (3 modules)",           "price": "14000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "28000" } },
        { "@type": "Offer", "name": "ERP ETI (5+ modules)",          "price": "28000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "65000" } },
        { "@type": "Offer", "name": "ERP sur mesure complet",        "price": "65000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "200000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "ERP & CRM",                 "item": "{{ app_url }}/solutions-developpement/erp-crm" },
        { "@type": "ListItem", "position": 4, "name": "ERP sur mesure",            "item": "{{ app_url }}/solutions-developpement/erp-crm/erp-sur-mesure" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle différence entre un ERP sur mesure et un ERP standard comme SAP ou Odoo ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un ERP standard comme SAP ou Odoo couvre des besoins génériques et impose souvent de faire évoluer vos processus pour s'adapter à l'outil. Un ERP sur mesure est développé selon vos processus exacts — aucun compromis, aucune fonctionnalité inutile. C'est préférable pour les organisations avec des processus atypiques, des contraintes sectorielles fortes ou des intégrations complexes. Nous proposons également l'intégration Odoo si un ERP semi-standard est adapté." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour déployer un ERP sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 4 à 8 mois pour un ERP PME (3 modules), de 8 à 15 mois pour un ERP ETI (5+ modules), et de 12 à 24 mois pour un ERP complet multi-entités. Nous travaillons en méthodologie itérative pour livrer module par module, ce qui permet une adoption progressive et des ajustements en cours de développement." }
        },
        {
          "@type": "Question",
          "name": "Comment migrer nos données existantes vers le nouvel ERP ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La migration de vos données est une étape clé du déploiement ERP. Nous réalisons un audit et un nettoyage de vos données sources (Excel, ancien ERP, fichiers divers), définissons le schéma de migration et réalisons les imports en plusieurs phases avec validation à chaque étape. Aucune donnée n'est perdue lors de la transition." }
        },
        {
          "@type": "Question",
          "name": "L'ERP sur mesure peut-il évoluer avec notre entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'évolutivité est au cœur de notre approche. L'architecture modulaire permet d'ajouter de nouveaux modules (nouveaux marchés, nouvelles entités, nouvelles fonctionnalités) sans remettre en cause l'existant. Un contrat de maintenance et d'évolution mensuel est disponible après la livraison initiale." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

