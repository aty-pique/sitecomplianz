{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Email marketing & automation | Campagnes email et CRM | Complianz{% endblock %}

{% block description %}Déployez des campagnes email marketing automatisées qui convertissent. Segmentation, séquences de nurturing, newsletters et suivi des performances.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Email marketing & automatisation",
      "url": "{{ app_url }}/performance-digitale/strategie-digitale/email-marketing",
      "description": "Déploiement de campagnes email marketing automatisées : audit de délivrabilité, séquences de nurturing, newsletters récurrentes, segmentation avancée et intégration CRM.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Email marketing et marketing automation",
      "offers": [
        { "@type": "Offer", "name": "Email marketing Starter",   "price": "590",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "990" } },
        { "@type": "Offer", "name": "Email marketing Standard",  "price": "990",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Email automation Premium",  "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Stratégie digitale",                "item": "{{ app_url }}/performance-digitale/strategie-digitale" },
        { "@type": "ListItem", "position": 4, "name": "Email marketing",                   "item": "{{ app_url }}/performance-digitale/strategie-digitale/email-marketing" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle plateforme d'email marketing choisir ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix dépend de votre contexte. Mailchimp est adapté aux petites structures qui débutent. ActiveCampaign est idéal pour l'automation avancée et le CRM intégré. HubSpot convient aux entreprises B2B avec un cycle de vente complexe. Brevo (ex-Sendinblue) est une excellente solution européenne RGPD-friendly. Klaviyo est optimisé pour le e-commerce. Nous vous conseillons l'outil adapté à vos besoins et votre budget lors du diagnostic initial." }
        },
        {
          "@type": "Question",
          "name": "Quel est un bon taux d'ouverture pour un email marketing ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le taux d'ouverture moyen varie selon les secteurs. B2B : 20-30%. E-commerce : 15-25%. Services : 18-28%. Le taux de clic cible est de 2-5% en B2B et 1-3% en B2C. Ces benchmarks évoluent avec l'introduction d'iOS Apple Mail Privacy (qui surestime les ouvertures). Nous suivons le taux de clic et les conversions comme indicateurs plus fiables." }
        },
        {
          "@type": "Question",
          "name": "Comment éviter que mes emails arrivent en spam ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La délivrabilité dépend de plusieurs facteurs : configuration technique (SPF, DKIM, DMARC), réputation de l'IP et du domaine d'envoi, qualité de la liste (pas d'adresses invalides), contenu non spammeux et respect des bonnes pratiques d'envoi (fréquence, ratio texte/images). Nous commençons toujours par un audit de délivrabilité avant de déployer vos campagnes." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre une newsletter et une séquence d'automation ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une newsletter est un envoi récurrent (hebdomadaire, mensuel) à toute votre liste ou à des segments. Une séquence d'automation est déclenchée par une action de l'utilisateur (inscription, achat, abandon de panier) et s'envoie automatiquement. Les deux sont complémentaires : la newsletter nourrit la relation, l'automation convertit au bon moment avec le bon message." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

