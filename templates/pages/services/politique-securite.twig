{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 147 chars description) ─────────────────── #}
{% block title %}Politique sécurité informatique PSSI | Rédaction sur mesure | Complianz{% endblock %}

{% block description %}Rédigez votre Politique de Sécurité des Systèmes d'Information (PSSI) adaptée à votre contexte. Charte informatique, procédures et plan de continuité.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Politique de sécurité informatique — PSSI sur mesure",
      "url": "{{ app_url }}/audit-conformite/cybersecurite/politique-securite",
      "description": "Rédaction sur mesure de votre Politique de Sécurité des Systèmes d'Information (PSSI), charte informatique, procédures de gestion des incidents, plan de continuité d'activité (PCA) et plan de reprise d'activité (PRA). Accompagnement et formation des équipes.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Politique de sécurité informatique (PSSI)",
      "offers": [
        { "@type": "Offer", "name": "PSSI PME",                   "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500" } },
        { "@type": "Offer", "name": "PSSI + PCA/PRA",             "price": "3500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500" } },
        { "@type": "Offer", "name": "PSSI complète + formation",  "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                         "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",     "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Cybersécurité",                   "item": "{{ app_url }}/audit-conformite/cybersecurite" },
        { "@type": "ListItem", "position": 4, "name": "Politique de sécurité (PSSI)",    "item": "{{ app_url }}/audit-conformite/cybersecurite/politique-securite" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une PSSI (Politique de Sécurité des Systèmes d'Information) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La PSSI est le document cadre qui définit les règles, les responsabilités et les procédures de sécurité informatique de votre entreprise. Elle couvre la gestion des accès, les politiques de mot de passe, les règles d'utilisation des outils, la gestion des incidents, les sauvegardes et la continuité d'activité. C'est le fondement organisationnel de votre cybersécurité." }
        },
        {
          "@type": "Question",
          "name": "La PSSI est-elle obligatoire ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La PSSI n'est pas obligatoire pour toutes les entreprises, mais elle est exigée ou fortement recommandée dans plusieurs contextes : certification ISO 27001, conformité NIS2 (opérateurs essentiels), marchés publics, contrats avec grandes entreprises, et secteurs réglementés (santé, finance, défense). Elle est en tout cas indispensable dès lors que vous avez des données sensibles à protéger." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre une PSSI et une charte informatique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La PSSI est le document cadre stratégique destiné à la direction et aux responsables IT — elle définit les objectifs, les périmètres et les principes généraux de sécurité. La charte informatique est le document opérationnel destiné à tous les collaborateurs — elle définit les règles d'usage des outils informatiques, les droits et obligations de chacun. Les deux sont complémentaires et font partie d'une politique de sécurité complète." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un PCA et un PRA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le Plan de Continuité d'Activité (PCA) définit comment votre entreprise continue à fonctionner en mode dégradé pendant un incident (cyberattaque, sinistre). Le Plan de Reprise d'Activité (PRA) définit comment vous revenez à un fonctionnement normal après un incident. Ces deux plans sont essentiels pour limiter les pertes financières lors d'une crise et sont exigés dans de nombreux secteurs réglementés." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

