{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Audit organisationnel | Diagnostic structure &amp; gouvernance | Complianz{% endblock %}

{% block description %}Réalisez un audit organisationnel complet pour optimiser votre structure, vos processus et votre gouvernance. Rapport + plan de transformation. Dès 2 900€.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit organisationnel — Diagnostic de votre structure d'entreprise",
      "url": "{{ app_url }}/audit-conformite/audit-conseil/audit-organisationnel",
      "description": "Audit organisationnel complet pour optimiser votre structure d'entreprise : analyse de la structure organisationnelle, cartographie des processus, évaluation des rôles et responsabilités, analyse des flux de communication, benchmarking sectoriel et plan de transformation. Dès 2 900€ HT.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit organisationnel",
      "offers": [
        { "@type": "Offer", "name": "Audit organisationnel PME",                    "price": "2900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500"  } },
        { "@type": "Offer", "name": "Audit organisationnel ETI",                    "price": "5500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } },
        { "@type": "Offer", "name": "Audit + Accompagnement transformation",        "price": "9000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                       "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité",   "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Audit & Conseil",               "item": "{{ app_url }}/audit-conformite/audit-conseil" },
        { "@type": "ListItem", "position": 4, "name": "Audit organisationnel",         "item": "{{ app_url }}/audit-conformite/audit-conseil/audit-organisationnel" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit organisationnel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit organisationnel est une analyse structurée de la façon dont une entreprise est organisée : sa structure hiérarchique, ses processus, les rôles et responsabilités de chacun, ses flux de communication et sa gouvernance. Il identifie les inefficacités, les redondances et les blocages, et aboutit à des recommandations concrètes pour améliorer la performance organisationnelle." }
        },
        {
          "@type": "Question",
          "name": "Quand faut-il réaliser un audit organisationnel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit organisationnel est particulièrement pertinent lors d'une période de croissance rapide, d'une fusion-acquisition, d'une réorganisation interne, d'une baisse de performance, d'un fort turnover ou lors de la préparation d'une transformation stratégique. Il permet de partir d'une base solide pour toute décision d'organisation." }
        },
        {
          "@type": "Question",
          "name": "Combien dure un audit organisationnel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit organisationnel PME dure généralement 3 à 6 semaines : 1 à 2 semaines de collecte documentaire et d'entretiens, 1 à 2 semaines d'analyse et de rédaction, 1 semaine de finalisation et restitution. Pour une ETI, compter 6 à 12 semaines selon la complexité de l'organisation." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre audit organisationnel et audit des processus ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit des processus se concentre sur l'efficacité et la conformité des processus opérationnels. L'audit organisationnel a un périmètre plus large : il inclut la structure, les rôles, la gouvernance, les flux de communication et la culture d'entreprise en plus des processus. L'un est un focus opérationnel, l'autre est une vision systémique de l'organisation." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

