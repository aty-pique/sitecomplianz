{% extends 'layouts/base.twig' %}

{% block title %}IA solutions RH | Intelligence artificielle ressources humaines | Complianz{% endblock %}

{% block description %}Transformez vos RH avec l'IA : recrutement prédictif, analyse des compétences, chatbot RH et automatisation administrative. Guide complet.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "IA pour les ressources humaines — Solutions et outils",
      "url": "{{ app_url }}/intelligence-artificielle/ia-entreprise/ia-pour-les-solutions-rh",
      "description": "Guide complet des solutions IA pour les RH : recrutement prédictif, gestion des talents, chatbot RH, automatisation administrative et conformité.",
      "author": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "publisher": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "inLanguage": "fr"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle", "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "IA en entreprise", "item": "{{ app_url }}/intelligence-artificielle/ia-entreprise" },
        { "@type": "ListItem", "position": 4, "name": "IA pour les RH", "item": "{{ app_url }}/intelligence-artificielle/ia-entreprise/ia-pour-les-solutions-rh" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Comment l'IA transforme-t-elle le recrutement ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'IA transforme le recrutement de bout en bout : rédaction d'offres d'emploi optimisées, tri automatique des CV selon des critères objectifs, scoring prédictif des candidats selon les profils à succès, planification automatique des entretiens, et analyse des entretiens vidéo pour identifier les candidats les plus adaptés. Les RH passent moins de temps sur la sélection administrative et plus sur les entretiens à forte valeur ajoutée." }
        },
        {
          "@type": "Question",
          "name": "L'IA dans le recrutement génère-t-elle des biais discriminatoires ?",
          "acceptedAnswer": { "@type": "Answer", "text": "C'est un risque réel que toute organisation doit prendre en compte. Les algorithmes de tri de CV peuvent reproduire et amplifier des biais existants (genre, origine, âge) si les données d'entraînement sont biaisées. Les bonnes pratiques : audits réguliers des algorithmes pour détecter les biais, exclusion des données personnelles non pertinentes (photo, âge, nom) du scoring, supervision humaine systématique des décisions finales, et conformité avec l'AI Act et le RGPD." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un chatbot RH et quelles questions peut-il traiter ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un chatbot RH est un assistant IA qui répond automatiquement aux questions courantes des collaborateurs disponible 24h/24 : demandes de congés et soldes, règles de remboursement de frais, procédures d'onboarding, avantages sociaux, contacts internes, accès aux documents RH. Il traite environ 70 à 80% des questions RH courantes sans intervention humaine, libérant les RH pour les sujets complexes." }
        },
        {
          "@type": "Question",
          "name": "Quelles tâches RH peut-on automatiser avec l'IA en priorité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les tâches RH à automatiser en priorité pour le meilleur ROI : tri et scoring des CV (économie de 70% du temps de présélection), onboarding automatisé (checklist, envoi de documents, accès aux outils), gestion des demandes de congés, reporting RH périodique (tableaux de bord absentéisme, turnover), FAQ collaborateurs via chatbot, et relances de processus (entretiens annuels, formations obligatoires)." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

