{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 148 chars description) ─────────────────── #}
{% block title %}CRM sur mesure | Développement CRM entreprise | Complianz{% endblock %}

{% block description %}Développez un CRM 100% adapté à votre process commercial. Gestion contacts, pipeline, devis, relances automatisées et tableaux de bord. Intégration sur mesure.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "CRM sur mesure — Gérez vos clients et votre pipeline commercial",
      "url": "{{ app_url }}/solutions-developpement/erp-crm/crm-sur-mesure",
      "description": "Développement d'un CRM 100% adapté à votre processus commercial : gestion contacts, pipeline, opportunités, devis, facturation, automatisation des relances, tableaux de bord et intégration email/agenda.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "CRM sur mesure",
      "offers": [
        { "@type": "Offer", "name": "CRM Starter",   "price": "4900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8900"  } },
        { "@type": "Offer", "name": "CRM Standard",  "price": "8900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "18000" } },
        { "@type": "Offer", "name": "CRM Enterprise","price": "18000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "35000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "ERP & CRM",                 "item": "{{ app_url }}/solutions-developpement/erp-crm" },
        { "@type": "ListItem", "position": 4, "name": "CRM sur mesure",            "item": "{{ app_url }}/solutions-developpement/erp-crm/crm-sur-mesure" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "CRM sur mesure vs solution standard (HubSpot, Salesforce) ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un CRM standard est adapté pour des processus commerciaux classiques et offre une mise en œuvre rapide. Un CRM sur mesure est préférable si votre cycle de vente est spécifique, si vous avez des processus atypiques, si vous souhaitez des intégrations poussées avec vos autres outils (ERP, e-commerce, logistique) ou si les licences mensuelles d'un CRM standard deviennent coûteuses à long terme." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour développer un CRM sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 6 à 10 semaines pour un CRM Starter (pipeline commercial, gestion contacts), de 3 à 5 mois pour un CRM Standard (multi-modules, automatisations avancées), et de 5 à 9 mois pour un CRM Enterprise (multi-équipes, intégrations complexes). Nous travaillons en méthodologie itérative pour livrer des fonctionnalités progressivement." }
        },
        {
          "@type": "Question",
          "name": "Peut-on intégrer un CRM existant avec nos autres outils ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'intégration avec vos outils existants est au cœur de notre approche. Nous développons les connecteurs API nécessaires pour connecter votre CRM à votre messagerie (Gmail, Outlook), votre agenda, votre comptabilité, votre site web, votre ERP ou vos outils marketing (Mailchimp, HubSpot Marketing…)." }
        },
        {
          "@type": "Question",
          "name": "La formation est-elle incluse dans le développement CRM ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — une formation complète des utilisateurs (commerciaux, managers, administrateurs) est incluse dans tous nos forfaits CRM. Nous livrons également une documentation utilisateur personnalisée et assurons un support dédié pendant les premières semaines de production." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

