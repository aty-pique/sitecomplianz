{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 154 chars description) ─────────────────── #}
{% block title %}Audit &amp; sécurisation systèmes informatiques{% endblock %}

{% block description %}Identifiez vos vulnérabilités et sécurisez vos systèmes informatiques : audit SI, pentest, politique de sécurité, RSSI externalisé. Devis gratuit sous 24h.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit & sécurisation des systèmes informatiques",
      "url": "{{ app_url }}/audit-conformite/cybersecurite",
      "description": "Analyse et sécurisation des systèmes informatiques de l'entreprise : audit des infrastructures, analyse des accès, tests d'intrusion (pentest), identification des vulnérabilités, recommandations de sécurisation et mise en place de mesures correctives. RSSI externalisé possible.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit de cybersécurité et sécurisation des systèmes informatiques",
      "offers": [
        { "@type": "Offer", "name": "Audit sécurité simple",                  "price": "2000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000"  } },
        { "@type": "Offer", "name": "Audit avancé / tests techniques (pentest)", "price": "5000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "15000" } },
        { "@type": "Offer", "name": "Audit complet + sécurisation",            "price": "15000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "40000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Audit & cybersécurité",       "item": "{{ app_url }}/audit-conformite/cybersecurite" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit de sécurité informatique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un audit de sécurité informatique est une analyse approfondie des systèmes, réseaux, applications et accès d'une entreprise pour identifier les vulnérabilités, les failles de configuration et les risques de cyberattaque. Il aboutit à un rapport détaillé et à un plan de sécurisation priorisé." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un audit de sécurité et un pentest ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit de sécurité informatique est une analyse globale des risques (configuration, politiques, accès, documentation). Le pentest (test d'intrusion) va plus loin : des experts tentent activement de pénétrer vos systèmes pour découvrir des vulnérabilités réelles exploitables. Les deux sont complémentaires." }
        },
        {
          "@type": "Question",
          "name": "Quelles entreprises ont besoin d'un audit de cybersécurité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Toute entreprise qui stocke des données clients, utilise des outils en ligne, a des accès à distance ou traite des informations sensibles. Les secteurs santé, finance, industrie et collectivités sont particulièrement exposés. Une cyberattaque coûte en moyenne 27 000 € à une PME française." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un audit de sécurité informatique ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 2 000 € à 5 000 € pour un audit sécurité simple (TPE, périmètre limité), de 5 000 € à 15 000 € pour un audit avancé avec tests techniques et pentest, et de 15 000 € à 40 000 €+ pour un audit complet avec déploiement des mesures de sécurisation. Un devis personnalisé est remis sous 24h." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un RSSI externalisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le RSSI externalisé (Responsable de la Sécurité des Systèmes d'Information) est un expert en cybersécurité qui pilote votre sécurité informatique à temps partiel, sans les coûts d'un CDI. Il définit et fait appliquer votre politique de sécurité, gère les incidents et assure une veille permanente." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

