{% extends 'layouts/base.twig' %}

{# ── SEO (60 chars titre / 150 chars description) ─────────────────── #}
{% block title %}Logiciel gestion commerciale | Devis, facturation & stock | Complianz{% endblock %}

{% block description %}Développez votre logiciel de gestion commerciale : devis, bons de commande, facturation, stock et suivi clients. Solution sur mesure ou intégration Odoo.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Logiciel de gestion commerciale sur mesure",
      "url": "{{ app_url }}/solutions-developpement/erp-crm/gestion-commerciale",
      "description": "Développement d'un logiciel de gestion commerciale sur mesure ou intégration Odoo : devis, bons de commande, facturation, avoirs, suivi des stocks, relances clients et tableaux de bord.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Logiciel gestion commerciale",
      "offers": [
        { "@type": "Offer", "name": "Module Gestion commerciale", "price": "6500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "12000" } },
        { "@type": "Offer", "name": "Suite complète gestion",     "price": "12000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } },
        { "@type": "Offer", "name": "Intégration dans ERP existant", "price": "5000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "ERP & CRM",                 "item": "{{ app_url }}/solutions-developpement/erp-crm" },
        { "@type": "ListItem", "position": 4, "name": "Gestion commerciale",       "item": "{{ app_url }}/solutions-developpement/erp-crm/gestion-commerciale" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un logiciel de gestion commerciale sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un logiciel de gestion commerciale sur mesure est un outil développé spécifiquement pour votre activité : il gère votre cycle commercial complet — devis, bons de commande, facturation, avoirs, gestion des stocks et suivi clients — en respectant vos processus exacts et en s'intégrant à vos autres outils (comptabilité, CRM, e-commerce)." }
        },
        {
          "@type": "Question",
          "name": "Faut-il développer un logiciel sur mesure ou utiliser Odoo ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Odoo est une excellente solution pour les besoins de gestion commerciale standards avec un déploiement rapide et un coût initial plus faible. Un développement sur mesure est préférable si vos processus sont très spécifiques, si vous avez des contraintes d'intégration fortes avec votre SI existant, ou si vous souhaitez une interface parfaitement adaptée à vos équipes. Nous proposons les deux approches et vous conseillons lors du cadrage." }
        },
        {
          "@type": "Question",
          "name": "Le logiciel peut-il se connecter à notre comptabilité ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'intégration avec votre logiciel de comptabilité (Sage, Cegid, EBP, Pennylane…) est incluse dans notre périmètre. Nous développons les connecteurs nécessaires pour que les factures validées remontent automatiquement en comptabilité, en évitant les doubles saisies et les erreurs de rapprochement." }
        },
        {
          "@type": "Question",
          "name": "L'interface mobile est-elle incluse ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — une interface mobile responsive est incluse dans la Suite complète gestion. Elle permet à vos commerciaux de créer des devis, consulter le stock et accéder aux fiches clients depuis leur smartphone ou tablette, même en déplacement chez un client." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

