{% extends 'layouts/base.twig' %}

{# ── SEO ──────────────────────────────────────────────────────────── #}
{% block title %}Développement IA sur mesure — solutions intelligentes pour votre entreprise{% endblock %}

{% block description %}Conception et développement de solutions IA sur mesure : analyse prédictive, NLP, vision, automatisation avancée, intégration dans votre SI existant. Prototype à système complet.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Développement de solutions IA sur mesure",
      "url": "{{ app_url }}/intelligence-artificielle/solutions-ia/developpement-ia-sur-mesure",
      "description": "Conception et développement de solutions basées sur l'intelligence artificielle adaptées aux besoins spécifiques de l'entreprise : systèmes d'analyse de données, outils prédictifs, assistants intelligents, automatisations avancées, intégrées directement dans l'écosystème digital existant.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Développement de solutions IA sur mesure",
      "offers": [
        { "@type": "Offer", "name": "Prototype / POC",           "price": "3000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "10000" } },
        { "@type": "Offer", "name": "Solution IA simple",        "price": "10000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } },
        { "@type": "Offer", "name": "Solution IA avancée",       "price": "25000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "80000" } },
        { "@type": "Offer", "name": "Système IA complexe",       "price": "80000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "200000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                    "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle",  "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "Solutions IA sur mesure",    "item": "{{ app_url }}/intelligence-artificielle/solutions-ia" },
        { "@type": "ListItem", "position": 4, "name": "Développement IA sur mesure","item": "{{ app_url }}/intelligence-artificielle/solutions-ia/developpement-ia-sur-mesure" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'une solution IA sur mesure et en quoi est-elle différente des outils IA existants ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une solution IA sur mesure est développée spécifiquement pour répondre à vos enjeux métier précis, avec vos données, vos contraintes et vos processus. Contrairement aux outils IA généralistes, elle s'intègre directement dans votre écosystème digital, respecte vos règles métier spécifiques et peut être entraînée sur vos propres données pour des performances optimales. Elle vous offre un avantage concurrentiel durable que vos concurrents ne peuvent pas répliquer avec des outils standard." }
        },
        {
          "@type": "Question",
          "name": "Quels types de solutions IA pouvez-vous développer ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous développons des solutions d'IA générative (génération de contenu, résumés, rédaction assistée), d'analyse prédictive (prévisions de ventes, maintenance prédictive, churn prediction), de traitement du langage naturel (NLP : classification, extraction d'informations, analyse de sentiment), de vision par ordinateur (reconnaissance d'images, contrôle qualité visuel, OCR), et des systèmes de recommandation. Nous pouvons aussi développer des agents IA autonomes et des systèmes d'automatisation intelligente." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte le développement d'une solution IA sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 3 000 à 10 000 € pour un prototype/POC permettant de valider la faisabilité. De 10 000 à 25 000 € pour une solution IA simple (une fonctionnalité, intégration de base). De 25 000 à 80 000 € pour une solution IA avancée (plusieurs fonctionnalités, intégration SI). De 80 000 à 200 000 €+ pour un système IA complexe sur mesure avec infrastructure complète. Une maintenance mensuelle de 500 à 5 000 €/mois assure l'évolution continue." }
        },
        {
          "@type": "Question",
          "name": "Nos données sont-elles sécurisées lors du développement d'une solution IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La sécurité et la confidentialité de vos données sont une priorité absolue. Nous signons des accords de confidentialité (NDA), travaillons en conformité RGPD, pouvons développer des solutions on-premise (sur vos serveurs) si nécessaire, et n'utilisons jamais vos données pour entraîner d'autres modèles. Chaque projet intègre une analyse des risques liés aux données et une architecture technique respectant vos contraintes de sécurité." }
        },
        {
          "@type": "Question",
          "name": "Comment se déroule un projet de développement IA sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous procédons en plusieurs phases : (1) Analyse des besoins métier et identification des cas d'usage IA à fort ROI, (2) Conception de la solution et choix des technologies, (3) Développement d'un prototype pour validation rapide, (4) Développement complet et intégration dans votre SI, (5) Tests approfondis, (6) Déploiement, (7) Formation de vos équipes et (8) Maintenance et évolution continue. La durée varie de 1 à 12 mois selon la complexité." }
      }
    }
  ]
}
</script>
{% endblock %}

