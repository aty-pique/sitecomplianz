{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 143 chars description) ─────────────────── #}
{% block title %}Création site vitrine | Site web professionnel sur mesure | Complianz{% endblock %}

{% block description %}Créez un site vitrine professionnel qui convertit. Design sur mesure, SEO intégré, responsive et rapide. Livraison en 3-6 semaines. Devis gratuit.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création de site vitrine professionnel",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web/site-vitrine",
      "description": "Conception et développement de sites vitrines professionnels sur mesure : design UI/UX personnalisé, SEO intégré, responsive, formulaire de contact, hébergement inclus 1 an.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création de site vitrine",
      "offers": [
        { "@type": "Offer", "name": "Site vitrine Essentiel (5 pages)",  "price": "1900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3900"  } },
        { "@type": "Offer", "name": "Site vitrine Standard (10 pages)",  "price": "3900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6900"  } },
        { "@type": "Offer", "name": "Site vitrine Premium (20+ pages)",  "price": "6900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "14000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" },
        { "@type": "ListItem", "position": 4, "name": "Site vitrine",              "item": "{{ app_url }}/solutions-developpement/creation-site-web/site-vitrine" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Combien coûte un site vitrine professionnel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 900 € à 3 900 € pour un site vitrine Essentiel (5 pages), de 3 900 € à 6 900 € pour un site Standard (10 pages) avec design sur mesure et SEO avancé, et de 6 900 € à 14 000 € pour un site Premium (20+ pages) avec fonctionnalités avancées. Le cadrage est toujours gratuit." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour créer un site vitrine ?",
          "acceptedAnswer": { "@type": "Answer", "text": "En général entre 3 et 6 semaines pour un site vitrine Essentiel, et de 6 à 10 semaines pour un site Standard ou Premium. Le délai dépend principalement de la disponibilité des contenus (textes, images) et de la rapidité des retours lors des phases de validation." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un site vitrine et un site e-commerce ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un site vitrine présente votre entreprise, vos services et génère des contacts (formulaire, appel). Un site e-commerce permet de vendre des produits directement en ligne avec un catalogue, un panier et un système de paiement. Si vous souhaitez vendre en ligne, nous proposons également la création de boutique e-commerce." }
        },
        {
          "@type": "Question",
          "name": "Le site vitrine inclut-il le SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — l'optimisation SEO de base est incluse dans chaque projet : structure des titres (Hn), balises meta, vitesse de chargement, responsive mobile, sitemap et robots.txt. Pour une stratégie SEO complète (rédaction, netlinking, suivi de positionnement), notre pôle Performance Digitale propose un accompagnement dédié." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

