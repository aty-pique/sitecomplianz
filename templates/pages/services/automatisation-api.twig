{% extends 'layouts/base.twig' %}

{# ── SEO (44 chars titre / 144 chars description) ─────────────────── #}
{% block title %}Automatisation & API sur mesure{% endblock %}

{% block description %}Connectez vos outils et automatisez vos processus métier : no-code, API, logique métier avancée. Réduisez les tâches manuelles et faites fonctionner votre entreprise en fluidité.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Automatisation & interconnexion des systèmes",
      "url": "{{ app_url }}/solutions-developpement/developpement-logiciel/automatisation-api",
      "description": "Conception, mise en place et optimisation d'automatisations entre les outils de l'entreprise pour fluidifier les processus, limiter les tâches manuelles et créer un écosystème cohérent entre CRM, ERP, outils marketing et logiciels métiers.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Automatisation processus & intégration API",
      "offers": [
        { "@type": "Offer", "name": "Automatisations simples",       "price": "500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2000"  } },
        { "@type": "Offer", "name": "Automatisations intermédiaires", "price": "2000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8000"  } },
        { "@type": "Offer", "name": "Automatisations complexes",      "price": "8000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "25000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                          "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement",        "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Développement logiciel sur mesure","item": "{{ app_url }}/solutions-developpement/developpement-logiciel" },
        { "@type": "ListItem", "position": 4, "name": "Automatisation & API",             "item": "{{ app_url }}/solutions-developpement/developpement-logiciel/automatisation-api" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que l'automatisation de processus en entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'automatisation de processus consiste à configurer des flux de travail qui s'exécutent automatiquement en réponse à des événements ou des conditions. Cela peut aller d'une simple notification automatique à un workflow complexe qui synchronise plusieurs outils (CRM, ERP, marketing, comptabilité) sans intervention humaine." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre no-code (Make, Zapier) et le développement API sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les outils no-code comme Make ou Zapier sont idéaux pour des automatisations simples à intermédiaires entre des outils qui disposent de connecteurs natifs. Le développement API sur mesure est nécessaire pour des cas plus complexes : logique métier avancée, outils sans connecteurs disponibles, transformations de données spécifiques ou volumes élevés. Nous choisissons la technologie la plus adaptée selon vos besoins." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte la mise en place d'automatisations ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 500 € à 2 000 € pour des automatisations simples (1 à 2 flux no-code), de 2 000 € à 8 000 € pour des automatisations intermédiaires (plusieurs flux, outils connectés), et de 8 000 € à 25 000 €+ pour des automatisations complexes (API sur mesure, logique métier avancée, multi-systèmes). Un abonnement de maintenance et évolutions est disponible à partir de 100 €/mois." }
        },
        {
          "@type": "Question",
          "name": "Quels outils peut-on connecter et automatiser ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous pouvons connecter et automatiser la quasi-totalité des outils du marché : CRM (HubSpot, Salesforce, Pipedrive), ERP (Odoo, SAP), outils marketing (Mailchimp, ActiveCampaign), e-commerce (Shopify, WooCommerce), comptabilité (QuickBooks, Pennylane), outils de gestion de projet (Notion, Asana, Monday), et bien d'autres via leurs API." }
        },
        {
          "@type": "Question",
          "name": "Que se passe-t-il si un automatisme tombe en panne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous documentons systématiquement tous les flux mis en place. Avec notre abonnement de maintenance, nous assurons le monitoring, la correction des erreurs et les évolutions. Sans abonnement, la documentation complète vous permet de faire appel à notre équipe ponctuellement en cas de problème." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

