{% extends 'layouts/base.twig' %}

{# ── SEO (56 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Registre des traitements RGPD | Mise en place &amp; maintenance | Complianz{% endblock %}

{% block description %}Créez et maintenez votre registre des traitements RGPD article 30. Cartographie complète de vos données personnelles. Documentation conforme CNIL.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Registre des traitements RGPD — Mise en place et tenue",
      "url": "{{ app_url }}/audit-conformite/conformite-rgpd/registre-traitements",
      "description": "Création et maintenance du registre des traitements RGPD article 30 : inventaire des activités de traitement, fiches par traitement (finalité, base légale, durées de conservation), export PDF/Excel, formation équipe et modèle de procédure de mise à jour. Documentation conforme CNIL.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Registre des traitements RGPD",
      "offers": [
        { "@type": "Offer", "name": "Registre initial",               "price": "900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Registre + accompagnement",      "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2800" } },
        { "@type": "Offer", "name": "Maintenance annuelle",           "price": "600",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1200" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Conformité RGPD",             "item": "{{ app_url }}/audit-conformite/conformite-rgpd" },
        { "@type": "ListItem", "position": 4, "name": "Registre des traitements",   "item": "{{ app_url }}/audit-conformite/conformite-rgpd/registre-traitements" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qui doit tenir un registre des traitements RGPD ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'article 30 du RGPD impose la tenue d'un registre des activités de traitement à toutes les organisations sauf les entreprises de moins de 250 salariés dont les traitements ne sont pas susceptibles d'engendrer un risque pour les droits des personnes, ne sont pas effectués de manière occasionnelle, ou ne portent pas sur des données sensibles. En pratique, la grande majorité des PME doivent tenir un registre." }
        },
        {
          "@type": "Question",
          "name": "Que doit contenir le registre des traitements ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Selon l'article 30 du RGPD, le registre doit contenir pour chaque traitement : le nom et les coordonnées du responsable de traitement, la finalité du traitement, les catégories de personnes concernées et de données, les destinataires, les transferts hors UE, les délais de conservation prévus et les mesures de sécurité." }
        },
        {
          "@type": "Question",
          "name": "Le registre des traitements est-il obligatoire ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, l'article 30 du RGPD impose la tenue d'un registre des activités de traitement. Ce registre doit être mis à disposition de la CNIL sur demande. En cas de contrôle, l'absence de registre constitue une non-conformité pouvant faire l'objet d'une sanction." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un registre et une cartographie des données ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La cartographie des données est une vue d'ensemble des flux de données dans l'organisation (quelles données, où, qui y accède). Le registre des traitements est le document formel requis par l'article 30 du RGPD qui liste et documente chaque activité de traitement avec ses caractéristiques réglementaires. La cartographie alimente le registre." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

