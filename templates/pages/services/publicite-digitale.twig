{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Publicité digitale SEA & Social Ads | Campagnes Google Ads | Complianz{% endblock %}

{% block description %}Lancez des campagnes publicitaires Google Ads, Meta Ads et LinkedIn Ads performantes. Ciblage précis, budget optimisé et ROI mesuré. Gestion complète.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Publicité digitale — SEA & Social Ads",
      "url": "{{ app_url }}/performance-digitale/strategie-digitale/publicite-digitale",
      "description": "Gestion complète de campagnes publicitaires digitales : Google Ads (Search, Display, Shopping), Meta Ads (Facebook, Instagram), LinkedIn Ads B2B, avec optimisation continue du ROAS et reporting mensuel.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Publicité digitale SEA et Social Ads",
      "offers": [
        { "@type": "Offer", "name": "SEA Starter",  "price": "690",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1200" } },
        { "@type": "Offer", "name": "SEA Standard", "price": "1200", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2200" } },
        { "@type": "Offer", "name": "SEA Premium",  "price": "2200", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "4000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Stratégie digitale",                "item": "{{ app_url }}/performance-digitale/strategie-digitale" },
        { "@type": "ListItem", "position": 4, "name": "Publicité digitale",                "item": "{{ app_url }}/performance-digitale/strategie-digitale/publicite-digitale" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle différence entre SEA et Social Ads ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le SEA (Search Engine Advertising) désigne les publicités sur les moteurs de recherche, principalement Google Ads. Vous ciblez des personnes qui recherchent activement votre produit ou service — intention d'achat forte. Les Social Ads (Meta Ads, LinkedIn Ads) ciblent les utilisateurs des réseaux sociaux selon leurs données démographiques et comportementales — puissant pour la notoriété et la génération de demande. Les deux sont complémentaires : le SEA capte l'intention, les Social Ads créent la demande." }
        },
        {
          "@type": "Question",
          "name": "Quel budget minimum pour des campagnes Google Ads ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un budget minimum de 500 à 1 000€/mois en budget publicitaire est nécessaire pour que Google Ads accumule suffisamment de données et optimise les enchères. En dessous, les résultats seront trop limités. Pour des secteurs compétitifs ou des campagnes Shopping e-commerce, prévoyez 2 000€/mois et plus. Notre prestation de gestion s'ajoute au budget publicitaire." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce que le ROAS et comment est-il mesuré ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le ROAS (Return On Ad Spend) mesure le revenu généré pour chaque euro dépensé en publicité. Un ROAS de 4 signifie que vous générez 4€ de chiffre d'affaires pour 1€ dépensé. Il se mesure via le suivi des conversions Google Ads ou le pixel Meta, couplé à votre CRM ou plateforme e-commerce. Un ROAS acceptable varie selon les secteurs et les marges." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour voir des résultats avec Google Ads ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Google Ads génère des résultats rapidement (dès les premières semaines) mais les algorithmes nécessitent une phase d'apprentissage de 2 à 4 semaines pour optimiser les enchères. Les résultats s'améliorent progressivement sur 2 à 3 mois à mesure que l'algorithme accumule de la data. Meta Ads suit un calendrier similaire. Évitez les campagnes ponctuelles — la régularité et l'optimisation continue sont clés." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

