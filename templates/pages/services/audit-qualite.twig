{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Audit qualité interne | Évaluation SMQ et conformité | Complianz{% endblock %}

{% block description %}Réalisez vos audits qualité internes selon les exigences ISO 9001. Rapport d'audit, plan d'actions correctives et préparation à l'audit de renouvellement.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit qualité interne — Évaluation et amélioration continue",
      "url": "{{ app_url }}/audit-conformite/certifications-iso/audit-qualite",
      "description": "Réalisation d'audits qualité internes selon les exigences ISO 9001 : plan d'audit, questionnaires d'audit, rapport d'audit complet avec non-conformités et actions correctives, suivi des actions et préparation à l'audit de renouvellement de certification.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Audit qualité interne ISO 9001",
      "offers": [
        { "@type": "Offer", "name": "Audit qualité ponctuel",          "price": "1200", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2400" } },
        { "@type": "Offer", "name": "Programme annuel d'audits",       "price": "2800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500" } },
        { "@type": "Offer", "name": "Audit + formation auditeurs",     "price": "3500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "6500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                     "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Certifications ISO",          "item": "{{ app_url }}/audit-conformite/certifications-iso" },
        { "@type": "ListItem", "position": 4, "name": "Audit qualité interne",       "item": "{{ app_url }}/audit-conformite/certifications-iso/audit-qualite" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi réaliser un audit qualité interne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit qualité interne est obligatoire selon la norme ISO 9001 (clause 9.2). Il permet d'évaluer la conformité de votre SMQ, d'identifier les non-conformités et opportunités d'amélioration, de préparer les audits de surveillance et de renouvellement, et de démontrer l'engagement de l'organisation dans l'amélioration continue." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la fréquence recommandée des audits qualité internes ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La norme ISO 9001 n'impose pas de fréquence précise mais exige que les audits internes soient programmés à intervalles planifiés. En pratique, un programme annuel couvrant l'ensemble du SMQ est recommandé. Les processus à risque ou ayant présenté des non-conformités peuvent être audités plus fréquemment." }
        },
        {
          "@type": "Question",
          "name": "Qui peut réaliser un audit qualité interne ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'auditeur interne doit être compétent (connaissance des exigences ISO 9001, techniques d'audit) et impartial (il ne peut pas auditer son propre travail). Il peut s'agir d'un employé formé à l'audit interne ou d'un consultant externe. Faire appel à un consultant externe garantit l'objectivité et apporte une expertise spécialisée." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre audit interne et audit de certification ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'audit interne est réalisé par (ou pour) l'organisation elle-même, à des fins d'amélioration continue. L'audit de certification est réalisé par un organisme certificateur accrédité externe. L'audit interne prépare à l'audit de certification et permet de s'assurer que le SMQ est conforme avant de passer devant le certificateur." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

