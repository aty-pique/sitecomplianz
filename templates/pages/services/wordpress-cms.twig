{% extends 'layouts/base.twig' %}

{# ── SEO (55 chars titre / 143 chars description) ─────────────────── #}
{% block title %}Intégration WordPress & CMS | Site manageable | Complianz{% endblock %}

{% block description %}Déployez un site WordPress ou CMS sur mesure pour gérer votre contenu facilement. Thème personnalisé, plugins sécurisés, formation incluse.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Intégration WordPress & CMS — Gérez votre contenu facilement",
      "url": "{{ app_url }}/solutions-developpement/creation-site-web/wordpress-cms",
      "description": "Installation, configuration et personnalisation de WordPress ou d'un CMS sur mesure. Thème personnalisé, plugins essentiels (SEO, cache, sécurité, RGPD), migration, formation et documentation.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Intégration WordPress CMS",
      "offers": [
        { "@type": "Offer", "name": "WordPress Starter",              "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900"  } },
        { "@type": "Offer", "name": "WordPress Standard",             "price": "2900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500"  } },
        { "@type": "Offer", "name": "WordPress Premium sur mesure",   "price": "5500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "11000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Solutions & Développement", "item": "{{ app_url }}/solutions-developpement" },
        { "@type": "ListItem", "position": 3, "name": "Création de sites web",     "item": "{{ app_url }}/solutions-developpement/creation-site-web" },
        { "@type": "ListItem", "position": 4, "name": "WordPress & CMS",           "item": "{{ app_url }}/solutions-developpement/creation-site-web/wordpress-cms" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Pourquoi choisir WordPress pour son site web ?",
          "acceptedAnswer": { "@type": "Answer", "text": "WordPress est le CMS le plus utilisé au monde (43% des sites web). Il est idéal pour les sites nécessitant des mises à jour régulières de contenu (blog, actualités, fiches produits). Il offre une grande autonomie de gestion, un vaste écosystème de plugins et une excellente compatibilité SEO. Pour des besoins très spécifiques, le développement d'un thème sur mesure est préférable aux thèmes premium génériques." }
        },
        {
          "@type": "Question",
          "name": "Quelle est la différence entre un thème WordPress et un développement sur mesure ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un thème WordPress standard (Elementor, Divi, Avada) permet un déploiement rapide mais reste limité en personnalisation et peut impacter les performances. Un développement sur mesure offre un design 100% unique, des performances optimales et une architecture adaptée à vos besoins. Nous recommandons Elementor ou Divi pour les budgets intermédiaires et le développement sur mesure pour les projets exigeants." }
        },
        {
          "@type": "Question",
          "name": "Peut-on migrer un site existant vers WordPress ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui — nous réalisons la migration de votre site existant vers WordPress, quelle que soit la technologie d'origine (site statique, Wix, Squarespace, Joomla…). La migration inclut la reprise du contenu, la configuration des redirections 301 pour préserver le SEO, et les tests de validation avant mise en ligne." }
        },
        {
          "@type": "Question",
          "name": "WordPress est-il sécurisé ?",
          "acceptedAnswer": { "@type": "Answer", "text": "WordPress, bien configuré, est un CMS sécurisé. Nous installons et configurons les plugins essentiels de sécurité (Wordfence, iThemes Security), activons les mises à jour automatiques, configurons les sauvegardes régulières et limitons les accès à l'administration. Un contrat de maintenance mensuelle peut inclure la surveillance de sécurité en continu." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

