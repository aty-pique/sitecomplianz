{% extends 'layouts/base.twig' %}

{# ── SEO (58 chars titre / 152 chars description) ─────────────────── #}
{% block title %}Maintenance évolutive — amélioration continue de vos outils{% endblock %}

{% block description %}Faites évoluer vos sites, logiciels et applications en continu : ajout de fonctionnalités, optimisation technique et mises à jour pour s'adapter à votre croissance.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Maintenance évolutive",
      "url": "{{ app_url }}/support-maintenance/maintenance/maintenance-evolutive",
      "description": "Amélioration continue des outils digitaux afin de les faire évoluer en fonction des besoins de l'entreprise, de ses utilisateurs et de sa croissance. Ajout de fonctionnalités, optimisation technique et mises à jour régulières.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Maintenance évolutive et amélioration continue",
      "offers": [
        { "@type": "Offer", "name": "Évolution ponctuelle",     "price": "300",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1500" } },
        { "@type": "Offer", "name": "Forfait mensuel",          "price": "500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2000" } },
        { "@type": "Offer", "name": "Accompagnement avancé",   "price": "2000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                         "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",           "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Maintenance, support & évolutions", "item": "{{ app_url }}/support-maintenance/maintenance" },
        { "@type": "ListItem", "position": 4, "name": "Maintenance évolutive",           "item": "{{ app_url }}/support-maintenance/maintenance/maintenance-evolutive" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que la maintenance évolutive ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance évolutive désigne l'ensemble des interventions visant à améliorer et faire évoluer un outil digital existant — sans qu'il soit défaillant. Contrairement à la maintenance corrective (qui répare des bugs), la maintenance évolutive ajoute de nouvelles fonctionnalités, optimise les performances, met à jour les technologies et adapte l'outil aux nouveaux besoins de l'entreprise et de ses utilisateurs." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre maintenance corrective et évolutive ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La maintenance corrective intervient quand quelque chose ne fonctionne pas (bug, panne, anomalie). La maintenance évolutive intervient proactivement pour améliorer ce qui fonctionne déjà — ajouter des fonctionnalités, optimiser les performances, mettre à jour les dépendances, adapter l'outil aux nouveaux usages. Les deux sont complémentaires dans un contrat de maintenance global." }
        },
        {
          "@type": "Question",
          "name": "Quels types d'évolutions réalisez-vous ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous réalisons tous types d'évolutions : ajout de pages et sections sur un site web, développement de nouvelles fonctionnalités sur une application, optimisation des performances (vitesse, charge), mises à jour des frameworks et dépendances, adaptation à de nouveaux appareils ou navigateurs, intégrations de nouveaux outils (paiement, CRM, analytics), et refonte partielle d'interfaces." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte la maintenance évolutive ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 300 € à 1 500 € pour une évolution ponctuelle (ajout d'une fonctionnalité, nouvelle page), de 500 € à 2 000 €/mois pour un forfait mensuel (évolutions régulières, mises à jour, optimisations), et de 2 000 € à 5 000 €/mois pour un accompagnement évolutif avancé (développement continu, roadmap produit, nombreuses évolutions mensuelles)." }
        },
        {
          "@type": "Question",
          "name": "Comment fonctionne un forfait de maintenance évolutive mensuel ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un forfait mensuel de maintenance évolutive fonctionne comme un crédit d'heures de développement dédié à votre projet. Chaque mois, vous nous communiquez vos demandes d'évolution (nouvelles fonctionnalités, optimisations, mises à jour) et nous les priorisons et réalisons selon le volume contractualisé. Les heures non utilisées peuvent être reportées ou utilisées pour des interventions correctives." }
      }
    }
  ]
}
</script>
{% endblock %}

