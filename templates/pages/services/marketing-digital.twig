{% extends 'layouts/base.twig' %}

{# ── SEO (59 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Marketing digital & réseaux sociaux | Stratégie & contenu | Complianz{% endblock %}

{% block description %}Développez votre présence sur les réseaux sociaux et votre stratégie marketing digital. Community management, création de contenu et campagnes social media.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Marketing digital & réseaux sociaux",
      "url": "{{ app_url }}/performance-digitale/strategie-digitale/marketing-digital",
      "description": "Développement de la présence digitale sur les réseaux sociaux et gestion de la stratégie marketing : community management, création de contenu, publicité social media et reporting mensuel.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Marketing digital et gestion des réseaux sociaux",
      "offers": [
        { "@type": "Offer", "name": "Community management Starter",  "price": "890",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1500" } },
        { "@type": "Offer", "name": "Social media Standard",         "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900" } },
        { "@type": "Offer", "name": "Social media Premium",          "price": "2900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Stratégie digitale",                "item": "{{ app_url }}/performance-digitale/strategie-digitale" },
        { "@type": "ListItem", "position": 4, "name": "Marketing digital",                 "item": "{{ app_url }}/performance-digitale/strategie-digitale/marketing-digital" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quels réseaux sociaux choisir pour son entreprise ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le choix des réseaux dépend de votre cible et de votre activité. LinkedIn est incontournable pour le B2B. Instagram et TikTok sont efficaces pour les marques visuelles et le B2C. Facebook reste pertinent pour les commerces locaux et les audiences 35+. YouTube pour le contenu éducatif et long format. Nous définissons les plateformes prioritaires lors de l'audit social media initial." }
        },
        {
          "@type": "Question",
          "name": "À quelle fréquence publier sur les réseaux sociaux ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La régularité prime sur la fréquence. Pour LinkedIn, 3 à 5 publications par semaine sont idéales. Pour Instagram, 4 à 7 posts par semaine (Stories incluses). L'algorithme récompense la cohérence — un rythme soutenu sur 3 à 6 mois produit des résultats nettement supérieurs à des pics d'activité irréguliers." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour voir des résultats sur les réseaux sociaux ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les premiers indicateurs d'engagement s'améliorent généralement en 1 à 3 mois. La croissance de la communauté et les premiers leads organiques apparaissent entre 3 et 6 mois. Les réseaux sociaux sont un investissement de long terme — les résultats s'accélèrent avec le temps et la régularité. Les campagnes payantes (Social Ads) génèrent des résultats plus rapides." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre community management et social media management ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le community management se concentre sur la gestion de la communauté existante : modération, réponses aux commentaires, animation. Le social media management est plus large : il inclut la stratégie, la création de contenu, la publication, la gestion de la communauté ET le reporting. Nous proposons les deux niveaux selon vos besoins et votre budget." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

