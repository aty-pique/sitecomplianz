{% extends 'layouts/base.twig' %}

{# ── SEO (59 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Netlinking & backlinks SEO | Stratégie de liens | Complianz{% endblock %}

{% block description %}Renforcez l'autorité de votre site avec une stratégie de netlinking éthique. Acquisition de backlinks qualitatifs, guest posting et partenariats éditoriaux.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Netlinking & stratégie de liens",
      "url": "{{ app_url }}/performance-digitale/seo/netlinking",
      "description": "Stratégie d'acquisition de backlinks qualitatifs pour renforcer l'autorité de domaine et améliorer les positions Google. Approche 100% white hat : guest posting, partenariats éditoriaux et digital PR.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Netlinking et stratégie de backlinks SEO",
      "offers": [
        { "@type": "Offer", "name": "Netlinking Starter (5 liens/mois)",   "price": "590",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "990"  } },
        { "@type": "Offer", "name": "Netlinking Standard (10 liens/mois)", "price": "990",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "1800" } },
        { "@type": "Offer", "name": "Netlinking Premium (20+ liens/mois)", "price": "1800", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3500" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Référencement naturel (SEO)",       "item": "{{ app_url }}/performance-digitale/seo" },
        { "@type": "ListItem", "position": 4, "name": "Netlinking",                        "item": "{{ app_url }}/performance-digitale/seo/netlinking" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que le netlinking en SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le netlinking (ou link building) est la stratégie d'acquisition de liens entrants (backlinks) depuis d'autres sites web vers le vôtre. Plus un site reçoit de liens de qualité depuis des sources faisant autorité, plus Google lui accorde un score d'autorité élevé (Domain Authority), ce qui améliore son positionnement dans les résultats de recherche. Le netlinking est l'un des 3 piliers fondamentaux du référencement naturel." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre netlinking white hat et black hat ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Le netlinking white hat respecte les règles de Google : acquisition naturelle de liens depuis des sites thématiquement cohérents, guest posting éditorial, partenariats légitimes. Le black hat utilise des réseaux de sites privés (PBN), des fermes de liens ou des liens payants cachés — des pratiques qui exposent votre site à des pénalités Google pouvant faire chuter votre trafic de 50% ou plus. Nous travaillons exclusivement en white hat pour une croissance durable." }
        },
        {
          "@type": "Question",
          "name": "Combien de backlinks faut-il pour progresser en SEO ?",
          "acceptedAnswer": { "@type": "Answer", "text": "La quantité n'est pas le critère principal : 10 backlinks de sites d'autorité dans votre secteur valent plus que 100 liens de sites sans intérêt. Ce qui compte, c'est la qualité (autorité du site source), la pertinence thématique et la diversité des ancres. Notre approche cible des sites avec un Domain Authority supérieur à 30, thématiquement cohérents avec votre activité." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour voir l'effet des backlinks ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les backlinks sont indexés par Google en 2 à 8 semaines. Leur effet sur les positions se manifeste progressivement sur 3 à 6 mois. Le netlinking est une stratégie de long terme qui accumule des gains — votre autorité de domaine croît dans le temps et renforce durablement toutes vos positions." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

