{% extends 'layouts/base.twig' %}

{# ── SEO (60 chars titre / 149 chars description) ─────────────────── #}
{% block title %}Création tunnel de vente | Funnel marketing haute conversion | Complianz{% endblock %}

{% block description %}Créez des tunnels de vente performants qui transforment vos visiteurs en clients. Landing pages, email automation, upsells et suivi des conversions.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Création de tunnels de vente",
      "url": "{{ app_url }}/performance-digitale/tunnel-de-vente/creation-tunnel",
      "description": "Conception et mise en place de tunnels de vente performants : landing pages, séquences email automatisées, upsells et suivi des conversions. De l'awareness à l'achat, un parcours optimisé pour transformer vos visiteurs en clients.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création de tunnels de vente",
      "offers": [
        { "@type": "Offer", "name": "Tunnel Simple (3 étapes)",         "price": "2900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500"  } },
        { "@type": "Offer", "name": "Tunnel Standard (5 étapes + email)","price": "5500",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "9900"  } },
        { "@type": "Offer", "name": "Tunnel Premium (full funnel)",      "price": "9900",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "18000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Tunnel de vente",                   "item": "{{ app_url }}/performance-digitale/tunnel-de-vente" },
        { "@type": "ListItem", "position": 4, "name": "Création de tunnels",               "item": "{{ app_url }}/performance-digitale/tunnel-de-vente/creation-tunnel" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un tunnel de vente ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un tunnel de vente (ou funnel de vente) est un parcours client structuré qui guide un prospect depuis sa première découverte de votre entreprise jusqu'à l'achat. Il comprend généralement plusieurs étapes : attraction (acquisition de trafic), capture (lead magnet, formulaire), nurturing (séquences email), proposition commerciale et conversion. Un tunnel bien conçu automatise une grande partie du processus de vente." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps pour créer un tunnel de vente ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un tunnel simple (landing page + email de confirmation) peut être créé en 2 à 4 semaines. Un tunnel standard (5 étapes + séquence email automatisée) nécessite 4 à 8 semaines. Un tunnel premium complet (full funnel avec upsells, downsells et automatisation avancée) prend 8 à 16 semaines. Le délai dépend de la complexité, des intégrations nécessaires et de la validation des contenus." }
        },
        {
          "@type": "Question",
          "name": "Comment mesurer l'efficacité d'un tunnel de vente ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les KPIs clés d'un tunnel sont : le taux de conversion par étape (% de visiteurs qui passent à l'étape suivante), le taux de conversion final (% de visiteurs qui achètent), le coût par lead (CPL), le coût par acquisition (CPA), le ROI du tunnel et la valeur vie client (LTV). Nous mettons en place le tracking complet (GA4, Pixel Meta, etc.) pour suivre ces métriques en temps réel." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre un tunnel de vente et une landing page ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une landing page est une page unique conçue pour convertir un visiteur en lead ou client — c'est la première étape d'un tunnel. Un tunnel de vente est une séquence complète de plusieurs étapes (landing page + page de remerciement + séquences email + upsell + etc.) qui guide le prospect jusqu'à l'achat et au-delà. La landing page est une composante du tunnel." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

