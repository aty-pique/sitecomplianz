{% extends 'layouts/base.twig' %}

{# ── SEO ──────────────────────────────────────────────────────────── #}
{% block title %}Chat IA sur site internet — chatbot intelligent personnalisé{% endblock %}

{% block description %}Conception et intégration d'un chatbot IA sur votre site : réponses instantanées 24h/24, qualification automatique des prospects, connexion CRM/emailing et amélioration de la conversion.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Chat IA sur site internet",
      "url": "{{ app_url }}/intelligence-artificielle/ia-entreprise/plateforme-chatbot-ia-d-entreprise",
      "description": "Conception et intégration d'un assistant conversationnel intelligent directement sur le site internet de l'entreprise, capable de répondre aux questions des visiteurs, qualifier les prospects, automatiser les interactions et améliorer l'expérience utilisateur.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Création de chatbot IA pour site web",
      "offers": [
        { "@type": "Offer", "name": "Chat simple (FAQ automatisée)",          "price": "1000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "3000" } },
        { "@type": "Offer", "name": "Chat avancé (qualification + scénarios)","price": "3000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "8000" } },
        { "@type": "Offer", "name": "Chat intelligent connecté (CRM, BDD…)",  "price": "8000",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "20000" } },
        { "@type": "Offer", "name": "Solution complète personnalisée",         "price": "20000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "50000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                   "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Intelligence Artificielle", "item": "{{ app_url }}/intelligence-artificielle" },
        { "@type": "ListItem", "position": 3, "name": "IA en entreprise",          "item": "{{ app_url }}/intelligence-artificielle/ia-entreprise" },
        { "@type": "ListItem", "position": 4, "name": "Chat IA sur site internet", "item": "{{ app_url }}/intelligence-artificielle/ia-entreprise/plateforme-chatbot-ia-d-entreprise" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle différence entre un chatbot classique et un chat IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un chatbot classique suit des règles prédéfinies et répond via des arbres de décision figés. Un chat IA comprend le langage naturel, s'adapte au contexte de la conversation, apprend de vos contenus (site, documents, FAQ) et peut gérer des situations non prévues. Il qualifie les leads, répond à des questions ouvertes et transmet intelligemment au bon interlocuteur humain quand nécessaire." }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un chat IA sur un site internet ?",
          "acceptedAnswer": { "@type": "Answer", "text": "De 1 000 à 3 000 € pour un chat FAQ automatisé basique, de 3 000 à 8 000 € pour un chat avancé avec qualification de leads et scénarios conversationnels, de 8 000 à 20 000 € pour un chat connecté CRM/base de données, et de 20 000 à 50 000 €+ pour une solution entièrement personnalisée multi-langue et multi-canal. Une maintenance de 100 à 1 000 €/mois est disponible pour l'amélioration continue." }
        },
        {
          "@type": "Question",
          "name": "Sur quels contenus peut-on entraîner le chatbot IA ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous pouvons entraîner votre chatbot IA sur vos pages de site web, vos documents (PDF, Word, Excel), votre base de connaissances, votre FAQ, votre catalogue produits/services, vos emails types, vos procédures internes et tout document structuré que vous souhaitez rendre accessible via le chat. Plus la base d'entraînement est riche, plus les réponses sont précises et pertinentes." }
        },
        {
          "@type": "Question",
          "name": "Le chat IA peut-il qualifier des leads et les envoyer dans mon CRM ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, c'est l'une des fonctionnalités les plus puissantes. Nous configurons des scénarios de qualification conversationnels (secteur, budget, besoin, délai) et connectons le chatbot à votre CRM (HubSpot, Salesforce, Pipedrive…) pour créer automatiquement les leads qualifiés avec leurs informations. Résultat : vos équipes commerciales ne reçoivent que des leads pré-qualifiés." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour déployer un chat IA sur un site ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un chat FAQ simple peut être déployé en 1 à 2 semaines. Un chat avec qualification de leads et connexion CRM nécessite 3 à 6 semaines. Une solution complète sur mesure prend 2 à 4 mois. Nous démarrons toujours par une analyse des besoins et cas d'usage (quelques jours) avant de commencer le développement et l'entraînement." }
      }
    }
  ]
}
</script>
{% endblock %}

