{% extends 'layouts/base.twig' %}

{# ── SEO (57 chars titre / 152 chars description) ─────────────────── #}
{% block title %}Infogérance & gestion serveurs — infrastructure sécurisée{% endblock %}

{% block description %}Gestion complète de vos serveurs et infrastructures : monitoring, sécurisation, sauvegardes, mises à jour et optimisation des performances. Votre infra gérée en continu.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Infogérance & gestion serveurs",
      "url": "{{ app_url }}/support-maintenance/infogerance",
      "description": "Gestion complète des serveurs et des infrastructures techniques afin d'assurer leur bon fonctionnement, leur sécurité et leur performance dans la durée. Monitoring, sécurisation, sauvegardes, mises à jour et optimisation des performances.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Infogérance serveur et hébergement managé",
      "offers": [
        { "@type": "Offer", "name": "Infogérance simple",   "price": "200",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "800" } },
        { "@type": "Offer", "name": "Infogérance standard", "price": "800",  "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2000" } },
        { "@type": "Offer", "name": "Infogérance avancée",  "price": "2000", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Support & Maintenance",  "item": "{{ app_url }}/support-maintenance" },
        { "@type": "ListItem", "position": 3, "name": "Infogérance & Hébergement", "item": "{{ app_url }}/support-maintenance/infogerance" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce que l'infogérance de serveurs ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'infogérance de serveurs est un service de gestion externalisée de votre infrastructure technique. Un prestataire prend en charge la gestion, la surveillance, la sécurisation, les mises à jour et l'optimisation de vos serveurs, hébergements et infrastructures cloud — vous permettant de vous concentrer sur votre activité sans vous préoccuper de la technique." }
        },
        {
          "@type": "Question",
          "name": "Quelle différence entre infogérance simple et avancée ?",
          "acceptedAnswer": { "@type": "Answer", "text": "L'infogérance simple (200–800€/mois) couvre les serveurs mutualisés ou VPS simples avec monitoring basique et sauvegardes régulières. L'infogérance standard (800–2000€/mois) ajoute un monitoring avancé, une sécurisation renforcée et la gestion des incidents. L'infogérance avancée (2000–5000€/mois+) inclut des infrastructures complexes, une haute disponibilité, du clustering et un support 24/7." }
        },
        {
          "@type": "Question",
          "name": "Quels types de serveurs gérez-vous ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Nous gérons tous types de serveurs et infrastructures : serveurs dédiés (OVH, Hetzner, etc.), VPS, cloud public (AWS, Azure, Google Cloud), cloud privé, infrastructures hybrides, serveurs mutualisés et architectures microservices. Nous intervenons sur Linux (Ubuntu, Debian, CentOS) et Windows Server." }
        },
        {
          "@type": "Question",
          "name": "Proposez-vous un monitoring 24h/24 ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, nous proposons un monitoring continu de vos serveurs selon le niveau d'infogérance contractualisé. Pour les besoins de haute disponibilité (24/7), l'infogérance avancée inclut une surveillance permanente avec alertes en temps réel et intervention prioritaire en cas d'incident critique, même en dehors des heures ouvrées." }
        },
        {
          "@type": "Question",
          "name": "Qu'est-ce qui est inclus dans une prestation d'infogérance ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Une prestation d'infogérance inclut typiquement : gestion des serveurs, monitoring des performances et de la disponibilité, maintenance technique (mises à jour OS, logiciels), sécurisation (pare-feu, SSL, détection d'intrusion), sauvegardes régulières avec tests de restauration, optimisation des performances et gestion des incidents avec rétablissement du service." }
      }
    }
  ]
}
</script>
{% endblock %}

