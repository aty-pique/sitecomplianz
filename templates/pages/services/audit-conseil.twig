{% extends 'layouts/base.twig' %}

{# ── SEO ────────────────────────────────────────────────────────────── #}
{% block title %}Audit d'entreprise | Audit Global &amp; Conseil Stratégique{% endblock %}

{% block description %}Réalisez un audit d'entreprise complet avec nos experts en conseil stratégique. Diagnostic organisationnel, structuration &amp; gouvernance, accompagnement dirigeant. Devis gratuit sous 24h.{% endblock %}

{% block head %}
{# ── Données structurées JSON-LD ──────────────────────────────────── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Audit global & Conseil stratégique",
      "url": "{{ app_url }}/audit-conformite/audit-conseil",
      "description": "Audit d'entreprise complet : diagnostic organisationnel, structuration & gouvernance, accompagnement à la création d'entreprise et au développement stratégique.",
      "provider": {
        "@type": "Organization",
        "name": "{{ app_name }}",
        "url": "{{ app_url }}"
      },
      "areaServed": "FR",
      "serviceType": "Conseil & Audit stratégique d'entreprise",
      "offers": [
        {
          "@type": "Offer",
          "name": "Audit Flash",
          "price": "1500",
          "priceCurrency": "EUR",
          "description": "Diagnostic express sur 1 journée."
        },
        {
          "@type": "Offer",
          "name": "Audit Complet",
          "price": "3000",
          "priceCurrency": "EUR",
          "description": "Audit organisationnel approfondi sur 3 à 5 jours."
        },
        {
          "@type": "Offer",
          "name": "Audit Stratégique 360°",
          "price": "8000",
          "priceCurrency": "EUR",
          "description": "Audit complet avec plan d'action et accompagnement sur 2 semaines."
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Conseil, Audit & Conformité", "item": "{{ app_url }}/audit-conformite" },
        { "@type": "ListItem", "position": 3, "name": "Audit global & Conseil stratégique", "item": "{{ app_url }}/audit-conformite/audit-conseil" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qu'est-ce qu'un audit d'entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un audit d'entreprise est un examen approfondi et objectif de l'organisation, des processus, des ressources et de la stratégie d'une entreprise. Il vise à identifier les forces, les faiblesses, les risques et les opportunités afin de formuler des recommandations concrètes d'amélioration."
          }
        },
        {
          "@type": "Question",
          "name": "Combien coûte un audit d'entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Le coût d'un audit d'entreprise varie selon la taille de l'entreprise et le périmètre d'analyse. Nos prestations débutent à 1 500 € pour un audit flash d'une journée, et atteignent 8 000 € pour un audit stratégique 360° complet sur 2 semaines."
          }
        },
        {
          "@type": "Question",
          "name": "Quelle est la durée d'un audit d'entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La durée dépend du niveau d'audit choisi : de 1 journée pour un diagnostic express à 2 semaines pour un audit stratégique complet. Un audit standard couvre généralement 3 à 5 jours d'intervention."
          }
        },
        {
          "@type": "Question",
          "name": "Quand faut-il réaliser un audit d'entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un audit d'entreprise est recommandé lors d'un changement stratégique majeur (croissance, diversification, fusion/acquisition), avant une levée de fonds, en cas de baisse de performance, ou encore à l'occasion d'une transmission d'entreprise."
          }
        },
        {
          "@type": "Question",
          "name": "Quels sont les différents types d'audit en entreprise ?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Il existe plusieurs types d'audit : l'audit organisationnel (structure et processus), l'audit financier (comptes et trésorerie), l'audit stratégique (positionnement et concurrence), l'audit RH (capital humain), et l'audit de conformité (RGPD, ISO, normes légales)."
          }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

