{% extends 'layouts/base.twig' %}

{# ── SEO (59 chars titre / 148 chars description) ─────────────────── #}
{% block title %}Tableau de bord commercial | Dashboard KPI & analytics | Complianz{% endblock %}

{% block description %}Créez votre tableau de bord commercial sur mesure pour suivre vos KPIs en temps réel. Looker Studio, Power BI, intégration CRM et alertes automatiques.{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Tableau de bord commercial — Pilotage de la performance",
      "url": "{{ app_url }}/performance-digitale/pilotage-commercial/tableau-de-bord",
      "description": "Création de tableaux de bord commerciaux sur mesure pour le suivi des KPIs en temps réel : conception du dashboard (Looker Studio / Power BI), intégration des sources de données CRM et ads, alertes automatiques et formation des équipes.",
      "provider": { "@type": "Organization", "name": "{{ app_name }}", "url": "{{ app_url }}" },
      "areaServed": "FR",
      "serviceType": "Tableau de bord commercial et analytics",
      "offers": [
        { "@type": "Offer", "name": "Dashboard Simple",      "price": "1500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "2900" } },
        { "@type": "Offer", "name": "Dashboard Standard",    "price": "2900", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "5500" } },
        { "@type": "Offer", "name": "Dashboard Enterprise",  "price": "5500", "priceCurrency": "EUR", "priceSpecification": { "@type": "PriceSpecification", "maxPrice": "11000" } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Accueil",                           "item": "{{ app_url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Performance Digitale & Stratégie", "item": "{{ app_url }}/performance-digitale" },
        { "@type": "ListItem", "position": 3, "name": "Pilotage commercial",               "item": "{{ app_url }}/performance-digitale/pilotage-commercial" },
        { "@type": "ListItem", "position": 4, "name": "Tableau de bord",                   "item": "{{ app_url }}/performance-digitale/pilotage-commercial/tableau-de-bord" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quelle différence entre Looker Studio et Power BI ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Looker Studio (ex-Google Data Studio) est gratuit, très accessible et s'intègre nativement avec les outils Google (GA4, Google Ads, Sheets). Power BI est un outil Microsoft plus puissant pour des analyses complexes et des volumes de données importants, avec un coût de licence. Pour la plupart des PME, Looker Studio est suffisant et plus rapide à déployer. Nous vous conseillons l'outil adapté à votre contexte technique lors du cadrage." }
        },
        {
          "@type": "Question",
          "name": "Quels KPIs inclure dans un tableau de bord commercial ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Les KPIs essentiels dépendent de votre activité. En général : nombre de leads, taux de conversion, chiffre d'affaires, panier moyen, CAC (coût d'acquisition client), LTV (valeur vie client), taux de rétention, et pipeline commercial. Pour le digital : trafic, taux de rebond, ROAS des campagnes, taux d'ouverture emails. Nous définissons avec vous les 8 à 12 KPIs vraiment décisionnels pour votre activité." }
        },
        {
          "@type": "Question",
          "name": "Combien de temps faut-il pour créer un tableau de bord ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Un tableau de bord simple (Looker Studio avec 2-3 sources) peut être livré en 2 à 3 semaines. Un dashboard standard avec intégrations CRM prend 4 à 6 semaines. Un dashboard enterprise multi-sources complexe peut nécessiter 6 à 12 semaines selon les APIs disponibles. Le délai dépend surtout de la disponibilité des données et de la qualité des sources à connecter." }
        },
        {
          "@type": "Question",
          "name": "Peut-on connecter un CRM comme Salesforce ou HubSpot ?",
          "acceptedAnswer": { "@type": "Answer", "text": "Oui, nous intégrons les principaux CRM du marché : HubSpot, Salesforce, Pipedrive, Zoho CRM, et bien d'autres via connecteurs natifs ou API. Nous connectons également Google Ads, Meta Ads, LinkedIn Ads, GA4, ainsi que vos outils métiers spécifiques. Si un connecteur natif n'existe pas, nous développons une intégration sur mesure via API." }
        }
      ]
    }
  ]
}
</script>
{% endblock %}

