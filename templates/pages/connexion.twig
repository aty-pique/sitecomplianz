{% extends 'layouts/base.twig' %}

{% block title %}Se connecter{% endblock %}
{% block description %}Connexion à votre espace Complianz System : identifiants, inscription et réinitialisation du mot de passe.{% endblock %}

{% block head %}
    <meta name="robots" content="noindex,follow">
    <link rel="stylesheet" href="{{ asset_base }}/assets/css/auth-page.css">
{% endblock %}

{% block content %}
<section class="auth-page" aria-labelledby="auth-page-title">
    <header class="auth-page__intro">
        <p class="auth-page__eyebrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Espace sécurisé
        </p>
        <h1 id="auth-page-title" class="auth-page__title">Se connecter</h1>
        <p class="auth-page__lead">Accédez à votre espace client ou créez un compte pour suivre vos dossiers et échanges avec Complianz System.</p>
        <p class="auth-page__note" role="note"><strong>Maquette :</strong> aucune donnée n’est enregistrée ni vérifiée sur ce site de démonstration. Branchez votre propre authentification (SSO, OIDC, etc.) en production.</p>
    </header>

    <div class="container auth-page__grid">
        <article class="auth-card" aria-labelledby="auth-login-title">
            <h2 id="auth-login-title" class="auth-card__title">Connexion</h2>
            <p class="auth-card__subtitle">Entrez l’adresse e-mail associée à votre compte et votre mot de passe.</p>
            <form class="auth-card__form" action="#" method="post" autocomplete="on" novalidate data-auth-demo-form>
                <div class="auth-field">
                    <label for="auth-login-email">Adresse e-mail</label>
                    <input type="email" id="auth-login-email" name="email" autocomplete="username" inputmode="email" placeholder="vous@entreprise.fr" required>
                </div>
                <div class="auth-field auth-field--pass">
                    <label for="auth-login-password">Mot de passe</label>
                    <div class="auth-field__input-wrap">
                        <input type="password" id="auth-login-password" name="password" autocomplete="current-password" placeholder="••••••••" required>
                        <button type="button" class="auth-field__reveal" aria-label="Afficher ou masquer le mot de passe" aria-pressed="false" data-auth-pass-toggle data-auth-pass-for="auth-login-password">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>
                <div class="auth-row">
                    <label class="auth-check">
                        <input type="checkbox" name="remember" value="1">
                        <span>Se souvenir de moi sur cet appareil</span>
                    </label>
                    <a href="#reinitialiser-mot-de-passe" class="auth-link">Mot de passe oublié&nbsp;?</a>
                </div>
                <button type="submit" class="btn btn-primary btn-lg auth-card__submit">Se connecter</button>
            </form>
            <p class="auth-field__hint" style="margin-top:18px;margin-bottom:0;text-align:center;">Pas encore de compte&nbsp;? Utilisez le formulaire <strong>Inscription</strong> à droite (ou ci-dessous sur mobile).</p>
        </article>

        <article class="auth-card" aria-labelledby="auth-register-title">
            <h2 id="auth-register-title" class="auth-card__title">Inscription</h2>
            <p class="auth-card__subtitle">Créez un accès pour consulter vos livrables, messages et documents.</p>
            <form class="auth-card__form" action="#" method="post" autocomplete="on" novalidate data-auth-demo-form>
                <div class="auth-field">
                    <label for="auth-reg-name">Nom affiché</label>
                    <input type="text" id="auth-reg-name" name="display_name" autocomplete="name" placeholder="Prénom Nom ou société">
                </div>
                <div class="auth-field">
                    <label for="auth-reg-email">Adresse e-mail</label>
                    <input type="email" id="auth-reg-email" name="email" autocomplete="email" inputmode="email" placeholder="vous@entreprise.fr" required>
                </div>
                <div class="auth-field auth-field--pass">
                    <label for="auth-reg-password">Mot de passe</label>
                    <div class="auth-field__input-wrap">
                        <input type="password" id="auth-reg-password" name="password" autocomplete="new-password" placeholder="8 caractères minimum" minlength="8" required>
                        <button type="button" class="auth-field__reveal" aria-label="Afficher ou masquer le mot de passe" aria-pressed="false" data-auth-pass-toggle data-auth-pass-for="auth-reg-password">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>
                <div class="auth-field auth-field--pass">
                    <label for="auth-reg-password2">Confirmer le mot de passe</label>
                    <div class="auth-field__input-wrap">
                        <input type="password" id="auth-reg-password2" name="password_confirm" autocomplete="new-password" placeholder="Retapez le mot de passe" minlength="8" required>
                        <button type="button" class="auth-field__reveal" aria-label="Afficher ou masquer la confirmation" aria-pressed="false" data-auth-pass-toggle data-auth-pass-for="auth-reg-password2">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>
                <div class="auth-field">
                    <label class="auth-check">
                        <input type="checkbox" name="accept_terms" value="1" required>
                        <span>J’accepte les <a href="/audit-conformite/conformite-rgpd/politique-confidentialite" target="_blank" rel="noopener">conditions et la politique de confidentialité</a>.</span>
                    </label>
                </div>
                <button type="submit" class="btn btn-primary btn-lg auth-card__submit">Créer mon compte</button>
            </form>
        </article>
    </div>

    <div class="container auth-recovery" id="reinitialiser-mot-de-passe">
        <div class="auth-recovery__inner">
            <h2 class="auth-recovery__title">Réinitialiser le mot de passe</h2>
            <p class="auth-recovery__text">Indiquez l’adresse e-mail de votre compte : nous vous enverrons un lien pour choisir un nouveau mot de passe (flux habituel en production).</p>
            <form class="auth-recovery__form" action="#" method="post" autocomplete="on" novalidate data-auth-demo-form>
                <div class="auth-field">
                    <label for="auth-reset-email">Adresse e-mail</label>
                    <input type="email" id="auth-reset-email" name="email" autocomplete="email" inputmode="email" placeholder="vous@entreprise.fr" required>
                </div>
                <button type="submit" class="btn btn-outline btn-lg auth-card__submit">Envoyer le lien de réinitialisation</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
(function () {
    document.querySelectorAll('[data-auth-demo-form]').forEach(function (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
        });
    });
    document.querySelectorAll('[data-auth-pass-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-auth-pass-for');
            var input = id ? document.getElementById(id) : null;
            if (!input) return;
            var show = input.getAttribute('type') === 'password';
            input.setAttribute('type', show ? 'text' : 'password');
            btn.setAttribute('aria-pressed', show ? 'true' : 'false');
            btn.setAttribute('aria-label', show ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
        });
    });
})();
</script>
{% endblock %}
