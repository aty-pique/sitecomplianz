<header class="site-header">

    {# ── Topbar ─────────────────────────────── #}
    <div class="topbar">
        <div class="container topbar-inner">
            <div class="topbar-actions">
                <a href="/connexion" class="topbar-btn">Se connecter</a>
                <a href="/telecharger" class="topbar-btn topbar-btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Télécharger l'app
                </a>
            </div>
        </div>
    </div>

    {# ── Header principal : logo + nav ─────── #}
    <div class="header-main">
        <div class="container header-main-inner">
            <a href="/" class="logo" aria-label="{{ app_name }}">
                {{ inline_svg('/assets/images/logo/logo.svg') }}
            </a>
            <nav class="header-nav" aria-label="Navigation principale">
                <a href="/">Accueil</a>
                <a href="/hub">Hub d’innovation</a>
                <a href="/wiki">Wiki</a>
            </nav>

            <div class="header-actions">
                {# Barre de recherche globale #}
                <div class="header-search" id="header-search">
                    <form class="header-search__form" action="/recherche" method="get" role="search">
                        <button type="button" class="header-search__toggle" aria-label="Ouvrir la recherche" aria-expanded="false" aria-controls="header-search-input">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </button>
                        <input
                            type="search"
                            id="header-search-input"
                            name="q"
                            class="header-search__input"
                            placeholder="Rechercher un service, une expertise…"
                            autocomplete="off"
                            aria-label="Recherche globale"
                        >
                        <button type="submit" class="header-search__submit" aria-label="Lancer la recherche">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        </button>
                    </form>
                </div>

                <div class="header-ctas">
                    <button type="button" class="header-cta header-cta--rdv" data-open-rdv-modal>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <span>Prendre rendez-vous</span>
                    </button>
                    <button type="button" class="header-cta header-cta--devis" data-open-quote-modal>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Demander mon devis</span>
                    </button>
                </div>
            </div>
