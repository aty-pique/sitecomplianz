{# Icônes cartes domaines hub pôle — stroke currentColor #}
{% set ic = icon|default('chart') %}
{% if ic == 'shield-check' %}
<svg class="pole-lp-domains-card__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
{% elseif ic == 'award' %}
<svg class="pole-lp-domains-card__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/></svg>
{% elseif ic == 'lock' %}
<svg class="pole-lp-domains-card__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
{% elseif ic == 'leaf' %}
<svg class="pole-lp-domains-card__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 20A7 7 0 015 9c0-5 8-8 11-8 0 5-4 9-9 11a18 18 0 01-4 8"/></svg>
{% elseif ic == 'target-cta' %}
<svg class="pole-lp-domains-card__svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/><path d="M12 12l5.5-5.5M17.5 6.5h-3M17.5 6.5v3"/></svg>
{% else %}
<svg class="pole-lp-domains-card__svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-4 4 4 5-7"/></svg>
{% endif %}
