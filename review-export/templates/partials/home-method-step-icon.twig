{# Une icône par étape (1–5) — style ligne, couleur via currentColor #}
{% if step == 1 %}
<svg class="home-method__ico-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M20 20l-4.2-4.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
{% elseif step == 2 %}
<svg class="home-method__ico-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10l6-4 6 4v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M10 22V12h4v10M8 8l4-2 4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.85"/></svg>
{% elseif step == 3 %}
<svg class="home-method__ico-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M7 9h6M7 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/></svg>
{% elseif step == 4 %}
<svg class="home-method__ico-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 18V6M10 18V10M16 18v-6M22 18V8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M4 18h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M14 6l3-3 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% else %}
<svg class="home-method__ico-svg" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>
{% endif %}
