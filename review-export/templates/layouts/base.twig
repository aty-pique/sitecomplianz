<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ title ?? 'Page' }}{% endblock %} — {{ app_name }}</title>
    <meta name="description" content="{% block description %}Complianz — Solution de conformité RGPD{% endblock %}">
    <link rel="stylesheet" href="/assets/css/main.css">
    {% block head %}{% endblock %}
</head>
<body>
    {% include 'partials/header.twig' %}

    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    {% include 'partials/footer.twig' %}

    {% include 'partials/quote-modal.twig' %}
    {% include 'partials/rdv-modal.twig' %}
    {% include 'partials/quick-actions.twig' %}

    <script src="/assets/js/main.js"></script>
    <script src="/assets/js/quote-modal.js" defer></script>
    <script src="/assets/js/rdv-modal.js" defer></script>
    <script src="/assets/js/quick-actions.js" defer></script>
    {% if dev_client_feedback_enabled %}
    <script src="/assets/js/dev-client-feedback.js" defer></script>
    {% endif %}
    {% block scripts %}{% endblock %}
</body>
</html>
